// OS-specific virtual memory primitives for x86-64-linux.
component OsMem {
	def PROT_NONE = LinuxConst.PROT_NONE;
	def PROT_READ = LinuxConst.PROT_READ;
	def PROT_WRITE = LinuxConst.PROT_WRITE;
	def PROT_EXEC = LinuxConst.PROT_EXEC;
	def MAP_PRIVATE = LinuxConst.MAP_PRIVATE;
	def MAP_ANONYMOUS = LinuxConst.MAP_ANONYMOUS;

	// Maps {size} bytes of fresh memory with the given protection and flags.
	// Returns {Pointer.NULL} on failure.
	def mmap(size: u64, prot: int, flags: int) -> Pointer {
		var r = Linux.syscall(LinuxConst.SYS_mmap, (Pointer.NULL, size, prot, flags, 0, 0));
		if (isError(r.0)) return Pointer.NULL;
		return Pointer.NULL + r.0;
	}
	def mprotect(start: Pointer, size: u64, prot: int) -> bool {
		var r = Linux.syscall(LinuxConst.SYS_mprotect, (start, size, prot));
		return r.0 == 0;
	}
	def munmap(start: Pointer, size: u64) -> bool {
		var r = Linux.syscall(LinuxConst.SYS_munmap, (start, size));
		return r.0 == 0;
	}
	// The kernel returns {-errno} in the range [-4095, -1] on failure.
	private def isError(r: long) -> bool {
		return r < 0 && r >= -4095;
	}
}

// OS-specific signal numbers and accessors for the saved machine context of a signal.
component OsSignal {
	def SIGFPE  = 8;
	def SIGBUS  = 10;
	def SIGSEGV = 11;

	// Offsets of saved registers in the kernel's {ucontext_t}.
	private def UC_RSP = 160;
	private def UC_RIP = 168;

	def getIp(ucontext: Pointer) -> Pointer {
		return (ucontext + UC_RIP).load<Pointer>();
	}
	def setIp(ucontext: Pointer, ip: Pointer) {
		(ucontext + UC_RIP).store<Pointer>(ip);
	}
	def getSp(ucontext: Pointer) -> Pointer {
		return (ucontext + UC_RSP).load<Pointer>();
	}
	def setSp(ucontext: Pointer, sp: Pointer) {
		(ucontext + UC_RSP).store<Pointer>(sp);
	}
	// Get the faulting memory address for a SIGSEGV or SIGBUS.
	def getAccessAddress(siginfo: Pointer, ucontext: Pointer) -> Pointer {
		return RiOs.getAccessAddress(siginfo, ucontext);
	}
}
