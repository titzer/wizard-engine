// OS-specific virtual memory primitives for x86-64-darwin.
// (Constants not yet in Virgil's {DarwinConst} are defined locally.)
component OsMem {
	def PROT_NONE = 0x0;
	def PROT_READ = 0x1;
	def PROT_WRITE = 0x2;
	def PROT_EXEC = 0x4;
	def MAP_PRIVATE = 0x0002;
	def MAP_ANONYMOUS = 0x1000;	// MAP_ANON

	private def SYS_munmap = 0x2000049;
	private def SYS_mprotect = 0x200004A;
	private def SYS_mmap = 0x20000C5;

	// Maps {size} bytes of fresh memory with the given protection and flags.
	// Returns {Pointer.NULL} on failure.
	def mmap(size: u64, prot: int, flags: int) -> Pointer {
		// Anonymous mappings must pass fd = -1.
		var r = Darwin.syscall(SYS_mmap, (Pointer.NULL, size, prot, flags, -1, 0L));
		if (!syscallOk(r)) return Pointer.NULL;
		return Pointer.NULL + r.0;
	}
	def mprotect(start: Pointer, size: u64, prot: int) -> bool {
		return syscallOk(Darwin.syscall(SYS_mprotect, (start, size, prot)));
	}
	def munmap(start: Pointer, size: u64) -> bool {
		return syscallOk(Darwin.syscall(SYS_munmap, (start, size)));
	}
	// The kernel signals a failed system call by setting the carry flag (and returning errno).
	private def syscallOk<T>(t: T) -> bool {
		def CF_FLAG = 1;
		match (t) {
			x: (long, long, long) => return (x.2 & CF_FLAG) == 0;
			x: (long, long) => return x.1 == 0; // older compilers don't return the flags
		}
		return false;
	}
}

// OS-specific signal numbers and accessors for the saved machine context of a signal.
component OsSignal {
	def SIGFPE  = 8;
	def SIGBUS  = 10;
	def SIGSEGV = 11;

	// {ucontext_t.uc_mcontext} is a pointer to the machine context, which starts with
	// the exception state (16 bytes), followed by the thread state (rax, rbx, ...).
	private def UC_MCONTEXT = 0x30;
	private def MC_RSP = 0x48;
	private def MC_RIP = 0x90;

	def getIp(ucontext: Pointer) -> Pointer {
		return (mcontext(ucontext) + MC_RIP).load<Pointer>();
	}
	def setIp(ucontext: Pointer, ip: Pointer) {
		(mcontext(ucontext) + MC_RIP).store<Pointer>(ip);
	}
	def getSp(ucontext: Pointer) -> Pointer {
		return (mcontext(ucontext) + MC_RSP).load<Pointer>();
	}
	def setSp(ucontext: Pointer, sp: Pointer) {
		(mcontext(ucontext) + MC_RSP).store<Pointer>(sp);
	}
	// Get the faulting memory address for a SIGSEGV or SIGBUS.
	def getAccessAddress(siginfo: Pointer, ucontext: Pointer) -> Pointer {
		return RiOs.getAccessAddress(siginfo, ucontext);
	}
	private def mcontext(ucontext: Pointer) -> Pointer {
		return (ucontext + UC_MCONTEXT).load<Pointer>();
	}
}
