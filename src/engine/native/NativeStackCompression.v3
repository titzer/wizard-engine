// Segment integration class.
component NativeStackCompression {
	// {true} if {stack} is suspended with only comrpessible (interpreter and SPC) frames.
	def canCompress(stack: NativeStack) -> bool {
		if (stack.state_ != StackState.SUSPENDED) return false;
		var range = stack.range;
		if (range == null) return false;
		var end = range.end;
		var srp = stack.rsp, count = 0, bottom_sfp = Pointer.NULL;
		while (srp >= range.start && srp < end) {
			var retip = srp.load<Pointer>();
			var code = RiRuntime.findUserCode(retip);
			match (code) {
				x: X86_64InterpreterCode, x: X86_64SpcModuleCode => {
					count++;
					bottom_sfp = srp + Pointer.SIZE;
					srp = code.nextFrame(retip, srp).1;
				}
				x: X86_64ReturnParentStub => {
					if (count == 0) return false;
					// Values below the bottom frame would be lost.
					return NativeFrameHandle.Interpreter(bottom_sfp).vfp() == range.start;
				}
				_ => return false; // enter-func stub, inlined frames, trap stubs, host frames
			}
		}
		return false;
	}
	// Requires {canCompress(stack)}.
	def compress(stack: NativeStack) {
		var parent_rsp = stack.parent_rsp_ptr.load<Pointer>();
		var segment_bytes = u64.view(stack.range.end - stack.range.start);
		var c = StackCompression.compressStack(stack);
		if (Trace.stack) Trace.OUT.put2(
			"compress stack @ 0x%x, freeing segment 0x%x",
			Pointer.atObject(stack) - Pointer.NULL,
			stack.range.start - Pointer.NULL
		).ln();
		NativeStackManager.releaseSegment(stack);
		stack.vsp = stack.rsp = Pointer.NULL;
		stack.parent_rsp_ptr = Pointer.NULL;
		stack.saved_parent_rsp = parent_rsp;
		stack.compressed = c;
		stack.state_ = StackState.COMPRESSED;
		if (StackCompression.onCompress != null) StackCompression.onCompress(segment_bytes, c);
	}
	// Requires {state == COMPRESSED}. Returns {false} on fail.
	def decompress(stack: NativeStack) -> bool {
		var c = stack.compressed, parent_rsp = stack.saved_parent_rsp;
		var func = stack.func, results = stack.return_results, bottom = stack.bottom; // frame writes reset these
		if (!NativeStackManager.attachSegment(stack)) return false;
		if (Trace.stack) Trace.OUT.put2(
			"decompress stack @ 0x%x onto segment 0x%x",
			Pointer.atObject(stack) - Pointer.NULL,
			stack.range.start - Pointer.NULL
		).ln();
		stack.state_ = StackState.EMPTY;
		Target.writeFramesToStack(stack, StackCompression.decompressFrames(c));
		stack.func = func;
		stack.return_results = results;
		stack.bottom = bottom;
		stack.parent_rsp_ptr.store<Pointer>(parent_rsp);
		stack.saved_parent_rsp = Pointer.NULL;
		stack.compressed = null;
		stack.flags = NativeStackManager.REFERENCED;
		stack.state_ = StackState.SUSPENDED;
		return true;
	}
}
