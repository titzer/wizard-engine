// Collects metrics from the Virgil garbage collector.
private component GcMetrics {
	def min = TimeMetric.new("gc:pause:min", "Minimum pause time");
	def max = TimeMetric.new("gc:pause:min", "Maximum pause time");
	var enabled: bool;
	var before: u64;

	new() {
		Metrics.addReportFunc("gc:count", "count", "Total number of GCs", fun buf => buf.putd(GcStats.gc_count));
		Metrics.addReportFunc("gc:total_us", Metrics.us, "Total time taken by all GCs", fun buf => buf.putd(GcStats.collection_us));
		Metrics.add(min);
		Metrics.add(max);
		Metrics.addReportFunc("heap:allocated", Metrics.bytes, "Total allocated bytes", fun buf => buf.putd(GcStats.total_allocated_bytes()));
		Metrics.addReportFunc("heap:survived", Metrics.bytes, "Total bytes surviving GCs", fun buf => buf.putd(GcStats.collection_us));
		Metrics.addReportFunc("heap:final", Metrics.bytes, "Heap size before exit", fun buf => buf.putd(RiGc.usedBytes()));
	}

	def enableCallbacks() {
		if (!enabled) {
			this.enabled = true;
			RiGc.preGC = this.preGC;
			RiGc.postGC = this.postGC;
		}
	}
	def preGC() {
		before = u32.view(System.ticksUs());
	}
	def postGC() {
		var sample = before - u32.view(System.ticksUs());
		before = 0;
		if (min.val == 0 || sample < min.val) min.val = sample;
		if (sample > max.val) max.val = sample;
	}
}

class PauseTimeMetric extends TimeMetric {
	new(name: string, help: string) super(name, help) { }

	def enable() {
		GcMetrics.enableCallbacks();
	}
}