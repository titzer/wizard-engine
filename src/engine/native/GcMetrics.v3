// Collects metrics from the Virgil garbage collector.
private component GcMetrics {
	new() {
		Metrics.addReportFunc("gc:count", "count", "Total number of GCs", fun buf => buf.putd(GcStats.gc_count));
		gc("gc:total_us", Metrics.us, "Total time taken by all GCs", fun buf => buf.putd(GcStats.collection_us));
		gc("gc:pause:min", Metrics.us, "Minimum pause time", fun buf => buf.putd(GcStats.min_pause_us));
		gc("gc:pause:max", Metrics.us, "Maximum pause time", fun buf => buf.putd(GcStats.max_pause_us));
		gc("heap:allocated", Metrics.bytes, "Total allocated bytes", fun buf => buf.putd(GcStats.total_allocated_bytes()));
		gc("heap:survived", Metrics.bytes, "Total bytes surviving GCs", fun buf => buf.putd(GcStats.survived_bytes));
		Metrics.addReportFunc("heap:final", Metrics.bytes, "Heap size before exit", fun buf => buf.putd(RiGc.usedBytes()));
	}
	def gc(name: string, units: string, help: string, f: StringBuilder -> StringBuilder) {
		Metrics.add(GcStatsMetric.new(name, units, help, f));
	}
}

// A metric reported from {GcStats}, which turns on GC statistics collection when enabled.
class GcStatsMetric extends ReportFuncMetric {
	new(name: string, units: string, help: string, func: StringBuilder -> StringBuilder) super(name, units, help, func) { }

	def enable() {
		this.enabled = true;
		GcStats.enabled = true;
	}
}
