def fatal = System.error("NativeStackError", _);

// Manages native memory mappings for native stacks.
component NativeStackManager {
	private var all: NativeStackSegment;
	private var total: int;
	var cache: NativeStack;

	def allocStackBatch() {
		var size = EngineOptions.STACK_SIZE.get();
		var batch = Ints.min(StackTuning.stackBatchSize, StackTuning.maxStacks - total);
		if (Trace.stack) Trace.OUT.put1("Batch allocating %d stacks", StackTuning.stackBatchSize).ln();
		
		for (i < batch) {
			var t = Mmap.reserveRaw(size, Mmap.PROT_READ | Mmap.PROT_WRITE, Mmap.MAP_PRIVATE | Mmap.MAP_ANONYMOUS);
			var segment: NativeStackSegment;
			if (t.0 == Pointer.NULL) {
				// mmap failed, try alternate means
				if (cache != null) return; // succeeded in allocating at least one
				return tryReusingUnusedSegments() || tryCompressingSuspendedStack();
			}
			// insert redzone roughly in the middle of the mapping.
			def PAGE_SIZE = 4096u;
			var redzone_start = (size >> 1) & ~(PAGE_SIZE - 1u);
			if (!Target.redzones_add(mapping, redzone_start, PAGE_SIZE)) fatal("could not protect value stack red zone");
			var curr = NativeStack.new(mapping);
			curr.next_stack = cache;
			cache = curr;
			total++;
		}
	}
	def tryReusingUnusedSegments() -> bool {
		for (p = all; p != null; p = p.next) {
		}
	}
	def tryCompressingSuspendedStack() -> bool {
		return false;
	}
	def getFreshStack() -> NativeStack {
		if (cache == null) allocStackBatch();

		var result = cache;
		cache = cache.next_stack;
		result.next_stack = null;

		if (Trace.stack) Trace.OUT.put1("Requested fresh x86_stack @ 0x%x", Pointer.atObject(result) - Pointer.NULL).ln();
		return result.clear();
	}
	def recycleStack(stack: NativeStack) {
		stack.next_stack = cache;
		cache = stack;
	}
	def runOnFreshStack(f: Function, args: Range<Value>) -> Result {
		// Always run functions on a separate, fresh stack.
		var prev = X86_64Runtime.curStack; // handle reentrancy
		var stack = NativeStackManager.getFreshStack();
		var result = stack.reset(f).bind(args).resume();
		X86_64Runtime.curStack = prev;
		return result;
	}
	def findUnusedSegment() -> NativeStackSegment {
		for (p = all; p != null; p = p.next) {
			if (p.stack.get() == null) return p;
		}
		return null;
	}
}

// Native stack segments are individually mmap'd with a guard page in the middle
private class NativeStackSegment extends MemoryRange {
	var next: NativeStackSegment;
	var stack: WeakRef<NativeStack>;	// owner, if any

	new(start: Pointer, end: Pointer) super(start, end) { }

	def setNativeStack(s: NativeStack) -> this {
		Pointer.atField(this.weak_stack).store<NativeStack>(s);
	}
	def getNativeStack() -> NativeStack {
		return Pointer.atField(this.weak_stack).load<NativeStack>();
	}
}
