def fatal = System.error("NativeStackError", _);
def PAGE_SIZE = 4096u;

// Manages native memory mappings for native stacks.
component NativeStackManager {
	var all: NativeStackSegment;	// all segments ever mapped; never unmapped
	var total: int;			// number of segments in {all}
	var cache: NativeStack;		// used in fast-path allocation in generated code
	private var sweep: NativeStackSegment;	// clock hand for compression victims
	private var allocsSinceGC: int;		// stacks requested since the last forced GC
	private var gcInterval: int;		// requests to wait before collecting ahead of compressing

	// Gets a stack with a segment, or {null} if none is available.
	def getFreshStack() -> NativeStack {
		if (Trace.stack) Trace.OUT.puts("Requested fresh x86_stack...\n");
		allocsSinceGC++;
		if (cache == null && !refill()) return null;
		var result = cache;
		cache = cache.next_stack;
		result.next_stack = null;
		return result.clear();
	}
	// Requires {segment} to be unowned; leaves {stack} empty.
	def attach(stack: NativeStack, segment: NativeStackSegment) {
		stack.range = segment;
		segment.stack.set(stack);
		stack.clear();
		if (Trace.stack && Debug.stack) Trace.OUT.put2("attachSegment start=0x%x, end=0x%x", segment.start - Pointer.NULL, segment.end - Pointer.NULL).ln();
	}
	def detach(stack: NativeStack) -> NativeStackSegment {
		var segment = stack.range;
		segment.stack.set(null);
		stack.range = null;
		return segment;
	}
	def compressStack(stack: NativeStack) -> bool {
		if (!NativeStackCompression.canCompress(stack)) return false;
		addToCache(NativeStackCompression.compress(stack));
		return true;
	}
	// Gets an unowned segment, which must be attached before the next refill, or {null} if out of stacks.
	def acquireSegment() -> NativeStackSegment {
		var s = getFreshStack();
		return if(s == null, null, detach(s));
	}
	private def refill() -> bool {
		if (tryAllocatingNewStacks()) return true;
		if (tryReclaimingSegments() > 0) return true;
		var collected = false;
		if (StackTuning.enableCompression) {
			// Collect before compressing if collecting has been productive lately.
			if (allocsSinceGC >= gcInterval) {
				collected = true;
				if (tryCollectingAndReclaiming()) return true;
			}
			if (tryCompressingStacks()) return true;
		}
		return !collected && tryCollectingAndReclaiming();
	}
	private def addToCache(segment: NativeStackSegment) {
		var stack = NativeStack.new();
		attach(stack, segment);
		stack.next_stack = cache;
		cache = stack;
	}
	private def tryAllocatingNewStacks() -> bool {
		var size = EngineOptions.STACK_SIZE.get();
		var batch = Ints.min(StackTuning.stackBatchSize, StackTuning.maxStacks - total);
		if (Trace.stack) Trace.OUT.put1("Batch allocating %d stacks", batch).ln();
		
		for (i < batch) {
			// Map a guard page above the segment, so that accesses beyond its end always fault.
			var t = Mmap.reserveRaw(size + PAGE_SIZE, Mmap.PROT_READ | Mmap.PROT_WRITE, Mmap.MAP_PRIVATE | Mmap.MAP_ANONYMOUS);
			if (t.0 == Pointer.NULL) break;
			var end = t.0 + size;
			if (!Mmap.protect(end, PAGE_SIZE, Mmap.PROT_NONE)) fatal("could not protect stack guard page");
			var segment = NativeStackSegment.new(t.0, end);
			segment.next = all;
			all = segment;
			// insert redzone roughly in the middle of the mapping.
			var rzStart = t.0 + ((size >> 1) & ~(PAGE_SIZE - 1u)), rzEnd = rzStart + PAGE_SIZE;
			if (!RedZones.addRedZone(rzStart, rzEnd)) fatal("could not protect value stack red zone");
			addToCache(segment);
			total++;
		}
		return cache != null; // OK if succeeded in allocating at least one
	}
	private def tryReclaimingSegments() -> int {
		var count = 0;
		for (p = all; p != null; p = p.next) {
			if (p.stack.get() == null) { // weak reference was cleared by GC, can reclaim
				addToCache(p);
				count++;
			}
		}
		return count;
	}
	// Weak references are only cleared by a GC, so force one to find dead stacks.
	private def tryCollectingAndReclaiming() -> bool {
		if (all == null) return false;
		Target.forceGC();
		allocsSinceGC = 0;
		var count = tryReclaimingSegments();
		// Back off exponentially while collecting is unproductive.
		gcInterval = if(count * 4 >= total, total, Ints.min(gcInterval * 2 + 1, 1 << 24));
		return count > 0;
	}
	// Compresses one suspended stack, sweeping round-robin over all segments.
	private def tryCompressingStacks() -> bool {
		for (i < total) {
			if (sweep == null) sweep = all;
			var segment = sweep;
			sweep = segment.next;
			var s = segment.stack.get();
			if (s == null) { // its stack died since the last reclamation
				addToCache(segment);
				return true;
			}
			if (!NativeStackCompression.canCompress(s)) continue;
			addToCache(NativeStackCompression.compress(s));
			return true;
		}
		return false;
	}
	// Checks whether a fault at {addr} hit the guard page above a stack segment, which indicates
	// an engine bug, such as reading a frame that is not there. If so, fails with an error.
	def checkGuardPageFault(addr: Pointer, ip: Pointer) {
		for (p = all; p != null; p = p.next) {
			if (addr >= p.end && addr < p.end + PAGE_SIZE) {
				fatal(Strings.format2("access to guard page beyond the end of a stack segment @ 0x%x, ip=0x%x",
					addr - Pointer.NULL, ip - Pointer.NULL));
			}
		}
	}
	def recycleStack(stack: NativeStack) {
		stack.clear(); // so that it is never chosen for compression
		stack.next_stack = cache;
		cache = stack;
	}
	def runOnFreshStack(f: Function, args: Range<Value>) -> Result {
		// Always run functions on a separate, fresh stack.
		var prev = X86_64Runtime.curStack; // handle reentrancy
		var stack = NativeStackManager.getFreshStack();
		if (stack == null) return Result.Throw(Trap.new(TrapReason.OUT_OF_STACKS, null, null));
		var result = stack.reset(f).bind(args).resume();
		X86_64Runtime.curStack = prev;
		return result;
	}
}

// Native stack segments are individually mmap'd with a guard page in the middle
class NativeStackSegment extends MemoryRange {
	var next: NativeStackSegment;
	def stack = WeakRef<NativeStack>.new();	// owner, if any; cleared by GC

	new(start: Pointer, end: Pointer) super(start, end) { }
}
