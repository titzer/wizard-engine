def fatal = System.error("NativeStackError", _);

// Manages native memory mappings for native stacks.
component NativeStackManager {
	var cache: NativeStack;

	def allocStackBatch() {
		if (Trace.stack) Trace.OUT.put1("Batch allocating %d stacks", StackTuning.stackCacheSize).ln();
		var size = EngineOptions.STACK_SIZE.get();
		for (i < StackTuning.stackCacheSize) {
			var mapping = Target.mmap_reserve(size, Mmap.PROT_READ | Mmap.PROT_WRITE);
			if (mapping == null) {
				if (cache == null) fatal("could not map memory for more native stacks");
				else return; // succeeded in allocating at least one
			}
			// insert redzone roughly in the middle of the mapping.
			def PAGE_SIZE = 4096u;
			var redzone_start = (size >> 1) & ~(PAGE_SIZE - 1u);
			if (!Target.redzones_add(mapping, redzone_start, PAGE_SIZE)) fatal("could not protect value stack red zone");
			var curr = NativeStack.new(mapping);
			curr.next_stack = cache;
			cache = curr;
		}
	}
	def getFreshStack() -> NativeStack {
		if (cache == null) allocStackBatch();

		var result = cache;
		cache = cache.next_stack;
		result.next_stack = null;

		if (Trace.stack) Trace.OUT.put1("Requested fresh x86_stack @ 0x%x", Pointer.atObject(result) - Pointer.NULL).ln();
		return result.clear();
	}
	def recycleStack(stack: NativeStack) {
		stack.next_stack = cache;
		cache = stack;
	}
	def runOnFreshStack(f: Function, args: Range<Value>) -> Result {
		// Always run functions on a separate, fresh stack.
		var prev = X86_64Runtime.curStack; // handle reentrancy
		var stack = NativeStackManager.getFreshStack();
		var result = stack.reset(f).bind(args).resume();
		X86_64Runtime.curStack = prev;
		return result;
	}
}
