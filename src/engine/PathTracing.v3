// Ball-Larus path profiling for the functions matching --trace-paths: each profiled function
// counts the acyclic paths its executions take, in any tier, and the counts print at exit.
component PathTracing {
	private def traced = Vector<PathTrace>.new();
	def instrument(module: Module, func: FuncDecl) {
		if (func.imp != null) return; // an imported function has no body
		traced.put(PathTrace.new(module, func));
	}
	def report() {
		for (i < traced.length) traced[i].report(Trace.OUT);
	}
}

// Profiles one function for --trace-paths and holds how many times each of its paths ran.
class PathTrace(module: Module, func: FuncDecl) {
	def profile = PathProfile.new(func);
	var counts: Array<int>; // null if the function is not profiled

	new() {
		if (profile.reason != null) return;
		counts = Array.new(profile.numPaths + profile.selfLoops.length);
		for (site in profile.sites) {
			if (site.acts()) Instrumentation.insertLocalProbe(module, func.func_index, site.pc, PathProbe.new(site, counts));
		}
	}
	// Prints the nonzero path counts, each with the route its path number denotes, then the
	// trips around each self-loop, named by its block's start pc.
	def report(out: TraceBuilder) {
		out.put1("path profile of %q", func.render(module.names, _));
		if (counts == null) {
			out.put1(": not profiled, %s", profile.reason).ln();
			return;
		}
		out.put1(": %d paths", profile.numPaths).ln();
		for (k < profile.numPaths) {
			if (counts[k] == 0) continue;
			out.put2("  counts[%d] = %d\tpath:", k, counts[k]);
			profile.renderPath(k, out);
			out.ln();
		}
		for (i < profile.selfLoops.length) {
			def n = counts[profile.numPaths + i];
			if (n > 0) out.put2("  selfloop +%d = %d", profile.selfLoops[i].start, n).ln();
		}
	}
}

// Applies the action of the arm its site's branch is about to take, and passes any path it
// completes to {count}.
class PathSiteProbe(site: PathSite) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		def accessor = loc.frame.getFrameAccessor();
		def path = apply(accessor, selectArm(accessor));
		if (path >= 0) count(accessor, path);
		return ProbeAction.Continue;
	}
	// Records one execution of {path}.
	def count(accessor: FrameAccessor, path: int);

	// Returns the arm the instruction at the site is about to take, read from its operand.
	private def selectArm(accessor: FrameAccessor) -> int {
		def edges = site.edges, imm = site.imm;
		if (site.kind == PathProbeKind.DIRECT) return 0; // one outgoing edge, so there is no operand
		def v = accessor.getOperand(0);
		match (site.kind) {
			TABLE => {
				def u = Values.unbox_u(v);
				return if(u >= u32.!(edges.length), edges.length - 1, int.!(u));
			}
			NULL => return if(Values.isNull(v), 1, 0);
			NONNULL => return if(Values.isNull(v), 0, 1);
			CAST => return if(Runtime.cast(accessor.func().instance, imm.null2(), imm.ht2, v), 1, 0);
			CAST_FAIL => return if(Runtime.cast(accessor.func().instance, imm.null2(), imm.ht2, v), 0, 1);
			_ => return if(Values.unbox_u(v) != 0, 1, 0);
		}
	}
	// Applies the action of {arm} to {r}; returns the path it completes, or -1 if none.
	private def apply(accessor: FrameAccessor, arm: int) -> int {
		match (site.edges[arm].action) {
			Nothing => ;
			RSet(value) => setR(accessor, value);
			RAdd(value) => setR(accessor, getR(accessor) + value);
			CountConst(value) => return value;
			CountRPlus(value) => return getR(accessor) + value;
			CountReset(add, set) => {
				def path = getR(accessor) + add;
				setR(accessor, set);
				return path;
			}
		}
		return -1;
	}
	private def getR(accessor: FrameAccessor) -> int {
		return Values.unbox_i(accessor.getFrameVar(site.rvar));
	}
	private def setR(accessor: FrameAccessor, v: int) {
		accessor.getWriter().setFrameVar(site.rvar, Values.box_i(v));
	}
}
// The --trace-paths probe, which counts into {counts}; SPC compiles it inline.
class PathProbe extends PathSiteProbe {
	def counts: Array<int>;
	new(site: PathSite, counts) super(site) { }
	def count(accessor: FrameAccessor, path: int) {
		counts[path]++;
	}
}
