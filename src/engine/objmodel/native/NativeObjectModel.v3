// Facade for a "native" object model where Wasm structs and arrays are implemented
// using descriptors and descriptor extensions, allowing for the most efficient layout.
component ObjectModel {
	def newStruct = NativeWasmStructs.newStruct;
	def newStructFromValues = NativeWasmStructs.newStructFromValues;
	// XXX: descriptors are not yet powerful enough to create specialized arrays
	def newArray = V3SpecializedWasmArrays.newArray;
	def newArrayFromValues = V3SpecializedWasmArrays.newArrayFromValues;
}
