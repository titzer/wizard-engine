// A Wasm array instance where all fields are boxed {Value}s.
class V3BoxedWasmArray extends WasmArray {
	def decl_: ArrayDecl;
	def length: u32;
	def vals = Array<Value>.new(int.!(length));

	new(decl_, length) { }

	def decl() -> ArrayDecl { return decl_; }
	def getLength() -> u32 { return u32.!(vals.length); }
	def getElem(index: u32) -> Value { return vals[index]; }
	def setElem(index: u32, v: Value) { vals[index] = v; }
	def getRange(offset: u64, size: u64) => Traps.getRange(vals, offset, size, TrapReason.ARRAY_OOB);
	def fill(dst_offset: u64, size: u64, val: Value) -> TrapReason {
		var t = this.getRange(dst_offset, size), dr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dr.length) dr[i] = val;
		return OK;
	}
	def copy(dst_offset: u64, src: WasmArray, src_offset: u64, size: u64) -> TrapReason {
		var t = this.getRange(dst_offset, size), dr = t.result;
		if (t.reason != OK) return t.reason;
		t = V3BoxedWasmArray.!(src).getRange(src_offset, size);
		if (t.reason != OK) return t.reason;
		var sr = t.result;
		if (src == this && src_offset < dst_offset) {
			for (i = dr.length -1; i >= 0; i--) dr[i] = sr[i]; // potentially overlapping
		} else {
			for (i < dr.length) dr[i] = sr[i];
		}
		return OK;
	}
	def copyInto(dst_offset: u64, src: Range<Value>) -> TrapReason {
		var t = this.getRange(dst_offset, u64.!(src.length)), dr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dr.length) dr[i] = src[i];
		return OK;
	}
	def copyOutOf(dst: Range<Value>, src_offset: u64) -> TrapReason {
		var t = this.getRange(src_offset, u64.!(dst.length)), sr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dst.length) dst[i] = sr[i];
		return OK;
	}
	def sendBytes<R>(offset: u64, size: u64, f: Range<byte> -> R) -> MaybeTrap<R> {
		var r = this.getRange(offset, size);
		if (r.reason != TrapReason.NONE) return MaybeTrap(R.default, r.reason);
		var result = f(Ranges.map(r.result, Values.unbox_u8));
		return MaybeTrap(result, TrapReason.NONE);
	}
}

def OK = TrapReason.NONE;
def OOB = MaybeTrap<Range<Value>>(null, TrapReason.ARRAY_OOB);
