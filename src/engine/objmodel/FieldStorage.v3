// Storage representations for fields and elements, shared amongst several object models.
type FieldStorageKind {
	case Bytes(access: MemStorageKind);
	case Ref;
	case RefI31;
	case RefU64;
}

// Common utilities for field storage.
component FieldStorage {
	def getKind(st: StorageType) -> FieldStorageKind {
		match (st.valtype) {
			I32 => {
				match (st.pack) {
					UNPACKED => return FieldStorageKind.Bytes(MemStorageKind.U32);
					PACKED_I8 => return FieldStorageKind.Bytes(MemStorageKind.U8);
					PACKED_I16 => return FieldStorageKind.Bytes(MemStorageKind.U16);
				}
			}
			I64 => return FieldStorageKind.Bytes(MemStorageKind.U64);
			F32 => return FieldStorageKind.Bytes(MemStorageKind.F32);
			F64 => return FieldStorageKind.Bytes(MemStorageKind.F64);
			V128 => return FieldStorageKind.Bytes(MemStorageKind.V128);
			Ref(nullable, heap) => {
				match (heap) {
					ANY, EQ, I31, EXTERN => return FieldStorageKind.RefI31; // may hold an i31
					Cont, NOCONT => return FieldStorageKind.RefU64;
					_ => return FieldStorageKind.Ref;
				}
			}
			_ => return FieldStorageKind.Ref; // BOTTOM, Host
		}
	}
	// Gets the memory storage kind for accessing a field of {kind}, with the given sign extension.
	def toMemStorage(kind: FieldStorageKind, signed: bool) -> MemStorageKind {
		match (kind) {
			Bytes(access) => return withSign(access, signed);
			Ref, RefI31 => return MemStorageKind.U64;
			RefU64 => return MemStorageKind.V128;
		}
	}
	// Gets the memory storage kind for {access} with sign extension, if {signed}.
	def withSign(access: MemStorageKind, signed: bool) -> MemStorageKind {
		if (!signed) return access;
		match (access) {
			U8 => return MemStorageKind.I8;
			U16 => return MemStorageKind.I16;
			_ => return access;
		}
	}
	// Rounds {offset} up to a multiple of {size}, which must be a power of 2.
	def alignUp(offset: int, size: int) -> int {
		var mask = size - 1;
		return (offset + mask) & ~mask;
	}

	// Boxing and unboxing for references, and for i31-or-reference and reference + u64 values, which
	// are both stored as (Object, u64) pairs.
	def unbox_ref(v: Value) -> Object {
		return Value.Ref.!(v).val;
	}
	// An i31-or-reference as a pair of a reference and a u64, like a reference + u64 pair: either
	// (object, 0) or (null, tagged i31), so that the reference word is always {ref | u64}.
	def box_ref_i31(t: (Object, u64)) -> Value {
		return if((t.1 & 1) != 0, Value.I31(u31.view(t.1 >> 1)), Value.Ref(t.0));
	}
	def unbox_ref_i31(v: Value) -> (Object, u64) {
		match (v) {
			I31(val) => return (null, (u64.view(val) << 1) | 1);
			Ref(obj) => return (obj, 0);
			_ => return (null, 0);
		}
	}
	def box_ref_u64(t: (Object, u64)) -> Value {
		return Value.Cont(Continuation(WasmStack.!(t.0), t.1));
	}
	def unbox_ref_u64(v: Value) -> (Object, u64) {
		var r: Object, d: u64;
		match (v) {
			Cont(c) => {
				r = c.stack;
				d = c.version;
			}
			_ => ; // null reference
		}
		return (r, d);
	}
}
