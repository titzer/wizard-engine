// Storage representations for fields and elements, shared amongst several object models.
type FieldStorageKind {
	case Bytes(access: MemStorageKind);
	case Ref;
	case RefI31;
	case RefU64;
}

// Common utilities for field storage.
component FieldStorage {
	def getKind(st: StorageType) -> FieldStorageKind {
		match (st.valtype) {
			I32 => {
				match (st.pack) {
					UNPACKED => return FieldStorageKind.Bytes(MemStorageKind.U32);
					PACKED_I8 => return FieldStorageKind.Bytes(MemStorageKind.U8);
					PACKED_I16 => return FieldStorageKind.Bytes(MemStorageKind.U16);
				}
			}
			I64 => return FieldStorageKind.Bytes(MemStorageKind.U64);
			F32 => return FieldStorageKind.Bytes(MemStorageKind.F32);
			F64 => return FieldStorageKind.Bytes(MemStorageKind.F64);
			V128 => return FieldStorageKind.Bytes(MemStorageKind.V128);
			Ref(nullable, heap) => {
				match (heap) {
					ANY, EQ, I31, EXTERN => return FieldStorageKind.RefI31; // may hold an i31
					Cont, NOCONT => return FieldStorageKind.RefU64;
					_ => return FieldStorageKind.Ref;
				}
			}
			_ => return FieldStorageKind.Ref; // BOTTOM, Host
		}
	}
	// Rounds {offset} up to a multiple of {size}, which must be a power of 2.
	def alignUp(offset: int, size: int) -> int {
		var mask = size - 1;
		return (offset + mask) & ~mask;
	}

	// Boxing and unboxing for references, i31-or-reference pairs, and reference + u64 pairs.
	def unbox_ref(v: Value) -> Object {
		return Value.Ref.!(v).val;
	}
	def box_i31ref(t: (u32, Object)) -> Value {
		return if ((t.0 & 1) == 1, Value.I31(u31.view(t.0 >> 1)), Value.Ref(t.1));
	}
	def unbox_i31ref(v: Value) -> (u32, Object) {
		var d: u32, r: Object;
		match (v) {
			I31(val) => d = (u32.!(val) << 1) | 1;
			Ref(obj) => r = obj;
			_ => ;
		}
		return (d, r);
	}
	def box_ref_u64(t: (Object, u64)) -> Value {
		return Value.Cont(Continuations.fromStoredObject(t.0, t.1));
	}
	def unbox_ref_u64(v: Value) -> (Object, u64) {
		var r: Object, d: u64;
		match (v) {
			Cont(c) => {
				r = Continuations.getStoredObject(c);
				d = Continuations.getStoredVersion(c);
			}
			_ => ; // null reference
		}
		return (r, d);
	}
}
