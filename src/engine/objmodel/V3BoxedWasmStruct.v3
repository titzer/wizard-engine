// A Wasm struct instance where all fields are boxed {Value}s.
class V3BoxedWasmStruct extends WasmStruct {
	def decl_: StructDecl;
	def vals = Array<Value>.new(decl_.field_types.length);

	new(decl_) { }

	def decl() -> StructDecl { return decl_; }
	def getField(index: u31) -> Value { return vals[index]; }
	def setField(index: u31, v: Value) { vals[index] = v; } // TODO: dynamic typecheck?
}
