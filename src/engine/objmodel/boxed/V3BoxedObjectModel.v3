// Facade for the Virgil III object model, where Wasm structs and arrays are
// just wrappers around an underlying array of boxed values: {Array<Value>}.
def OK = TrapReason.NONE;
component ObjectModel {
	// Allocation functions.
	def newStruct = V3WasmStruct.new;
	def newArray = V3WasmArray.new;

	// Bulk access functions.
	def newStructFromValues(decl: StructDecl, vals: Range<Value>) -> V3WasmStruct {
		var obj = V3WasmStruct.new(decl);
		for (i < vals.length) obj.vals_[i] = vals[i];
		return obj;
	}
	def newArrayFromValues(decl: ArrayDecl, vals: Range<Value>) -> V3WasmArray {
		var obj = V3WasmArray.new(decl, u32.!(vals.length));
		for (i < vals.length) obj.vals_[i] = vals[i];
		return obj;
	}
	def arrayFill(dst: WasmArray, dst_offset: u64, size: u64, val: Value) -> TrapReason {
		var obj = V3WasmArray.!(dst);
		var t = obj.getRange(dst_offset, size), dr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dr.length) dr[i] = val;
		return OK;
	}
	def arrayCopy(dst: WasmArray, dst_offset: u64, src: WasmArray, src_offset: u64, size: u64) -> TrapReason {
		var t = V3WasmArray.!(dst).getRange(dst_offset, size), dr = t.result;
		if (t.reason != OK) return t.reason;
		t = V3WasmArray.!(src).getRange(src_offset, size);
		if (t.reason != OK) return t.reason;
		var sr = t.result;
		if (src == dst && src_offset < dst_offset) {
			for (i = dr.length -1; i >= 0; i--) dr[i] = sr[i]; // potentially overlapping
		} else {
			for (i < dr.length) dr[i] = sr[i];
		}
		return OK;
	}
	def copyInto(dst: WasmArray, dst_offset: u64, src: Range<Value>) -> TrapReason {
		var obj = V3WasmArray.!(dst);
		var t = obj.getRange(dst_offset, u64.!(src.length)), dr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dr.length) dr[i] = src[i];
		return OK;
	}
	def copyOutOf(dst: Range<Value>, src: WasmArray, src_offset: u64) -> TrapReason {
		var obj = V3WasmArray.!(src);
		var t = obj.getRange(src_offset, u64.!(dst.length)), sr = t.result;
		if (t.reason != OK) return t.reason;
		for (i < dst.length) dst[i] = sr[i];
		return OK;
	}
	def sendBytes<R>(src: WasmArray, offset: u64, size: u64, f: Range<byte> -> R) -> MaybeTrap<R> {
		var obj = V3WasmArray.!(src);
		var r = obj.getRange(offset, size);
		if (r.reason != TrapReason.NONE) return MaybeTrap(R.default, r.reason);
		var result = f(Ranges.map(r.result, Values.unbox_u8));
		return MaybeTrap(result, TrapReason.NONE);
	}
}

class V3WasmStruct extends WasmStruct {
	private def decl_: StructDecl;
	private def vals_ = Array<Value>.new(decl_.field_types.length);

	new(decl_) { }

	def decl() -> StructDecl { return decl_; }
	def getField(index: u31) -> Value { return vals_[index]; }
	def setField(index: u31, v: Value) { vals_[index] = v; } // XXX: dynamic typecheck
}

def OOB = MaybeTrap<Range<Value>>(null, TrapReason.ARRAY_OOB);

class V3WasmArray extends WasmArray {
	private def decl_: ArrayDecl;
	private def length_: u32;
	private def vals_ = Array<Value>.new(int.!(length_));

	new(decl_, length_) { }

	def decl() -> ArrayDecl { return decl_; }
	def getLength() -> u32 { return u32.!(vals_.length); }
	def getElem(index: u32) -> Value { return vals_[index]; }
	def setElem(index: u32, v: Value) { vals_[index] = v; }
	def getRange(offset: u64, size: u64) => Traps.getRange(vals_, offset, size, TrapReason.ARRAY_OOB);
}
