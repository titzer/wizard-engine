// Facade for an object model where Wasm structs and arrays are just wrappers around an
// underlying array of boxed values: {Array<Value>}.
component ObjectModel {
	// Allocation functions.
	def newStruct = V3BoxedWasmStruct.new;
	def newStructFromValues(decl: StructDecl, vals: Range<Value>) -> V3BoxedWasmStruct {
		var obj = V3BoxedWasmStruct.new(decl);
		for (i < vals.length) obj.vals[i] = vals[i];
		return obj;
	}
	def newArray = V3BoxedWasmArray.new;
	def newArrayFromValues(decl: ArrayDecl, vals: Range<Value>) -> V3BoxedWasmArray {
		var obj = V3BoxedWasmArray.new(decl, u32.!(vals.length));
		for (i < vals.length) obj.vals[i] = vals[i];
		return obj;
	}
}

