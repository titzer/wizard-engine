// A thin, OS-independent wrapper around the kernel mmap() and mprotect() operations.
// The OS-specific primitives are provided by {OsMem}.
component Mmap {
	def PROT_NONE = OsMem.PROT_NONE;
	def PROT_READ = OsMem.PROT_READ;
	def PROT_WRITE = OsMem.PROT_WRITE;
	def PROT_EXEC = OsMem.PROT_EXEC;
	def MAP_PRIVATE = OsMem.MAP_PRIVATE;
	def MAP_ANONYMOUS = OsMem.MAP_ANONYMOUS;

	def reserve(size: u64, prot: int) -> Mapping {
		return reserve_(size, prot, MAP_PRIVATE | MAP_ANONYMOUS);
	}
	def reserveRaw(size: u64, prot: int, flags: int) -> (Pointer, Pointer) {
		var start = OsMem.mmap(size, prot, flags);
		if (start == Pointer.NULL) return (Pointer.NULL, Pointer.NULL);
		return (start, start + i64.view(size));
	}
	private def reserve_(size: u64, prot: int, flags: int) -> Mapping {
		var t = reserveRaw(size, prot, flags);
		if (t.0 == Pointer.NULL) return null;
		var range = MemoryRange.new(t);
		var mapping = Mapping.new(range);
		RiGc.registerFinalizer(mapping, range.unmap);
		return mapping;
	}
	def protect(start: Pointer, size: u64, prot: int) -> bool {
		return OsMem.mprotect(start, size, prot);
	}
}

// The (root) handle for a memory region. Don't lose it!
// When the mapping is garbage collected, the memory range will be unmapped automatically,
// if the underlying range has not been manually unmapped.
class Mapping(range: MemoryRange) { }

class MemoryRange {
	def var start: Pointer;
	def var end: Pointer;

	new(start, end) { }

	def unmap() {
		if (start == Pointer.NULL) return; // already deallocated
		OsMem.munmap(start, u64.view(end - start));
		start = end = Pointer.NULL;
	}
	def size() -> u64 {
		return u64.view(end - start);
	}
	def contains(p: Pointer) -> bool {
		return p >= start && p < end;
	}
	def range(offset: int, length: int) -> Range<byte> {
		return CiRuntime.forgeRange(this.start + offset, length);
	}
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.put2("MemRange[0x%x, 0x%x)", start - Pointer.NULL, end - Pointer.NULL);
	}
}
