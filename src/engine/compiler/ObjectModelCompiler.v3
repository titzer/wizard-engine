// An object model's code generator for inline accesses to Wasm GC objects in the single-pass compiler.
// The compiler decodes immediates, pops operands into registers, null-checks object operands, and
// allocates result registers; these methods emit the remaining, object-model-specific code. They must
// not clobber operand registers. Temporaries may be allocated with {SinglePassCompiler.allocTmp},
// except in {emitCastTest}, which must only use the temporaries passed to it, and after a branch that
// merges again, since allocation may spill.
class ObjectModelCompiler {
	// Allocation leaves a new object with zero (default) fields or elements in {dst}, with the
	// operands still on the abstract stack, since allocation may call
	// {SinglePassCompiler.emitCallRuntimePreserving}, which may trigger a GC.
	def emitStructNew(spc: SinglePassCompiler, decl: StructDecl, dst: Reg);
	// Allocates an array of {length} elements; {fixed_length} is the length if it is a constant, or -1.
	def emitArrayNew(spc: SinglePassCompiler, decl: ArrayDecl, length: Reg, fixed_length: int, dst: Reg);
	// Initializes element {index} of a new array, which has at least {index + 1} elements.
	def emitArrayInit(spc: SinglePassCompiler, decl: ArrayDecl, obj: Reg, index: int, val: Reg);

	def emitStructGet(spc: SinglePassCompiler, decl: StructDecl, index: u31, signed: bool, dst: Reg, obj: Reg);
	def emitStructSet(spc: SinglePassCompiler, decl: StructDecl, index: u31, obj: Reg, val: Reg);
	// Array accesses must bounds-check {index}.
	def emitArrayGet(spc: SinglePassCompiler, decl: ArrayDecl, signed: bool, dst: Reg, obj: Reg, index: Reg);
	def emitArraySet(spc: SinglePassCompiler, decl: ArrayDecl, obj: Reg, index: Reg, val: Reg);
	def emitArrayLen(spc: SinglePassCompiler, dst: Reg, obj: Reg);
	// Tests whether the reference in {obj}, which is on top of the abstract stack and is neither null
	// nor an i31, is an instance of the heap type {ht_val}. Branches to {fail} if not, falls through if
	// so. Inconclusive cases can call {SinglePassCompiler.emitCallRuntimeCast}.
	def emitCastTest(spc: SinglePassCompiler, obj: Reg, ht_val: int, fail: MasmLabel, tmp1: Reg, tmp2: Reg);
}
