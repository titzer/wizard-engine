// Implements a monitor that profiles dynamic execution paths through functions.
def monitor_ = MonitorRegistry.add(
	"path-profile", "Profiles dynamic execution paths through functions.",
	PathProfilingMonitor.new());

class PathProfilingMonitor extends Monitor {
	def entries = Vector<PathProfileEntry>.new();

	def onParse(m: Module, err: ErrorGen) {
		for (j < m.functions.length) {
			def func: FuncDecl = m.functions[j];
			if (func.imp != null) continue; // skip imported functions
			def e = PathProfileEntry.new(m, func, PathProfile.new(func));
			entries.put(e);
			if (e.profile.reason != null) continue;
			e.counts = PathCounts.new(e.profile.numPaths);
			// a probe where an arm changes {r} or the counts, or is a self-loop
			for (site in e.profile.sites) {
				var loop = false;
				for (te in site.edges) if (te.source == te.target) loop = true;
				if (!site.acts() && !loop) continue;
				def probe = PathMonitorProbe.new(site, e.counts);
				Instrumentation.insertLocalProbe(m, func.func_index, site.pc, probe);
				e.probes.put(probe);
			}
		}
	}
	def onFinish(i: Instance, r: Result) {
		for (j < entries.length) {
			def e = entries[j], p = e.profile;
			out.put1("func %q", e.func.render(e.module.names, _));
			if (p.reason != null) {
				out.put1(": not profiled, %s", p.reason).ln();
				continue;
			}
			out.ln();
			printCfg(out, p.blocks);
			// each call site lists only the paths its calls took
			for (s < e.counts.sites.length) {
				def site = e.counts.sites[s], counts = e.counts.counts[s];
				match (site.0) {
					null => out.puts("  caller engine");
					x: WasmFunction => out.put2("  caller %q +%d", x.renderShort, site.1);
					x: HostFunction => out.put1("  caller %q", x.render);
				}
				out.ln();
				for (k < counts.length) {
					if (counts[k] > 0) out.put2("    counts[%d] = %d", k, counts[k]).ln();
				}
			}
			// each path number with the route it denotes, so counts[k] can be read back to a route
			for (k < p.numPaths) {
				out.put2("  counts[%d] = %d", k, e.counts.total(k)).ln();
				out.puts("      path:");
				p.renderPath(k, out);
				out.ln();
			}
			// (Section 4.1) a self-loop is counted, not path-profiled. One line per branch arm that
			// reaches one.
			for (i < e.probes.length) {
				def probe = e.probes[i], edges = probe.site.edges;
				for (arm < edges.length) {
					def te = edges[arm];
					if (te.source != te.target) continue;
					out.put2("  selfloop[block %d +%d", te.source.id, te.source.last_instr_pc);
					out.put2(" arm %d] = %d", arm, probe.loops[arm]).ln();
				}
			}
		}
	}
}

// {module} is per-entry, not a monitor field: onParse runs once per module while {entries}
// accumulates across all of them, so a shared field would render every name against the last one
private class PathProfileEntry(module: Module, func: FuncDecl, profile: PathProfile) {
	var counts: PathCounts;
	def probes = Vector<PathMonitorProbe>.new();
}
// A function's path counts, kept separately for each call site: the calling function and the pc
// of its call, where a host caller has no pc and the engine is a null caller.
private class PathCounts(numPaths: int) {
	def sites = Vector<(Function, int)>.new();
	def counts = Vector<Array<int>>.new();

	def inc(accessor: FrameAccessor, path: int) {
		var site: (Function, int);
		match (accessor.caller()) {
			None => site = (null, -1);
			Wasm(func, pc, frame) => site = (func, pc);
			Host(func, frame) => site = (func, -1);
		}
		for (i < sites.length) {
			if (sites[i] == site) {
				counts[i][path]++;
				return;
			}
		}
		sites.put(site);
		def c = Array<int>.new(numPaths);
		c[path] = 1;
		counts.put(c);
	}
	// the count for {path} across every call site
	def total(path: int) -> int {
		var sum = 0;
		for (i < counts.length) sum += counts[i][path];
		return sum;
	}
}
// Runs the action of the arm its site's decision takes against the caller's counts, and counts
// the trips of an arm that is a self-loop, whose action is nothing.
private class PathMonitorProbe(site: PathSite, counts: PathCounts) extends Probe {
	def loops = Array<int>.new(site.edges.length);
	def fire(loc: DynamicLoc) -> ProbeAction {
		def accessor = loc.frame.getFrameAccessor();
		def arm = site.selectArm(accessor), te = site.edges[arm];
		if (te.source == te.target) loops[arm]++;
		def path = site.apply(accessor, arm);
		if (path >= 0) counts.inc(accessor, path);
		return ProbeAction.Continue;
	}
}

// CFG + val(e) printing
def printCfg(out: TraceBuilder, blocks: Vector<ProfBlock>) {
	for (i < blocks.length) printBlock(out, blocks[i]);
}
def printBlock(out: TraceBuilder, b: ProfBlock) {
	// the range of bytes this block owns; its outgoing edges are probed at {last_instr_pc}
	out.put3("  block %d +%d ... %d", b.id, b.bind_pos, b.end).ln();
	Lists.apply(b.outgoing, fun (e: ProfEdge) {
		// Increment(e) is defined for chords only; a tree edge carries none
		if (e.isChord) {
			out.put3("    -> block %d val=%d inc=%d", e.target.id, e.val, e.increment);
		} else {
			out.put2("    -> block %d val=%d", e.target.id, e.val);
		}
		// Section 4 edge kinds: without these a dummy is indistinguishable from a real val=0 edge
		if (e.isDummy) out.puts(" DUMMY");
		// skip backedges to convert CFG to DAG (Section 4)
		if (e.isBackedge) out.puts(" BACKEDGE");
		out.ln();
	});
}
