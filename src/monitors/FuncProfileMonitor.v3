// A flat function-based profiler.
def monitor_ = MonitorRegistry.add(
	"fprofile", "Reports execution time spent in individual functions.",
	FuncProfileMonitor.new());
def filter_ = monitor_.options.addAlias(
	monitor_.options.newDeclFilterOption("filter", "apply profiling to selected functions"),
	"f");

var ticks: void -> u64;
var filter: DeclFilter;

var current: FuncEntry;		// profiled function currently executing, or null if none
var since: u64;			// tick at which {current} began executing

def transition(next: FuncEntry) {
	if (current == next) return; // fast path: no change
	var now = u64.view(ticks());
	if (current != null) current.cumul += now - since;
	current = next;
	since = now;
}

def NONE_PROBE = TransitionProbe.new(null); // used for functions excluded by the filter
def ARRIVE: byte = 1, LEAVE: byte = 2;

class FuncProfileMonitor extends Monitor {
	def entries = Vector<FuncEntry>.new();
	// format: --monitors=fprofile{<filter>}
	def configure(args: string) -> string {
		if (args != null) filter = filter_.val;
		return null;
	}
	def onParse(module: Module, err: ErrorGen) {
		if (true) ticks = Target.getRdtsc(); // TODO: make configurable
		else ticks = Target.ticksNs;

		var bi = BytecodeIterator.new();
		for (i < module.functions.length) {
			var f = module.functions[i];
			if (f.imp != null) continue;
			// All functions get transition probes so that time is never attributed to a profiled
			// function while an unprofiled function is executing.
			var arrive: Probe, leave: Probe;
			if (filter == null || filter.matches(module, f)) {
				var entry = FuncEntry.new(module, f);
				entries.put(entry);
				Instrumentation.insertFuncEntryProbe(module, f.func_index, EntryProbe.new(entry));
				arrive = TransitionProbe.new(entry);
				leave = NONE_PROBE;
			} else {
				Instrumentation.insertFuncEntryProbe(module, f.func_index, NONE_PROBE);
				arrive = leave = NONE_PROBE;
			}
			var sites = findSites(bi, f);
			for (pc < sites.length) {
				match (sites[pc]) {
					ARRIVE => Instrumentation.insertLocalProbe(module, f.func_index, pc, arrive);
					LEAVE => Instrumentation.insertLocalProbe(module, f.func_index, pc, leave);
					_ => ;
				}
			}
		}
	}
	def onFinish(i: Instance, r: Result) {
		transition(null); // close out the last interval, e.g. if an exception escaped to the host
		output(out, entries);
	}
}

// Computes the arrive and leave sites for {f}, indexed by pc. A pc that is both an arrive and a
// leave site is a leave site, since control leaves the function again immediately.
def findSites(bi: BytecodeIterator, f: FuncDecl) -> Array<byte> {
	var sites = Array<byte>.new(f.orig_bytecode.length);
	for (it = bi.reset(f); it.more(); it.next()) {
		match (bi.current()) {
			CALL, CALL_INDIRECT, CALL_REF, SUSPEND, SWITCH => {
				sites[bi.pc] = LEAVE;
				arrive(sites, bi.nextPc()); // return from callee, or resumption of this stack
			}
			RESUME, RESUME_THROW, RESUME_THROW_REF => {
				sites[bi.pc] = LEAVE;
				arrive(sites, bi.nextPc()); // continuation returned
				// suspension handlers (`on $tag $label` clauses); switch clauses do not land here
				var resume_sites = f.handlers.resume_sites;
				var table = if(resume_sites != null && bi.pc < resume_sites.length, resume_sites[bi.pc]);
				if (table != null) {
					for (i < ResumeSites.header(table).switch_start_index) {
						arrive(sites, ResumeSites.entry(table, i).handler_pc);
					}
				}
			}
			RETURN, RETURN_CALL, RETURN_CALL_INDIRECT, RETURN_CALL_REF => {
				sites[bi.pc] = LEAVE;
			}
			_ => ;
		}
	}
	sites[sites.length - 1] = LEAVE; // final end
	// exception handlers
	for (e in f.handlers.ex_handlers) {
		if (e.tag == Modules.EX_TAG_DELEGATE) continue; // delegate redirects the search; doesn't land
		match (e.info) {
			Direct(handler_pc, ex_slot, val_stack_top, sidetable_pos) => arrive(sites, handler_pc);
			Sidetable(push_exnref, sidetable_entry) => arrive(sites, f.sidetable.getCatchEntry(sidetable_entry).handler_pc);
		}
	}
	return sites;
}

def arrive(sites: Array<byte>, pc: int) {
	if (sites[pc] == 0) sites[pc] = ARRIVE;
}

def compareEntries(a: FuncEntry, b: FuncEntry) -> bool {
	return a.cumul > b.cumul;
}

private class FuncEntry(module: Module, func: FuncDecl) {
	var count: u64;
	var cumul: u64;
}

private class EntryProbe(entry: FuncEntry) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		entry.count++;
		transition(entry);
		return ProbeAction.Continue;
	}
}

private class TransitionProbe(next: FuncEntry) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		transition(next);
		return ProbeAction.Continue;
	}
}

def table = initTable();
def initTable() -> TraceTable {
	var t = TraceTable.new(["Function", "count", "cycles", "percent"]);
	t.cells[0].set(24, Justification.LEFT, Color.NONE);
	t.cells[1].set(9, Justification.RIGHT, Color.NONE);
	t.cells[2].set(12, Justification.RIGHT, Color.NONE);
	t.cells[3].set(8, Justification.RIGHT, Color.NONE);
	return t;
}

def output(out: TraceBuilder, entries: Vector<FuncEntry>) {
	var C = table.cells;
	var total = 0uL;
	C[0].color = Color.COVERED;
	C[1].color = Color.COUNT;
	C[2].color = Color.COUNT;
	C[3].color = Color.COUNT;

	for (i < entries.length) { // compute maximum function name length for formatting
		var e = entries[i], func = e.func, count = e.count;
		total += e.cumul;		
		if (count == 0) continue;
		out.reset();
		func.render(e.module.names, out);
		if (out.length > C[0].width) C[0].width = if(out.length > byte.max, byte.max, byte.view(out.length));
	}
	out.reset();

	if (MonitorOptions.CSV.val) table.putCsvHeader(out);
	else table.putTableHeader(out);
	out.flush();

	var array = entries.copy();
	var sorted = Arrays.sort(array, 0, array.length, compareEntries);
	for (e in sorted) {
		var func = e.func, count = e.count, cumul = e.cumul;
		if (count == 0) continue;
		func.render(e.module.names, C[0]);
		C[1].putd(count);
		C[2].putd(cumul);
		TraceUtil.renderPercent(C[3], long.view(e.cumul), long.view(total), 3);
		if (MonitorOptions.CSV.val) table.putCsvRow(out);
		else table.putTableRow(out);
		out.flush();
	}
}
