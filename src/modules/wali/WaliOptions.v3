// Handles command-line options for WALI.
component WaliOptions {
	def group = OptionsRegistry.newGroup("WALI", printHelp);
	// WALI programs get their environment from a file rather than from the engine
	// directly: musl's startup calls the "__get_init_envfile" import to learn the path
	// and parses the file itself.
	def ENV_FILE = group.newPathOption("env-file", null, "File of KEY=VALUE lines defining the program's environment.");

	def printHelp(out: TraceBuilder) {
		var H = out.putsln, L = out.ln;
		H("WALI can be configured with the following options:");
		L();
		H("    --env-file=<path>");
		H("        Path to a file of KEY=VALUE lines, one per line, that defines the");
		H("        environment of the program. WALI's libc reads this file at startup;");
		H("        without it the program starts with an empty environment.");
		L();
	}
}
