	//========================================================================================
	// {stack_t} is { void* ss_sp; int ss_flags; size_t ss_size; }: 12 bytes in the guest,
	// but three 8-byte words on the host. The ss_sp of the returned old stack has to be
	// translated back into a guest offset, since that is what the guest handed in.
	// The guest's alternate signal stack is tracked per-instance instead of being handed
	// to the kernel. The engine's own runtime keeps a sigaltstack for stack-overflow
	// handling (see RiOs.v3), and there is only one per thread. Signals are never
	// delivered to guest handlers, so nothing is lost by keeping this in the engine.
	def sigaltstack(uss: int, uoss: int) -> long {
		// Both structs are bounds-checked in full up front, so a partially accessible
		// {uoss} cannot leave a new stack installed with nothing reported back.
		var newreg = getRegion(uss, WaliStruct_sigaltstack.size);
		if (uss != 0 && newreg.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var oldreg = getRegion(uoss, WaliStruct_sigaltstack.size);
		if (uoss != 0 && oldreg.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);

		var old_sp = altstack_sp, old_size = altstack_size;
		var old_flags = if(altstack_on, 0, SS_DISABLE);
		if (uss != 0) {
			var n = Ref<WaliStruct_sigaltstack>.of(newreg.result);
			if ((n.ss_flags & ~SS_DISABLE) != 0) return neg(WaliErrno.EINVAL);
			if ((n.ss_flags & SS_DISABLE) != 0) {
				altstack_on = false;
				altstack_sp = 0;
				altstack_size = 0;
			} else {
				if (n.ss_size < MINSIGSTKSZ) return neg(WaliErrno.ENOMEM);
				var stack = getRegion(int.view(n.ss_sp), int.view(n.ss_size));
				if (stack.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
				altstack_on = true;
				altstack_sp = n.ss_sp;
				altstack_size = n.ss_size;
			}
		}
		if (uoss != 0) {
			var o = Ref<WaliStruct_sigaltstack>.of(oldreg.result);
			o.ss_sp = old_sp;
			o.ss_flags = old_flags;
			o.ss_size = old_size;
		}
		return 0;
	}
