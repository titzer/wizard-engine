	//========================================================================================
	def clock_nanosleep(clockid: int, flags: int, req_ptr: int, rem_ptr: int) -> long {
		var r = getRegion(req_ptr, 16);
		if (r.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var m = getPtr(rem_ptr, 16);
		if (m.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_clock_nanosleep, (clockid, flags, Pointer.atContents(r.result), m.result)).0;
	}
	//========================================================================================
	def epoll_wait(epfd: int, events: int, maxevents: int, timeout: int) -> long {
		var sys_epfd = fdmap.get(epfd);
		if (maxevents < 0) return neg(WaliErrno.EINVAL);
		var e = getPtr(events, maxevents * 12);
		if (e.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_epoll_wait, (sys_epfd, e.result, maxevents, timeout)).0;
	}
