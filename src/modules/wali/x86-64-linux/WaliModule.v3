	//========================================================================================
	def pselect6(nfds: int, readfds: int, writefds: int, exceptfds: int, timeout: int, sigmask: int) -> long {
		if (nfds < 0 || nfds > FD_SETSIZE) return neg(WaliErrno.EINVAL);
		var rd = Array<u64>.new(FD_SET_WORDS), wr = Array<u64>.new(FD_SET_WORDS), ex = Array<u64>.new(FD_SET_WORDS);
		// The kernel's last argument is a {sigset_t*, size_t} pair: 8 bytes in the guest
		// against 16 on the host.
		var sm = Array<u64>.new(2);
		var hnfds = 0;
		if (readfds != 0) { var m = copyFdSet(readfds, nfds, rd); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		if (writefds != 0) { var m = copyFdSet(writefds, nfds, wr); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		if (exceptfds != 0) { var m = copyFdSet(exceptfds, nfds, ex); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		var t = getPtr(timeout, timespec.size);
		if (t.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (sigmask != 0) {
			var set = memory.read_u32(u32.view(sigmask), 0);
			if (set.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
			var size = memory.read_u32(u32.view(sigmask), 4);
			if (size.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
			var sp = getPtr(int.view(set.result), int.view(size.result));
			if (sp.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
			sm[0] = u64.view(sp.result - Pointer.NULL);
			sm[1] = size.result;
		}
		// No allocation may happen between taking these interior pointers and the call.
		var pr = if(readfds != 0, Pointer.atContents(rd), Pointer.NULL);
		var pw = if(writefds != 0, Pointer.atContents(wr), Pointer.NULL);
		var pe = if(exceptfds != 0, Pointer.atContents(ex), Pointer.NULL);
		var ps = if(sigmask != 0, Pointer.atContents(sm), Pointer.NULL);
		var r = Linux.syscall(LinuxConst.SYS_pselect6, (hnfds, pr, pw, pe, t.result, ps)).0;
		if (r < 0) return r;
		if (readfds != 0 && writeFdSet(readfds, nfds, rd) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (writefds != 0 && writeFdSet(writefds, nfds, wr) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (exceptfds != 0 && writeFdSet(exceptfds, nfds, ex) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return r;
	}
	//========================================================================================
	def ppoll(buf: int, a2: long, timeout: int, sigmask: int, len: int) -> long {
		var n = int.!(a2);
		if (n < 0 || n > POLL_MAX) return neg(WaliErrno.EINVAL);
		var t = getPtr(timeout, timespec.size);
		if (t.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var sm = getPtr(sigmask, len);
		if (sm.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var host = copyPollfd(buf, n);
		if (host == null) return neg(WaliErrno.EFAULT);
		var r = Linux.syscall(LinuxConst.SYS_ppoll, (Pointer.atContents(host), n, t.result, sm.result, len)).0;
		if (r < 0) return r;
		if (writePollRevents(buf, n, host) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return r;
	}
