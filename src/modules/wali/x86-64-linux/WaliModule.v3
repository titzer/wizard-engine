	//========================================================================================
	def cl_copy_argv(buf: int, index: int) -> int {
		if (cmdline_args == null || index >= cmdline_args.length) return 0;
		var str = cmdline_args[index];
		var reason = memory.copyIn(u32.view(buf), str, 0, u32.!(str.length));
		if (reason != TrapReason.NONE) return TODO_ZERO; // trap instead?
		return str.length;
	}
	//========================================================================================
	def wali_init() -> int {
		return TODO_ZERO;
	}
	//========================================================================================
	def wali_deinit() -> int {
		return TODO_ZERO;
	}
	//========================================================================================
	def proc_exit(code: u32) -> HostResult {
		return HostResult.Throw(Exit.new(code));
	}
	//========================================================================================
	// Writes the path of the environment file into the guest buffer, NUL-terminated, and
	// returns its length; 0 means "no environment file", which the guest treats as an
	// empty environment rather than an error.
	def get_init_envfile(buf: int, buf_len: int) -> int {
		var path = WaliOptions.ENV_FILE.val;
		if (path == null || memory == null) return TODO_ZERO;
		if (path.length + 1 > buf_len) return TODO_ZERO;
		if (memory.copyIn(u64.view(u32.view(buf)), path, 0, u64.!(path.length)) != TrapReason.NONE) return TODO_ZERO;
		if (memory.write_u8(u32.view(buf), u32.!(path.length), 0) != TrapReason.NONE) return TODO_ZERO;
		return path.length;
	}
}

layout WaliStruct_stat { // TODO: copied from Virgil x86-64-linux
	+0	st_dev:		u64;
	+8	st_ino:		u64;
	+16	st_mode:	u64;
	+24	st_nlink:	u64;
//	+28	st_uid:		u32;
	+32	st_gid:		u32;
	+48	st_size:	u64;
	+56	st_blksize:	u64;
	+64	st_blocks:	u64;
	+72	st_atim:	timespec;
	+88	st_mtim:	timespec;
	+104	st_ctim:	timespec;
	=144;
}

// The wasm32 counterparts of {iovec} and {msghdr} from the host's SyscallLayouts. Every
// pointer and word is 32 bits, so neither struct matches its host layout.
layout WaliStruct_iovec {
	+0	iov_base:	u32;
	+4	iov_len:	u32;
	=8;
}

layout WaliStruct_sigaltstack {
	+0	ss_sp:		u32;
	+4	ss_flags:	i32;
	+8	ss_size:	u32;
	=12;
}

layout WaliStruct_msghdr {
	+0	msg_name:	u32;
	+4	msg_namelen:	u32;
	+8	msg_iov:	u32;
	+12	msg_iovlen:	u32;
	+20	msg_control:	u32;
	+24	msg_controllen:	u32;
	+32	msg_flags:	u32;
	=36;
}
