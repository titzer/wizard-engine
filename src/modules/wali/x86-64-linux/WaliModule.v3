	//========================================================================================
	def pipe(fds_ptr: int) -> long {
		var reg = getPtr(fds_ptr, 8);
		if (reg.reason != TrapReason.NONE || reg.result == Pointer.NULL) return neg(WaliErrno.EFAULT);
		var r = Linux.syscall(LinuxConst.SYS_pipe, (reg.result)).0;
		if (r < 0) return r;
		return bindFdPair(fds_ptr);
	}
	//========================================================================================
	def select(nfds: int, readfds: int, writefds: int, exceptfds: int, timeout: int) -> long {
		if (nfds < 0 || nfds > FD_SETSIZE) return neg(WaliErrno.EINVAL);
		var rd = Array<u64>.new(FD_SET_WORDS), wr = Array<u64>.new(FD_SET_WORDS), ex = Array<u64>.new(FD_SET_WORDS);
		var hnfds = 0;
		if (readfds != 0) { var m = copyFdSet(readfds, nfds, rd); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		if (writefds != 0) { var m = copyFdSet(writefds, nfds, wr); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		if (exceptfds != 0) { var m = copyFdSet(exceptfds, nfds, ex); if (m < 0) return neg(WaliErrno.EBADF); if (m > hnfds) hnfds = m; }
		var t = getPtr(timeout, /*timeval*/ 16);
		if (t.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		// No allocation may happen between taking these interior pointers and the call.
		var pr = if(readfds != 0, Pointer.atContents(rd), Pointer.NULL);
		var pw = if(writefds != 0, Pointer.atContents(wr), Pointer.NULL);
		var pe = if(exceptfds != 0, Pointer.atContents(ex), Pointer.NULL);
		var r = Linux.syscall(LinuxConst.SYS_select, (hnfds, pr, pw, pe, t.result)).0;
		if (r < 0) return r;
		if (readfds != 0 && writeFdSet(readfds, nfds, rd) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (writefds != 0 && writeFdSet(writefds, nfds, wr) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (exceptfds != 0 && writeFdSet(exceptfds, nfds, ex) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return r;
	}
