def TODO_ZERO = 0;
def TODO_EMPTY = ();

def neg(e: WaliErrno) => 0L - e.code;

def TODO_UNIMPLEMENTED = neg(WaliErrno.ENOSYS); // returned for any unimplemented call.

def PR_SET_NAME = 15;	// prctl() options that take a guest pointer in arg2
def PR_GET_NAME = 16;

def IOV_MAX = 1024;
def POLL_MAX = 4096;
def FD_SETSIZE = 1024;
def FD_SET_WORDS = FD_SETSIZE / 64;
def AT_FDCWD = -100;	// "relative to cwd" sentinel accepted by the *at() syscalls
def HOST_PAGE_SIZE = 4096;
def WASM_PAGE_SIZE = 65536u;
def SS_DISABLE = 2;	// sigaltstack flags
def MINSIGSTKSZ = 2048u;
def MREMAP_MAYMOVE = 1;
def MREMAP_FIXED = 2;

def F_DUPFD = 0;	// fcntl() commands
def F_GETLK = 5;	// ...the ones below take a guest pointer in the third argument
def F_SETLK = 6;
def F_SETLKW = 7;
def F_SETOWN_EX = 15;
def F_GETOWN_EX = 16;
def F_DUPFD_CLOEXEC = 1030;

// Implements the "wali" module interface as a host module.
class WaliInstance {
	private var memory: Memory;
	private def fdmap = FileDescriptorMap.new(1000); // per-instance: fd table
	private var altstack_sp: u32;		// per-instance: guest alternate signal stack
	private var altstack_size: u32;
	private var altstack_on: bool;
	private var cmdline_args: Array<string>; // global: environment
	private var cmdline_env: Array<string>; // global: environment, TODO
	private var trace: bool;

	def mbind(instance: Instance) {
		memory = instance.findExportOfType<Memory>(null);
	}
	def init(args: Array<string>, t: bool, err: ErrorGen) {
		cmdline_args = args;
		trace = t;
	}
	def getMain(instance: Instance) -> (Function, Array<Value>) {
		var main = instance.findExportOfType<Function>(GlobMatcher.new("_start"));
		if (main == null) {
			for (iex in instance.exports) {
				match (iex) {
					x: Function => {
						// If more than one exported function, don't know
						if (main != null) return (null, null);
						main = x;
					}
				}
			}
		}
		if (main == null) return (null, null);
		if (Arrays.equal(main.sig.params, SigCache.arr_i)) return (main, [Values.box_i(cmdline_args.length)]);
		return (main, Arrays.map(main.sig.params, Values.default));
	}
	def getPath(ptr: u32) -> MaybeTrap<Range<byte>> {
		if (memory == null) return MaybeTrap(null, TrapReason.MEMORY_OOB);
		return memory.range_o_32z(ptr, u32.!(LinuxConst.MAXPATHLEN));
	}
	def getRegion(buf: int, len: int) -> MaybeTrap<Range<byte>> {
		if (memory == null) return MaybeTrap(null, TrapReason.MEMORY_OOB);
		return memory.range_ol_32(u32.view(buf), u32.view(len));
	}
	// Translate a guest pointer into a host pointer for an argument the kernel treats
	// as optional, i.e. a guest NULL becomes a host NULL.
	def getPtr(buf: int, len: int) -> MaybeTrap<Pointer> {
		if (buf == 0) return MaybeTrap(Pointer.NULL, TrapReason.NONE);
		var r = getRegion(buf, len);
		if (r.reason != TrapReason.NONE) return MaybeTrap(Pointer.NULL, r.reason);
		return MaybeTrap(Pointer.atContents(r.result), TrapReason.NONE);
	}
	// Binds the host {sysfd} returned by a successful syscall to a fresh guest fd and returns
	// the guest fd. If the guest fd table is full, closes the host fd and reports EMFILE
	// rather than leaking it.
	// Translates a directory fd. AT_FDCWD is a sentinel rather than a guest fd and passes
	// through unchanged.
	def getDirFd(fd: int) -> int {
		return if(fd == AT_FDCWD, AT_FDCWD, fdmap.get(fd));
	}
	def bindFd(sysfd: long) -> long {
		var hostfd = int.!(sysfd);
		var guestfd = fdmap.alloc();
		if (guestfd < 0 || !fdmap.set(guestfd, hostfd)) {
			Linux.syscall(LinuxConst.SYS_close, hostfd);
			return neg(WaliErrno.EMFILE);
		}
		return guestfd;
	}
	// Rewrites the pair of fds the kernel wrote into guest memory at {ptr} from host fds
	// into guest fds.
	def bindFdPair(ptr: int) -> long {
		for (i: u32 < 2) {
			var index = i << 2;
			var hostfd = memory.read_u32(u32.view(ptr), index);
			if (hostfd.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
			var guestfd = bindFd(long.view(hostfd.result));
			if (guestfd < 0) return guestfd;
			if (memory.write_u32(u32.view(ptr), index, u32.!(guestfd)) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		}
		return 0;
	}

	// Builds a host iovec array from the guest's, translating each base pointer.
	def copyIovec(iov: int, iovcnt: int) -> Array<byte> {
		if (iovcnt < 0 || iovcnt > IOV_MAX) return null;
		var guest = getRegion(iov, iovcnt * WaliStruct_iovec.size);
		if (guest.reason != TrapReason.NONE) return null;
		var host = Array<byte>.new(iovcnt * iovec.size);
		for (i < iovcnt) {
			var g = Ref<WaliStruct_iovec>.of(guest.result[WaliStruct_iovec.size * i ...]);
			var p = getPtr(int.view(g.iov_base), int.view(g.iov_len));
			if (p.reason != TrapReason.NONE) return null;
			var h = Ref<iovec>.at(host, iovec.size * i);
			h.iov_base = u64.view(p.result - Pointer.NULL);
			h.iov_len = g.iov_len;
		}
		return host;
	}

	// Builds a host pollfd array from the guest's. {struct pollfd} has the same 8-byte
	// layout on both sides, but holds guest fds. Each entry is packed as
	// fd | events<<32 | revents<<48. A negative fd tells the kernel to ignore the entry
	// and passes through unchanged.
	def copyPollfd(fds: int, nfds: int) -> Array<u64> {
		var host = Array<u64>.new(nfds);
		for (i < nfds) {
			var gfd = memory.read_u32(u32.view(fds), u32.!(i * 8));
			if (gfd.reason != TrapReason.NONE) return null;
			var ev = memory.read_u32(u32.view(fds), u32.!(i * 8 + 4));
			if (ev.reason != TrapReason.NONE) return null;
			var g = int.view(gfd.result);
			var h = if(g < 0, g, fdmap.get(g));
			host[i] = u64.view(u32.view(h)) | (u64.view(ev.result & 0xFFFF) << 32);
		}
		return host;
	}
	// Copies the revents the kernel produced back into the guest's pollfd array.
	def writePollRevents(fds: int, nfds: int, host: Array<u64>) -> TrapReason {
		for (i < nfds) {
			var r = memory.write_u16(u32.view(fds), u32.!(i * 8 + 6), u16.view(host[i] >> 48));
			if (r != TrapReason.NONE) return r;
		}
		return TrapReason.NONE;
	}

	// Builds a host fd_set from the guest's. The bitmaps are indexed by fd number, and a
	// guest fd is not a host fd, so every set bit has to be moved to its host position.
	// Returns the highest host fd seen plus one (the nfds to pass on), or -1 on error.
	def copyFdSet(guest: int, nfds: int, host: Array<u64>) -> int {
		var maxfd = -1;
		for (g < nfds) {
			var word = memory.read_u32(u32.view(guest), u32.!((g >> 5) << 2));
			if (word.reason != TrapReason.NONE) return -1;
			if (((word.result >> u5.view(g)) & 1) == 0) continue;
			var h = fdmap.get(g);
			if (h < 0 || h >= FD_SETSIZE) return -1;
			host[h >> 6] |= 1uL << u6.view(h);
			if (h > maxfd) maxfd = h;
		}
		return maxfd + 1;
	}
	// Copies a host fd_set back into the guest's. select() reports readiness by clearing
	// every bit that is not ready, so all of [0, nfds) is rewritten, not just the set bits.
	def writeFdSet(guest: int, nfds: int, host: Array<u64>) -> TrapReason {
		for (g < nfds) {
			var h = fdmap.get(g);
			var ready = h >= 0 && h < FD_SETSIZE && ((host[h >> 6] >> u6.view(h)) & 1) != 0;
			var index = u32.!((g >> 5) << 2);
			var word = memory.read_u32(u32.view(guest), index);
			if (word.reason != TrapReason.NONE) return word.reason;
			var mask = 1u << u5.view(g);
			var updated = if(ready, word.result | mask, word.result & ~mask);
			var r = memory.write_u32(u32.view(guest), index, updated);
			if (r != TrapReason.NONE) return r;
		}
		return TrapReason.NONE;
	}

	// Builds a host {struct msghdr} from the guest's, along with the host iovec array it
	// refers to. The caller stores the iovec pointer into {msg_iov} immediately before the
	// syscall, once nothing more can allocate.
	def copyMsghdr(msg: int) -> (Array<byte>, Array<byte>) {
		var guest = getRegion(msg, WaliStruct_msghdr.size);
		if (guest.reason != TrapReason.NONE) return (null, null);
		var g = Ref<WaliStruct_msghdr>.of(guest.result);
		var name = getPtr(int.view(g.msg_name), int.view(g.msg_namelen));
		if (name.reason != TrapReason.NONE) return (null, null);
		var ctl = getPtr(int.view(g.msg_control), int.view(g.msg_controllen));
		if (ctl.reason != TrapReason.NONE) return (null, null);
		var iov = copyIovec(int.view(g.msg_iov), int.view(g.msg_iovlen));
		if (iov == null) return (null, null);
		var host = Array<byte>.new(msghdr.size);
		var h = Ref<msghdr>.at(host, 0);
		h.msg_name = u64.view(name.result - Pointer.NULL);
		h.msg_namelen = g.msg_namelen;
		h.msg_iovlen = g.msg_iovlen;
		h.msg_control = u64.view(ctl.result - Pointer.NULL);
		h.msg_controllen = g.msg_controllen;
		h.msg_flags = g.msg_flags;
		return (host, iov);
	}

	//========================================================================================
	// Implementations of exported host functions.
	//========================================================================================
	def read(fd: int, buf: int, len: int) -> long {
		var sys_fd = fdmap.get(fd);
		var region = getRegion(buf, len);
		if (region.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_read, (sys_fd, Pointer.atContents(region.result), len)).0;
	}
	//========================================================================================
	def write(fd: int, buf: int, len: int) -> long {
		var sys_fd = fdmap.get(fd);
		var region = getRegion(buf, len);
		if (region.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_write, (sys_fd, Pointer.atContents(region.result), len)).0;
	}
	//========================================================================================
	def open(path: int, flags: int, mode: int) -> long {
		var region = getPath(u32.view(path));
		if (region.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var r = Linux.syscall(LinuxConst.SYS_open, (Pointer.atContents(region.result), flags, mode)).0;
		if (r < 0) return r;
		return bindFd(r);
	}
	//========================================================================================
	def close(fd: int) -> long {
		var sys_fd = fdmap.get(fd);
		fdmap.free(fd);
		return Linux.syscall(LinuxConst.SYS_close, sys_fd).0;
	}
	//========================================================================================
	def dup(fd: int) -> long {
		var sys_fd = fdmap.get(fd);
		var r = Linux.syscall(LinuxConst.SYS_dup, sys_fd).0;
		if (r < 0) return r;
		return bindFd(r);
	}
	//========================================================================================
	def dup2(oldfd: int, newfd: int) -> long {
		if (!fdmap.in_range(newfd)) return neg(WaliErrno.EBADF); // guest-supplied index
		var sys_oldfd = fdmap.get(oldfd), sys_newfd = fdmap.get(newfd);
		if (sys_newfd >= 0) {
			var r = Linux.syscall(LinuxConst.SYS_dup2, (sys_oldfd, sys_newfd)).0;
			if (r < 0) return r;
			return newfd;
		}
		var r = Linux.syscall(LinuxConst.SYS_dup, (sys_oldfd)).0;
		if (r < 0) return r;
		fdmap.set(newfd, int.!(r));
		return newfd;
	}
	//========================================================================================
	def dup3(oldfd: int, newfd: int, flags: int) -> long {
		if (!fdmap.in_range(newfd)) return neg(WaliErrno.EBADF); // guest-supplied index
		var sys_oldfd = fdmap.get(oldfd), sys_newfd = fdmap.get(newfd);
		if (sys_newfd < 0) {
			var r = Linux.syscall(LinuxConst.SYS_dup, (sys_oldfd)).0;
			if (r < 0) return r;
			sys_newfd = int.!(r);
			fdmap.set(newfd, sys_newfd);
		}
		var r = Linux.syscall(LinuxConst.SYS_dup3, (sys_oldfd, sys_newfd, flags)).0;
		if (r < 0) return r;
		return newfd;
	}
	//========================================================================================
	def stat(path: int, buf: int) -> long {
		var region = getPath(u32.view(path));
		if (region.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var statbuf = getRegion(buf, WaliStruct_stat.size);
		if (statbuf.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_stat, (Pointer.atContents(region.result), Pointer.atContents(statbuf.result))).0;
	}
	//========================================================================================
	def lseek(fd: int, offset: long, whence: int) -> long {
		var sys_fd = fdmap.get(fd);
		return Linux.syscall(LinuxConst.SYS_lseek, (sys_fd, offset, whence)).0;
	}
	//========================================================================================
	def exit(code: int) -> long {
		return Linux.syscall(LinuxConst.SYS_exit, code).0;
	}
	//========================================================================================
	def fork() -> long {
		return Linux.syscall(LinuxConst.SYS_fork, ()).0;
	}
	//========================================================================================
	def access(path: int, mode: int) -> long {
		var region = getPath(u32.view(path));
		if (region.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_access, (Pointer.atContents(region.result), mode)).0;
	}
	//========================================================================================
	def exit_group(code: int) -> long {
		return Linux.syscall(LinuxConst.SYS_exit_group, (code)).0;
	}
	//========================================================================================
	def sched_getaffinity(pid: int, cpusetsize: int, mask_ptr: int) -> long {
		var m = getRegion(mask_ptr, cpusetsize);
		if (m.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_sched_getaffinity, (pid, cpusetsize, Pointer.atContents(m.result))).0;
	}
	//========================================================================================
	def set_tid_address(tidptr: int) -> long {
		var t = getRegion(tidptr, 4);
		if (t.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_set_tid_address, (Pointer.atContents(t.result))).0;
	}
	//========================================================================================
	def mmap(addr: int, length: int, prot: int, flags: int, fd: int, offset: long) -> long {
	    def X86_PAGE_SIZE = 4096u;
	    def WASM_PAGE_SIZE = 65536u;

	    if (length <= 0) return neg(WaliErrno.EINVAL);
	    if ((u64.view(offset) % X86_PAGE_SIZE) != 0u) return neg(WaliErrno.EINVAL);

	    var need = u64.view(length);
	    var wasm_pages = (need + (WASM_PAGE_SIZE - 1u)) / WASM_PAGE_SIZE;
	    // The guest can only address linear memory, so satisfy the mapping by growing the
	    // memory and mapping over the freshly added pages. {guest_addr} is the offset the
	    // guest will see; it is a wasm page boundary and therefore also host-page aligned.
	    var guest_addr = memory.num_bytes;

	    if (wasm_pages > 0u && memory.grow(wasm_pages) == -1) return neg(WaliErrno.ENOMEM);

	    // MAP_FIXED takes the *host* address of these pages.
	    var host_addr = memory.getMemBase64() + guest_addr;
	    var host_fd = if(fd < 0, fd, fdmap.get(fd));
	    var want_flags = if(fd == -1, flags | LinuxConst.MAP_ANONYMOUS, flags);
	    var ret = Linux.syscall(
		LinuxConst.SYS_mmap,
		(host_addr, length, prot, want_flags | LinuxConst.MAP_FIXED, host_fd, offset)
	    ).0;
	    if (ret < 0) return ret;
	    return long.view(guest_addr);
	}
	//========================================================================================
	// Whether {arg} is a guest pointer or a plain integer depends on {cmd}; only the
	// record-locking and owner commands take a pointer. F_DUPFD/F_DUPFD_CLOEXEC return a
	// new descriptor, which has to be bound into the guest fd table like any other.
	def fcntl(fd: int, cmd: int, arg: long) -> long {
		var sys_fd = fdmap.get(fd);
		match (cmd) {
			F_GETLK, F_SETLK, F_SETLKW, F_SETOWN_EX, F_GETOWN_EX => {
				var p = getPtr(int.!(arg), /*flock*/ 32);
				if (p.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
				return Linux.syscall(LinuxConst.SYS_fcntl, (sys_fd, cmd, p.result)).0;
			}
			F_DUPFD, F_DUPFD_CLOEXEC => {
				// {arg} is the lowest guest fd to allocate from; the host picks its own
				// number, so ask for anything and rebind the result.
				var r = Linux.syscall(LinuxConst.SYS_fcntl, (sys_fd, cmd, 0)).0;
				if (r < 0) return r;
				return bindFd(r);
			}
		}
		return Linux.syscall(LinuxConst.SYS_fcntl, (sys_fd, cmd, arg)).0;
	}
	//========================================================================================
	def sysinfo(info_ptr: int) -> long {
		var ireg = getRegion(info_ptr, wali_sysinfo.size);
		if (ireg.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_sysinfo, (Pointer.atContents(ireg.result))).0;
	}
	//========================================================================================
	def brk(brk: int) => TODO_UNIMPLEMENTED;
	//========================================================================================
	def prlimit64(pid: int, resource: int, new_limit_ptr: int, old_limit_ptr: int) -> long {
		var n = getPtr(new_limit_ptr, wali_rlimit64.size);
		if (n.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var o = getPtr(old_limit_ptr, wali_rlimit64.size);
		if (o.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_prlimit64, (pid, resource, n.result, o.result)).0;
	}
