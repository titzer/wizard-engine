	// {struct epoll_event} is 12 bytes on both sides (x86-64 packs it), so the event can be
	// passed straight through; its {data} field is opaque to the kernel and stays whatever
	// the guest put there. Only the two fds need translating.
	def epoll_ctl(epfd: int, op: int, fd: int, event: int) -> long {
		var sys_epfd = fdmap.get(epfd), sys_fd = fdmap.get(fd);
		var e = getPtr(event, /*epoll_event*/ 12);
		if (e.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_epoll_ctl, (sys_epfd, op, sys_fd, e.result)).0;
	}
