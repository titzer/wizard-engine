	//========================================================================================
	def mprotect(addr: int, len: int, prot: int) -> long {
		var n = getPtr(addr, len);
		if (n.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_mprotect, (n.result, len, prot)).0;
