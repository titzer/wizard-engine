	//========================================================================================
	def poll(fds: int, nfds: long, timeout: int) -> long {
		var n = int.!(nfds);
		if (n < 0 || n > POLL_MAX) return neg(WaliErrno.EINVAL);
		var host = copyPollfd(fds, n);
		if (host == null) return neg(WaliErrno.EFAULT);
		var r = Linux.syscall(LinuxConst.SYS_poll, (Pointer.atContents(host), n, timeout)).0;
		if (r < 0) return r;
		if (writePollRevents(fds, n, host) != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return r;
	}
