	//========================================================================================
	def prctl(option: int, arg2: long, arg3: long, arg4: long, arg5: long) -> long {
		// WALI supports only the two name options, both of which take a 16-byte guest
		// buffer in arg2; which arguments are pointers depends on {option}.
		if (option != PR_SET_NAME && option != PR_GET_NAME) return neg(WaliErrno.EINVAL);
		var p = getPtr(int.!(arg2), 16);
		if (p.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_prctl, (option, p.result)).0;
	}
