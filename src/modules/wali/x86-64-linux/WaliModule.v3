	//========================================================================================
	def sendmsg(fd: int, msg: int, flags: int) -> long {
		var sys_fd = fdmap.get(fd);
		var t = copyMsghdr(msg);
		if (t.0 == null) return neg(WaliErrno.EFAULT);
		var host = t.0;
		Ref<msghdr>.at(host, 0).msg_iov = u64.view(Pointer.atContents(t.1) - Pointer.NULL);
		return Linux.syscall(LinuxConst.SYS_sendmsg, (sys_fd, Pointer.atContents(host), flags)).0;
	}
	//========================================================================================
	def recvmsg(fd: int, msg: int, flags: int) -> long {
		var sys_fd = fdmap.get(fd);
		var t = copyMsghdr(msg);
		if (t.0 == null) return neg(WaliErrno.EFAULT);
		var host = t.0;
		var h = Ref<msghdr>.at(host, 0);
		h.msg_iov = u64.view(Pointer.atContents(t.1) - Pointer.NULL);
		var r = Linux.syscall(LinuxConst.SYS_recvmsg, (sys_fd, Pointer.atContents(host), flags)).0;
		if (r < 0) return r;
		// The kernel updates these three in place; the rest is what the guest supplied.
		var guest = getRegion(msg, WaliStruct_msghdr.size);
		if (guest.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var g = Ref<WaliStruct_msghdr>.of(guest.result);
		g.msg_namelen = u32.!(h.msg_namelen);
		g.msg_controllen = u32.!(h.msg_controllen);
		g.msg_flags = h.msg_flags;
		return r;
	}
