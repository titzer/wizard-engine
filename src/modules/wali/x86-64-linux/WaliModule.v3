	//========================================================================================
	// Like mmap, the only addresses the guest can name are linear memory offsets, so the
	// mapping is always moved to freshly grown pages at the end of memory and the guest's
	// requested {new_addr} is ignored.
	def mremap(old_addr: int, old_size: int, new_size: int, flags: int, new_addr: int) -> long {
		if (old_size <= 0 || new_size <= 0) return neg(WaliErrno.EINVAL);
		if ((old_addr % HOST_PAGE_SIZE) != 0) return neg(WaliErrno.EINVAL);
		var old = getPtr(old_addr, old_size);
		if (old.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (old.result == Pointer.NULL) return neg(WaliErrno.EINVAL);
		var wasm_pages = (u64.view(new_size) + (WASM_PAGE_SIZE - 1u)) / WASM_PAGE_SIZE;
		var guest_addr = memory.num_bytes;
		if (memory.grow(wasm_pages) == -1) return neg(WaliErrno.ENOMEM);
		var host_addr = memory.getMemBase64() + guest_addr;
		var r = Linux.syscall(LinuxConst.SYS_mremap,
			(old.result, old_size, new_size, MREMAP_MAYMOVE | MREMAP_FIXED, host_addr)).0;
		if (r < 0) return r;
		// Restore ordinary pages over the vacated range to keep linear memory whole.
		Linux.syscall(LinuxConst.SYS_mmap, (old.result, old_size,
			LinuxConst.PROT_READ | LinuxConst.PROT_WRITE,
			LinuxConst.MAP_PRIVATE | LinuxConst.MAP_ANONYMOUS | LinuxConst.MAP_FIXED, -1, 0L));
		return long.view(guest_addr);
	}
	//========================================================================================
	// Resets the range to plain anonymous pages instead of unmapping it, dropping any file
	// backing while keeping every address in linear memory readable. Linear memory has no
	// holes: every offset below its length stays addressable by the guest.
	def munmap(addr: int, len: int) -> long {
		if (len <= 0) return neg(WaliErrno.EINVAL);
		if ((addr % HOST_PAGE_SIZE) != 0) return neg(WaliErrno.EINVAL);
		var p = getPtr(addr, len);
		if (p.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		if (p.result == Pointer.NULL) return neg(WaliErrno.EINVAL);
		var r = Linux.syscall(LinuxConst.SYS_mmap, (p.result, len,
			LinuxConst.PROT_READ | LinuxConst.PROT_WRITE,
			LinuxConst.MAP_PRIVATE | LinuxConst.MAP_ANONYMOUS | LinuxConst.MAP_FIXED, -1, 0L)).0;
		return if(r < 0, r, 0);
	}
