	def epoll_pwait(epfd: int, events: int, maxevents: int, timeout: int, sigmask: int, sigsetsize: int) -> long {
		var sys_epfd = fdmap.get(epfd);
		if (maxevents < 0) return neg(WaliErrno.EINVAL);
		var e = getPtr(events, maxevents * 12);
		if (e.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		var sm = getPtr(sigmask, sigsetsize);
		if (sm.reason != TrapReason.NONE) return neg(WaliErrno.EFAULT);
		return Linux.syscall(LinuxConst.SYS_epoll_pwait, (sys_epfd, e.result, maxevents, timeout, sm.result, sigsetsize)).0;
	}
