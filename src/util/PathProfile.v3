// The Ball-Larus path profile of one function, shared by the path-profile monitor and
// --trace-paths: the number of each acyclic path, and what each edge does to the path register
// {r} and the counts. Section and figure numbers refer to "Efficient Path Profiling" (Ball and
// Larus, MICRO 1996).
class PathProfile(func: FuncDecl) {
	def MAX_PATHS = 1 << 16; // more paths than this are not worth a counter each
	var reason: string;      // why the function is not profiled, or null if it is
	var numPaths: int;       // the paths are numbered 0 .. numPaths - 1
	var selfLoops: Array<ProfBlock>; // blocks that branch to themselves; block i counts at numPaths + i
	var sites: Array<PathSite>; // one per block with outgoing edges, where its probe goes
	var entry: ProfBlock;
	var exit: ProfBlock;
	private def blocks = Vector<ProfBlock>.new();
	private def tree = Vector<ProfEdge>.new(); // the spanning tree's edges

	new() {
		// the CFG builder faults on exception handlers, and a frame that is suspended does not
		// keep its frame variables once compiled code is involved
		for (bi = BytecodeIterator.new().reset(func); bi.more(); bi.next()) {
			match (bi.current()) {
				TRY, TRY_TABLE => {
					reason = "has exception handlers";
					return;
				}
				CONT_NEW, CONT_BIND, SUSPEND, RESUME, RESUME_THROW, RESUME_THROW_REF, SWITCH => {
					reason = "uses stack switching";
					return;
				}
				_ => ;
			}
		}
		def cfg = CfgBuilder.new();
		cfg.newBlock = ProfBlock.new;
		cfg.newEdge = ProfEdge.new;
		def built = cfg.build(func);
		exit = ProfBlock.!(built.1);
		cfg.addReturnEdges(func, built.0, exit);
		cfg.removeEmptyBlocks(built.0, exit);
		// a function that starts with `loop` leaves the first block owning no instruction
		var b = built.0;
		while (b.last_instr_pc < 0 && b.outgoing != null && b.outgoing.tail == null) {
			def e = b.outgoing.head;
			var keep: List<CfgEdge>;
			for (l = e.target.incoming; l != null; l = l.tail) if (l.head != e) keep = List.new(l.head, keep);
			e.target.incoming = keep;
			b = e.target;
		}
		entry = ProfBlock.!(b);
		entry.dfs(addBlock, null, null);

		addDummies(cfg);
		if (!assignVals()) return;
		numPaths = entry.numPaths;
		def chords = kruskals();
		computeIncrements(chords);
		placeActions(chords);
		placeSites();
	}
	private def addBlock(b: CfgBlock) {
		blocks.put(ProfBlock.!(b));
	}
	// (Section 3.2) regenerates the route from its path number: at each vertex, the edge whose
	// range of path sums holds what remains. Blocks print as their start pc; a dummy edge is a
	// piece of a loop and prints as "..".
	def renderPath(k: int, out: TraceBuilder) {
		var v = entry, dummy = false;
		while (v != exit) {
			var pick: ProfEdge;
			for (l = v.outgoing; l != null; l = l.tail) {
				def e = ProfEdge.!(l.head);
				if (!e.isBackedge && e.val <= k && k < e.val + ProfBlock.!(e.target).numPaths) pick = e;
			}
			if (pick == null) return;
			if (!pick.isDummy || v != entry) out.put1(" +%d", v.start);
			if (pick.isDummy) out.puts(" ..");
			dummy = pick.isDummy;
			k -= pick.val;
			v = ProfBlock.!(pick.target);
		}
		if (!dummy) out.put1(" +%d", v.start);
	}

	// (Section 4) a dummy ENTRY->v for each backedge target and a dummy w->EXIT for each source,
	// which stand in for the backedge and make the graph acyclic
	private def addDummies(cfg: CfgBuilder) {
		for (i < blocks.length) {
			def b = blocks[i];
			for (l = b.incoming; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge && e.source != b && b != entry) {
					b.entryDummy = ProfEdge.!(cfg.link(-1, entry, b));
					b.entryDummy.isDummy = true;
					break;
				}
			}
			for (l = b.outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge && e.target != b && b != exit) {
					b.exitDummy = ProfEdge.!(cfg.link(-1, b, exit));
					b.exitDummy.isDummy = true;
					break;
				}
			}
		}
	}
	// (Figure 5) Val(e) for each edge, so that no two paths have the same sum; false if there are
	// too many paths to count
	private def assignVals() -> bool {
		def order = entry.reverseTopo(false);
		for (i < order.length) {
			def v = ProfBlock.!(order[i]);
			if (v == exit) {
				v.numPaths = 1;
				continue;
			}
			for (l = v.outgoing; l != null; l = l.tail) {
				if (l.head.isBackedge) continue;
				// another arm to a target already reached runs the same code, so it is the same path
				def twin = sameTarget(v.outgoing, l);
				if (twin != null) {
					ProfEdge.!(l.head).val = twin.val;
					continue;
				}
				ProfEdge.!(l.head).val = v.numPaths;
				v.numPaths += ProfBlock.!(l.head.target).numPaths;
				if (v.numPaths > MAX_PATHS) {
					reason = "more paths than the counter limit";
					return false;
				}
			}
		}
		if (entry.numPaths == 0) {
			reason = "no acyclic path reaches the exit";
			return false;
		}
		return true;
	}
	// (Section 3.3) a spanning tree by Kruskal's algorithm, seeded with EXIT->ENTRY; returns the
	// chords left over, which are the edges to instrument
	private def kruskals() -> Vector<ProfEdge> {
		def chords = Vector<ProfEdge>.new();
		if (exit != entry) exit.parent = entry;
		tree.put(ProfEdge.new(-1, exit, entry));
		for (i < blocks.length) {
			for (l = blocks[i].outgoing; l != null; l = l.tail) {
				def e = ProfEdge.!(l.head);
				if (e.isBackedge) continue;
				def u = ProfBlock.!(e.source).findSet(), v = ProfBlock.!(e.target).findSet();
				if (u == v) {
					e.isChord = true;
					chords.put(e);
				} else {
					v.parent = u;
					tree.put(e);
				}
			}
		}
		return chords;
	}
	// (Figure 4) Increment(e) for each chord, by a walk of the spanning tree
	private def computeIncrements(chords: Vector<ProfEdge>) {
		walk(0, entry, null, chords);
		for (i < chords.length) chords[i].increment += chords[i].val;
	}
	private def walk(events: int, v: CfgBlock, e: ProfEdge, chords: Vector<ProfEdge>) {
		for (i < tree.length) {
			def f = tree[i];
			if (f != e && v == f.target) walk(dir(e, f) * events + f.val, f.source, f, chords);
		}
		for (i < tree.length) {
			def f = tree[i];
			if (f != e && v == f.source) walk(dir(e, f) * events + f.val, f.target, f, chords);
		}
		for (i < chords.length) {
			def f = chords[i];
			if (v == f.source || v == f.target) f.increment += dir(e, f) * events;
		}
	}
	// 1 if {e} and {f}, which share an endpoint, point the same way along the walk, else -1
	private def dir(e: ProfEdge, f: ProfEdge) -> int {
		if (e == null) return 1;
		return if(e.source == f.target || e.target == f.source, 1, -1);
	}
	// (Figure 8) the register initializations, the count increments, and the register increments,
	// then (Section 4) each backedge, which counts a path and starts the next
	private def placeActions(chords: Vector<ProfEdge>) {
		def fromEntry = Vector<CfgBlock>.new(), fromExit = Vector<CfgBlock>.new();
		fromEntry.put(entry);
		Vectors.drain(fromEntry, 0, fun (v: CfgBlock) {
			for (l = v.outgoing; l != null; l = l.tail) {
				def e = ProfEdge.!(l.head);
				if (e.isBackedge || e.isDummy) continue;
				if (e.isChord) e.action = ProfAction.RSet(e.increment);
				else if (e.target.incoming.tail == null) fromEntry.put(e.target);
				else e.action = ProfAction.RSet(0);
			}
		});
		fromExit.put(exit);
		Vectors.drain(fromExit, 0, fun (w: CfgBlock) {
			for (l = w.incoming; l != null; l = l.tail) {
				def e = ProfEdge.!(l.head);
				if (e.isBackedge || e.isDummy) continue;
				if (e.isChord) {
					if (ProfAction.RSet.?(e.action)) e.action = ProfAction.CountConst(e.increment);
					else e.action = ProfAction.CountRPlus(e.increment);
				} else if (e.source.outgoing.tail == null) {
					fromExit.put(e.source);
				} else {
					e.action = ProfAction.CountRPlus(0);
				}
			}
		});
		for (i < chords.length) {
			def e = chords[i];
			if (!e.isDummy && ProfAction.Nothing.?(e.action)) e.action = ProfAction.RAdd(e.increment);
		}
		def loops = Vector<ProfBlock>.new();
		for (i < blocks.length) {
			for (l = blocks[i].outgoing; l != null; l = l.tail) {
				def e = ProfEdge.!(l.head);
				if (!e.isBackedge) continue;
				if (e.source == e.target) {
					// (Section 4.1) a self-loop repeats a vertex without changing the path, so it
					// counts its trips in a slot of its own, past the path counts
					if (loops.length == 0 || loops[loops.length - 1] != blocks[i]) loops.put(blocks[i]);
					e.action = ProfAction.CountConst(numPaths + loops.length - 1);
					continue;
				}
				def ex = ProfBlock.!(e.source).exitDummy, en = ProfBlock.!(e.target).entryDummy;
				e.action = ProfAction.CountReset(if(ex != null, ex.increment), if(en != null, en.increment));
			}
		}
		selfLoops = loops.extract();
	}
	// An earlier real edge in {outgoing} to the same target as {l}'s, or null; a dummy stands for
	// a different path, so it never has one.
	private def sameTarget(outgoing: List<CfgEdge>, l: List<CfgEdge>) -> ProfEdge {
		if (ProfEdge.!(l.head).isDummy) return null;
		for (k = outgoing; k != l; k = k.tail) {
			def e = ProfEdge.!(k.head);
			if (!e.isBackedge && !e.isDummy && e.target == l.head.target) return e;
		}
		return null;
	}
	// A site for each block with a real outgoing edge, at the block's last instruction, with {r}
	// in a new frame variable so that every activation has its own.
	private def placeSites() {
		def rvar = if(func.frame_var_tags != null, func.frame_var_tags.length);
		def tag = [BpTypeCode.I32.code];
		func.frame_var_tags = if(func.frame_var_tags == null, tag, Arrays.concat(func.frame_var_tags, tag));
		def bi = BytecodeIterator.new().reset(func);
		def placed = Vector<PathSite>.new();
		for (i < blocks.length) {
			def b = blocks[i];
			// dummy edges are linked last, so they are first in {outgoing}
			var real = b.outgoing;
			while (real != null && ProfEdge.!(real.head).isDummy) real = real.tail;
			if (real == null) continue;
			def n = Lists.length(real);
			var kind = PathProbeKind.DIRECT, imm: BrOnCastImm;
			if (n > 1) {
				bi.at(b.last_instr_pc, -1);
				match (bi.current()) {
					BR_TABLE => kind = PathProbeKind.TABLE;
					BR_ON_NULL => kind = PathProbeKind.NULL;
					BR_ON_NON_NULL => kind = PathProbeKind.NONNULL;
					BR_ON_CAST => {
						imm = bi.immptr().read_BrOnCastImm();
						kind = PathProbeKind.CAST;
					}
					BR_ON_CAST_FAIL => {
						imm = bi.immptr().read_BrOnCastImm();
						kind = PathProbeKind.CAST_FAIL;
					}
					_ => kind = PathProbeKind.IF;
				}
			}
			// each position in {outgoing} is an arm, and {outgoing} is in reverse label order
			def edges = Array<ProfEdge>.new(n);
			def table = kind == PathProbeKind.TABLE;
			var pos = 0;
			for (l = real; l != null; l = l.tail) {
				edges[if(table, n - 1 - pos, pos)] = ProfEdge.!(l.head);
				pos++;
			}
			placed.put(PathSite.new(b.last_instr_pc, rvar, kind, imm, edges));
		}
		sites = placed.extract();
	}
}

// How the probe's decision selects its arm, so the compiler can emit the selection inline.
enum PathProbeKind { DIRECT, IF, TABLE, NULL, NONNULL, CAST, CAST_FAIL }

// A block's decision at {pc}, its last instruction: {edges} is indexed by the arm it takes, and
// {r}, the path sum so far, lives in the frame variable {rvar}.
class PathSite(pc: int, rvar: int, kind: PathProbeKind, imm: BrOnCastImm, edges: Array<ProfEdge>) {
	// whether any arm changes {r} or the counts
	def acts() -> bool {
		for (e in edges) if (!ProfAction.Nothing.?(e.action)) return true;
		return false;
	}
	// The arm the decision is about to take, read from its operand before it executes.
	def selectArm(accessor: FrameAccessor) -> int {
		if (kind == PathProbeKind.DIRECT) return 0; // one outgoing edge, so there is no operand
		def v = accessor.getOperand(0);
		match (kind) {
			TABLE => {
				def u = Values.unbox_u(v);
				return if(u >= u32.!(edges.length), edges.length - 1, int.!(u));
			}
			NULL => return if(Values.isNull(v), 1, 0);
			NONNULL => return if(Values.isNull(v), 0, 1);
			CAST => return if(Runtime.cast(accessor.func().instance, imm.null2(), imm.ht2, v), 1, 0);
			CAST_FAIL => return if(Runtime.cast(accessor.func().instance, imm.null2(), imm.ht2, v), 0, 1);
			_ => return if(Values.unbox_u(v) != 0, 1, 0);
		}
	}
	// Applies the action of {arm} to {r}; returns the path it completes, or -1 if none.
	def apply(accessor: FrameAccessor, arm: int) -> int {
		match (edges[arm].action) {
			Nothing => ;
			RSet(value) => setR(accessor, value);
			RAdd(value) => setR(accessor, getR(accessor) + value);
			CountConst(value) => return value;
			CountRPlus(value) => return getR(accessor) + value;
			CountReset(add, set) => {
				def path = getR(accessor) + add;
				setR(accessor, set);
				return path;
			}
		}
		return -1;
	}
	private def getR(accessor: FrameAccessor) -> int {
		return Values.unbox_i(accessor.getFrameVar(rvar));
	}
	private def setR(accessor: FrameAccessor, v: int) {
		accessor.getWriter().setFrameVar(rvar, Values.box_i(v));
	}
}

// What an edge does to the path register {r} and the path counts when it is taken.
type ProfAction {
	case Nothing;
	case RSet(value: int);               // r = value
	case RAdd(value: int);               // r += value
	case CountConst(value: int);         // counts[value]++
	case CountRPlus(value: int);         // counts[r + value]++
	case CountReset(add: int, set: int); // counts[r + add]++; r = set
}

class ProfBlock extends CfgBlock {
	var numPaths: int;        // NumPaths(v): paths from here to EXIT
	var entryDummy: ProfEdge; // ENTRY->this, if this is a backedge target
	var exitDummy: ProfEdge;  // this->EXIT, if this is a backedge source
	var parent: ProfBlock;    // the spanning tree's disjoint-set forest; null at a root

	new(pc: int) super(pc) { }
	def findSet() -> ProfBlock {
		return if(parent == null, this, parent.findSet());
	}
}
class ProfEdge extends CfgEdge {
	var val: int;       // Val(e)
	var increment: int; // Increment(e), for a chord
	var isChord: bool;  // not in the spanning tree
	var isDummy: bool;  // stands in for a backedge; has no instruction
	var action: ProfAction;

	new(pc: int, source: CfgBlock, target: CfgBlock) super(pc, source, target) { }
}
