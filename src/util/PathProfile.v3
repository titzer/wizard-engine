// Computes the Ball-Larus path numbering of one function and the action each edge takes on the
// path register {r} and the counts, for both the path-profile monitor and --trace-paths.
// Section and figure numbers refer to "Efficient Path Profiling" (Ball and Larus, MICRO 1996).
def MAX_PATHS = 1 << 16; // more paths than this are not worth a counter each
class PathProfile(func: FuncDecl) {
	var reason: string;      // why the function is not profiled, or null if it is
	var numPaths: int;       // the paths are numbered 0 .. numPaths - 1
	var selfLoops: Array<PathProfilingBlock>; // blocks that branch to themselves; block i counts at numPaths + i
	var sites: Array<PathSite>; // one per block with outgoing edges, where its probe goes
	var entry: PathProfilingBlock;
	var exit: PathProfilingBlock;
	def blocks = Vector<PathProfilingBlock>.new(); // a copy of the function's CFG, in DFS preorder
	private def tree = Vector<PathProfilingEdge>.new(); // the spanning tree's edges

	new() {
		// the CFG builder faults on exception handlers, and a frame that is suspended does not
		// keep its frame variables once compiled code is involved
		for (bi = BytecodeIterator.new().reset(func); bi.more(); bi.next()) {
			match (bi.current()) {
				TRY, TRY_TABLE => {
					reason = "has exception handlers";
					return;
				}
				CONT_NEW, CONT_BIND, SUSPEND, RESUME, RESUME_THROW, RESUME_THROW_REF, SWITCH => {
					reason = "uses stack switching";
					return;
				}
				_ => ;
			}
		}
		// the function's final `end` is its last byte; the block that owns it is EXIT
		def last = func.cur_bytecode.length - 1, originals = Vector<CfgBlock>.new();
		entry = copy(reach(CfgBuilder.new().build(func), false).0, last, originals);
		for (i < originals.length) originals[i].mark = 0;
		// a function whose end no path reaches still needs EXIT as a vertex
		if (exit == null) {
			exit = PathProfilingBlock.new(-1, last, last + 1, last);
			blocks.put(exit);
		}
		addReturnEdges();

		addDummies();
		if (!assignVals()) return;
		numPaths = entry.numPaths;
		def chords = kruskals();
		computeIncrements(chords);
		placeActions(chords);
		placeSites();
	}
	// Copies {b} and every block it reaches, recording each copy's index in the original's {mark}
	// so that a block is copied once. Edges into empty blocks are followed to the block they reach.
	private def copy(b: CfgBlock, last: int, originals: Vector<CfgBlock>) -> PathProfilingBlock {
		if (b.mark > 0) return blocks[b.mark - 1];
		def n = PathProfilingBlock.new(b.id, b.bind_pos, b.end, b.last_instr_pc);
		blocks.put(n);
		originals.put(b);
		b.mark = blocks.length;
		if (b.bind_pos == last) exit = n;
		// link prepends, so linking the edges in reverse keeps {outgoing}'s order, which gives the arms
		var rev: List<CfgEdge>;
		for (l = b.outgoing; l != null; l = l.tail) rev = List.new(l.head, rev);
		for (l = rev; l != null; l = l.tail) {
			def t = reach(l.head.target, l.head.isBackedge);
			link(l.head.pc, n, copy(t.0, last, originals)).isBackedge = t.1;
		}
		return n;
	}
	// Follows {b} through empty blocks, which own no instruction and only pass control on, to the
	// block it reaches, and whether a backedge was crossed on the way.
	private def reach(b: CfgBlock, back: bool) -> (CfgBlock, bool) {
		while (b.last_instr_pc < 0 && b.outgoing != null && b.outgoing.tail == null) {
			back = back || b.outgoing.head.isBackedge;
			b = b.outgoing.head.target;
		}
		return (b, back);
	}
	// every path must end at EXIT, so route all `return`s to EXIT
	private def addReturnEdges() {
		def bi = BytecodeIterator.new().reset(func);
		for (i < blocks.length) {
			def b = blocks[i];
			if (b.outgoing != null || b == exit || b.last_instr_pc < 0) continue;
			bi.at(b.last_instr_pc, -1);
			match (bi.current()) {
				RETURN, RETURN_CALL, RETURN_CALL_INDIRECT, RETURN_CALL_REF => link(b.last_instr_pc, b, exit);
				_ => ;
			}
		}
	}
	// prepends, so {outgoing} is in reverse branch-label order
	private def link(pc: int, from: PathProfilingBlock, to: PathProfilingBlock) -> PathProfilingEdge {
		def e = PathProfilingEdge.new(pc, from, to);
		from.outgoing = List.new(e, from.outgoing);
		to.incoming = List.new(e, to.incoming);
		return e;
	}
	// Prints the route of path {k} as the start pc of each block, with ".." where a dummy edge
	// enters or leaves a loop (Section 3.2).
	def renderPath(k: int, out: TraceBuilder) {
		var v = entry, dummy = false;
		while (v != exit) {
			var pick: PathProfilingEdge;
			for (l = v.outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (!e.isBackedge && e.val <= k && k < e.val + e.target.numPaths) pick = e;
			}
			if (pick == null) return;
			if (!pick.isDummy || v != entry) out.put1(" +%d", v.bind_pos);
			if (pick.isDummy) out.puts(" ..");
			dummy = pick.isDummy;
			k -= pick.val;
			v = pick.target;
		}
		if (!dummy) out.put1(" +%d", v.bind_pos);
	}

	// Adds a dummy ENTRY->v for each backedge target and a dummy w->EXIT for each backedge
	// source, which stand in for the backedges and make the graph acyclic (Section 4).
	private def addDummies() {
		for (i < blocks.length) {
			def b = blocks[i];
			for (l = b.incoming; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge && e.source != b && b != entry) {
					b.entryDummy = link(-1, entry, b);
					b.entryDummy.isDummy = true;
					break;
				}
			}
			for (l = b.outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge && e.target != b && b != exit) {
					b.exitDummy = link(-1, b, exit);
					b.exitDummy.isDummy = true;
					break;
				}
			}
		}
	}
	// Assigns each edge its Val(e) so that every path has a different sum (Figure 5); returns
	// false, with a {reason}, if the function can't be profiled.
	private def assignVals() -> bool {
		def order = Vector<PathProfilingBlock>.new();
		postorder(entry, order);
		for (i < order.length) order[i].mark = 0;
		for (i < order.length) {
			def v = order[i];
			if (v == exit) {
				v.numPaths = 1;
				continue;
			}
			for (l = v.outgoing; l != null; l = l.tail) {
				if (l.head.isBackedge) continue;
				// another arm to a target already reached runs the same code, so it is the same path
				def twin = sameTarget(v.outgoing, l);
				if (twin != null) {
					l.head.val = twin.val;
					continue;
				}
				l.head.val = v.numPaths;
				v.numPaths += l.head.target.numPaths;
				if (v.numPaths > MAX_PATHS) {
					reason = "more paths than the counter limit";
					return false;
				}
			}
		}
		if (entry.numPaths == 0) {
			reason = "no acyclic path reaches the exit";
			return false;
		}
		return true;
	}
	// Reverse topological order of the graph without its backedges. A walk that followed them
	// could reach a loop header from inside the loop and finish it before the blocks ahead of it.
	private def postorder(v: PathProfilingBlock, order: Vector<PathProfilingBlock>) {
		if (v.mark != 0) return;
		v.mark = 1;
		for (l = v.outgoing; l != null; l = l.tail) {
			if (!l.head.isBackedge) postorder(l.head.target, order);
		}
		order.put(v);
	}
	// Builds a spanning tree by Kruskal's algorithm, seeded with EXIT->ENTRY, and returns the
	// chords, the edges left out of it (Section 3.3).
	private def kruskals() -> Vector<PathProfilingEdge> {
		def chords = Vector<PathProfilingEdge>.new();
		if (exit != entry) exit.parent = entry;
		tree.put(PathProfilingEdge.new(-1, exit, entry));
		for (i < blocks.length) {
			for (l = blocks[i].outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge) continue;
				def u = e.source.findSet(), v = e.target.findSet();
				if (u == v) {
					e.isChord = true;
					chords.put(e);
				} else {
					v.parent = u;
					tree.put(e);
				}
			}
		}
		return chords;
	}
	// Computes Increment(e) for each chord by walking the spanning tree (Figure 4).
	private def computeIncrements(chords: Vector<PathProfilingEdge>) {
		walk(0, entry, null, chords);
		for (i < chords.length) chords[i].increment += chords[i].val;
	}
	// Walks the spanning tree from {v}, reached along {e} with {events}, adding Dir(e, f) * events
	// to the increment of each chord f at {v}.
	private def walk(events: int, v: PathProfilingBlock, e: PathProfilingEdge, chords: Vector<PathProfilingEdge>) {
		for (i < tree.length) {
			def f = tree[i];
			if (f != e && v == f.target) walk(dir(e, f) * events + f.val, f.source, f, chords);
		}
		for (i < tree.length) {
			def f = tree[i];
			if (f != e && v == f.source) walk(dir(e, f) * events + f.val, f.target, f, chords);
		}
		for (i < chords.length) {
			def f = chords[i];
			if (v == f.source || v == f.target) f.increment += dir(e, f) * events;
		}
	}
	// Returns 1 if {e} and {f}, which share an endpoint, point the same way along the walk, else -1.
	private def dir(e: PathProfilingEdge, f: PathProfilingEdge) -> int {
		if (e == null) return 1;
		return if(e.source == f.target || e.target == f.source, 1, -1);
	}
	// Sets each edge's action: the register initializations, count increments and register
	// increments (Figure 8), then each backedge's count and restart or self-loop count (Section 4).
	private def placeActions(chords: Vector<PathProfilingEdge>) {
		def fromEntry = Vector<PathProfilingBlock>.new(), fromExit = Vector<PathProfilingBlock>.new();
		fromEntry.put(entry);
		Vectors.drain(fromEntry, 0, fun (v: PathProfilingBlock) {
			for (l = v.outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge || e.isDummy) continue;
				if (e.isChord) e.action = PathProfilingAction.RSet(e.increment);
				else if (e.target.incoming.tail == null) fromEntry.put(e.target);
				else e.action = PathProfilingAction.RSet(0);
			}
		});
		fromExit.put(exit);
		Vectors.drain(fromExit, 0, fun (w: PathProfilingBlock) {
			for (l = w.incoming; l != null; l = l.tail) {
				def e = l.head;
				if (e.isBackedge || e.isDummy) continue;
				if (e.isChord) {
					if (PathProfilingAction.RSet.?(e.action)) e.action = PathProfilingAction.CountConst(e.increment);
					else e.action = PathProfilingAction.CountRPlus(e.increment);
				} else if (e.source.outgoing.tail == null) {
					fromExit.put(e.source);
				} else {
					e.action = PathProfilingAction.CountRPlus(0);
				}
			}
		});
		for (i < chords.length) {
			def e = chords[i];
			if (!e.isDummy && PathProfilingAction.Nothing.?(e.action)) e.action = PathProfilingAction.RAdd(e.increment);
		}
		def loops = Vector<PathProfilingBlock>.new();
		for (i < blocks.length) {
			for (l = blocks[i].outgoing; l != null; l = l.tail) {
				def e = l.head;
				if (!e.isBackedge) continue;
				if (e.source == e.target) {
					// (Section 4.1) a self-loop repeats a vertex without changing the path, so it
					// counts its trips in a slot of its own, past the path counts
					if (loops.length == 0 || loops[loops.length - 1] != blocks[i]) loops.put(blocks[i]);
					e.action = PathProfilingAction.CountConst(numPaths + loops.length - 1);
					continue;
				}
				def ex = e.source.exitDummy, en = e.target.entryDummy;
				e.action = PathProfilingAction.CountReset(if(ex != null, ex.increment), if(en != null, en.increment));
			}
		}
		selfLoops = loops.extract();
	}
	// Returns an earlier real edge in {outgoing} with the same target as {l}'s, or null; a dummy
	// stands for a different path, so it never has one.
	private def sameTarget(outgoing: List<PathProfilingEdge>, l: List<PathProfilingEdge>) -> PathProfilingEdge {
		if (l.head.isDummy) return null;
		for (k = outgoing; k != l; k = k.tail) {
			def e = k.head;
			if (!e.isBackedge && !e.isDummy && e.target == l.head.target) return e;
		}
		return null;
	}
	// Adds a frame variable for {r} and builds a {PathSite} for each block with a real outgoing edge.
	private def placeSites() {
		def rvar = if(func.frame_var_tags != null, func.frame_var_tags.length);
		def tag = [BpTypeCode.I32.code];
		func.frame_var_tags = if(func.frame_var_tags == null, tag, Arrays.concat(func.frame_var_tags, tag));
		def bi = BytecodeIterator.new().reset(func);
		def placed = Vector<PathSite>.new();
		for (i < blocks.length) {
			def b = blocks[i];
			// dummy edges are linked last, so they are first in {outgoing}
			var real = b.outgoing;
			while (real != null && real.head.isDummy) real = real.tail;
			if (real == null) continue;
			def n = Lists.length(real);
			var kind = PathProbeKind.DIRECT, imm: BrOnCastImm;
			if (n > 1) {
				bi.at(b.last_instr_pc, -1);
				match (bi.current()) {
					BR_TABLE => kind = PathProbeKind.TABLE;
					BR_ON_NULL => kind = PathProbeKind.NULL;
					BR_ON_NON_NULL => kind = PathProbeKind.NONNULL;
					BR_ON_CAST => {
						imm = bi.immptr().read_BrOnCastImm();
						kind = PathProbeKind.CAST;
					}
					BR_ON_CAST_FAIL => {
						imm = bi.immptr().read_BrOnCastImm();
						kind = PathProbeKind.CAST_FAIL;
					}
					_ => kind = PathProbeKind.IF;
				}
			}
			// each position in {outgoing} is an arm, and {outgoing} is in reverse label order
			def edges = Array<PathProfilingEdge>.new(n);
			def table = kind == PathProbeKind.TABLE;
			var pos = 0;
			for (l = real; l != null; l = l.tail) {
				edges[if(table, n - 1 - pos, pos)] = l.head;
				pos++;
			}
			placed.put(PathSite.new(b.last_instr_pc, rvar, kind, imm, edges));
		}
		sites = placed.extract();
	}
}

// How a site's branch selects its arm, which the probe and the SPC intrinsic both follow.
enum PathProbeKind { DIRECT, IF, TABLE, NULL, NONNULL, CAST, CAST_FAIL }

// Where one block's probe goes: its last instruction {pc}, how that instruction selects an arm,
// and the edge each arm takes; {r} lives in the frame variable {rvar}.
class PathSite(pc: int, rvar: int, kind: PathProbeKind, imm: BrOnCastImm, edges: Array<PathProfilingEdge>) {
	// Returns true if any arm changes {r} or the counts.
	def acts() -> bool {
		for (e in edges) if (!PathProfilingAction.Nothing.?(e.action)) return true;
		return false;
	}
}

// What an edge does to the path register {r} and the path counts when it is taken.
type PathProfilingAction {
	case Nothing;
	case RSet(value: int);               // r = value
	case RAdd(value: int);               // r += value
	case CountConst(value: int);         // counts[value]++
	case CountRPlus(value: int);         // counts[r + value]++
	case CountReset(add: int, set: int); // counts[r + add]++; r = set
}

// A copy of one block of the function's CFG: the original's id and bytecode range [bind_pos ... end).
class PathProfilingBlock(id: int, bind_pos: int, end: int, last_instr_pc: int) {
	var outgoing: List<PathProfilingEdge>;
	var incoming: List<PathProfilingEdge>;
	var mark: int;
	var numPaths: int;                 // NumPaths(v): paths from here to EXIT
	var entryDummy: PathProfilingEdge; // ENTRY->this, if this is a backedge target
	var exitDummy: PathProfilingEdge;  // this->EXIT, if this is a backedge source
	var parent: PathProfilingBlock;    // the spanning tree's disjoint-set forest; null at a root

	def findSet() -> PathProfilingBlock {
		return if(parent == null, this, parent.findSet());
	}
}
class PathProfilingEdge(pc: int, source: PathProfilingBlock, target: PathProfilingBlock) {
	var isBackedge: bool; // branches to an enclosing loop label
	var val: int;       // Val(e)
	var increment: int; // Increment(e), for a chord
	var isChord: bool;  // not in the spanning tree
	var isDummy: bool;  // stands in for a backedge; has no instruction
	var action: PathProfilingAction;
}
