// Builds a control flow graph for a function.
class CfgBuilder {
	private def bi = BytecodeIterator.new();
	private def ctl_stack = ControlStack<CfgBlock>.new();
	private var prev_pc: int = -1; // for recording `last_instr_pc` when ending a block

	new() {
		// FIXME: with no {newBlock}, a reachable `try` merges into a null block and crashes in {link}
		ctl_stack.newLabel = newCfgBlock;
		ctl_stack.splitBlock = splitCfgBlock;
		ctl_stack.mergeBlock = mergeCfgBlock;
		ctl_stack.bindLabel = bindCfgBlock;
		ctl_stack.endBlock = endCfgBlock;
	}

	def build(func: FuncDecl) -> CfgBlock {
		bi.reset(func);
		bi.dispatchLocalDecls(ctl_stack);  // advance bi.pc past locals
		def start = ctl_stack.resetAtPc(bi.pc);
		while (bi.more()) {
			ctl_stack.pc = bi.pc;
			bi.dispatch(ctl_stack);
			prev_pc = bi.pc;
			bi.next();
		}
		return start;
	}
	// prepends, so {outgoing} is in reverse branch-label order
	private def link(pc: int, from: CfgBlock, to: CfgBlock) -> CfgEdge {
		if (verbose) Trace.OUT.put2("add id:%d -> id:%d", from.id, to.id).ln();
		var e = CfgEdge.new(pc, from, to);
		from.outgoing = List.new(e, from.outgoing);
		to.incoming = List.new(e, to.incoming);
		return e;
	}
	private def newCfgBlock(cs: ControlStack<CfgBlock>) -> CfgBlock {
		return if(cs.isUnreachable(), null, CfgBlock.new(cs.pc));
	}
	private def splitCfgBlock(cs: ControlStack<CfgBlock>, from: CfgBlock) -> (CfgBlock, CfgBlock) {
		if (from == null || cs.isUnreachable()) return (null, null);
		var pos = bi.pc;
		var a = CfgBlock.new(pos), b = CfgBlock.new(pos);
		link(pos, from, a);
		link(pos, from, b);

		return (a, b);
	}
	private def mergeCfgBlock(cs: ControlStack<CfgBlock>, from: CfgBlock, to: CfgBlock) -> CfgBlock {
		if (from == null || cs.isUnreachable()) return to;
		var e = link(cs.pc, from, to);
		e.isBackedge = to.bind_pos >= 0 && to.bind_pos < cs.pc;
		return to;
	}
	private def bindCfgBlock(cs: ControlStack<CfgBlock>, pc: int, label: CfgBlock) {
		if (label == null) return;
		if (pc < 0) pc = bi.nextPc();
		label.bind_pos = pc;
		if (verbose) Trace.OUT.put2("bind id:%d @%d", label.id, pc).ln();
	}
	private def endCfgBlock(cs: ControlStack<CfgBlock>, b: CfgBlock, pc: int) {
		if (b == null) return;
		var last: int;
		if (pc < 0) {
			// end of the block is at the pc of the next instruction
			last = bi.pc;
			b.end = bi.nextPc();
		} else {
			// current instruction at pc belongs to new block
			last = prev_pc;
			b.end = pc;
		}
		if (b.end > b.bind_pos) b.last_instr_pc = last;
	}
}

def verbose = false;
var labelId = 100;

class CfgEdge(pc: int, source: CfgBlock, target: CfgBlock) {
	var isBackedge: bool; // branches to an enclosing loop label
}

class CfgBlock(decl_pos: int) {
	def id = labelId++;
	// the bytecode range [bind_pos ... end) this block owns
	var bind_pos: int = -1;
	var end: int = -1;
	var last_instr_pc: int = -1; // last instruction this block owns, or < 0 when it owns none
	var outgoing: List<CfgEdge>;
	var incoming: List<CfgEdge>;
	var mark: int;
}
