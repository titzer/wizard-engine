// Unimplemented WALI syscalls must report -ENOSYS. The Linux syscall ABI signals
// failure with a negative errno: musl's __syscall_ret() reads anything outside
// [-4095, -1] as a successful result.
//
// These four are picked only because they are still stubs; if any is implemented,
// swap in another stub rather than dropping the check.
import component wali {
	def SYS_write(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_ptrace(request: i32, pid: i32, addr: i32, data: i32) -> i64;
	def SYS_shmget(key: i32, size: i32, shmflg: i32) -> i64;
	def SYS_personality(persona: i32) -> i64;
	def SYS_vhangup() -> i64;
}

def STDOUT = 1;
def ENOSYS: i64 = -38;

def main() -> i64 {
	check("ptrace", wali.SYS_ptrace(0, 0, 0, 0) == ENOSYS);
	check("shmget", wali.SYS_shmget(0, 0, 0) == ENOSYS);
	check("personality", wali.SYS_personality(0) == ENOSYS);
	check("vhangup", wali.SYS_vhangup() == ENOSYS);
	return 0;
}

def check(name: string, cond: bool) {
	print(name);
	print(if(cond, ": ok\n", ": FAIL\n"));
}

def print(str: string) {
	wali.SYS_write(STDOUT, Pointer.atContents(str), str.length);
}
