// readv/writev take an array of iovecs. A guest {struct iovec} is 8 bytes (32-bit base
// and length) while the host's is 16, so the array has to be rebuilt and every base
// pointer translated; the array cannot be handed to the kernel as-is.
import component wali {
	def SYS_write(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_read(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_close(fd: i32) -> i64;
	def SYS_pipe2(fds: Pointer, flags: i32) -> i64;
	def SYS_writev(fd: i32, iov: Pointer, iovcnt: i32) -> i64;
	def SYS_readv(fd: i32, iov: Pointer, iovcnt: i32) -> i64;
}

def STDOUT = 1;

def main() -> i64 {
	var fds = Array<int>.new(2);
	check("pipe2", wali.SYS_pipe2(Pointer.atContents(fds), 0) == 0);

	// Two iovecs: "abc" then "de". Each entry is { i32 base; i32 len }.
	var a = "abc", b = "de";
	var iov = Array<int>.new(4);
	iov[0] = ptrOf(a);	iov[1] = a.length;
	iov[2] = ptrOf(b);	iov[3] = b.length;
	check("writev returns 5", wali.SYS_writev(fds[1], Pointer.atContents(iov), 2) == 5);

	// Read it back through two iovecs of 2 and 3 bytes, so the split differs from the
	// one used to write: this only works if each base pointer was translated separately.
	var x = Array<byte>.new(2), y = Array<byte>.new(3);
	var riov = Array<int>.new(4);
	riov[0] = ptrOf2(x);	riov[1] = x.length;
	riov[2] = ptrOf2(y);	riov[3] = y.length;
	check("readv returns 5", wali.SYS_readv(fds[0], Pointer.atContents(riov), 2) == 5);
	check("first iovec got 'ab'", x[0] == 'a' && x[1] == 'b');
	check("second iovec got 'cde'", y[0] == 'c' && y[1] == 'd' && y[2] == 'e');

	check("writev with 0 iovecs", wali.SYS_writev(fds[1], Pointer.atContents(iov), 0) == 0);

	wali.SYS_close(fds[0]);
	wali.SYS_close(fds[1]);
	return 0;
}

def ptrOf(s: string) -> int {
	return int.!(Pointer.atContents(s) - Pointer.NULL);
}

def ptrOf2(a: Array<byte>) -> int {
	return int.!(Pointer.atContents(a) - Pointer.NULL);
}

def check(name: string, cond: bool) {
	print(name);
	print(if(cond, ": ok\n", ": FAIL\n"));
}

def print(str: string) {
	wali.SYS_write(STDOUT, Pointer.atContents(str), str.length);
}
