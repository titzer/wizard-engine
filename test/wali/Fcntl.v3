// Whether fcntl's third argument is a guest pointer or a plain integer depends on the
// command, and F_DUPFD returns a new descriptor that has to be bound into the guest fd
// table rather than handed back as a raw host fd.
import component wali {
	def SYS_write(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_read(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_close(fd: i32) -> i64;
	def SYS_pipe2(fds: Pointer, flags: i32) -> i64;
	def SYS_fcntl(fd: i32, cmd: i32, arg: i64) -> i64;
}

def STDOUT = 1;
def F_DUPFD = 0;
def F_GETFD = 1;
def F_GETFL = 3;
def F_SETFL = 4;
def O_NONBLOCK = 0x800;
def FD_CLOEXEC = 1;
def O_CLOEXEC = 0x80000;

def main() -> i64 {
	var fds = Array<int>.new(2);
	check("pipe2 with O_CLOEXEC", wali.SYS_pipe2(Pointer.atContents(fds), O_CLOEXEC) == 0);
	check("F_GETFD reports FD_CLOEXEC", (wali.SYS_fcntl(fds[0], F_GETFD, 0) & FD_CLOEXEC) != 0);

	// F_SETFL/F_GETFL take a plain integer, not a pointer.
	check("O_NONBLOCK is initially clear", (wali.SYS_fcntl(fds[0], F_GETFL, 0) & O_NONBLOCK) == 0);
	check("F_SETFL O_NONBLOCK", wali.SYS_fcntl(fds[0], F_SETFL, O_NONBLOCK) == 0);
	check("F_GETFL reports O_NONBLOCK", (wali.SYS_fcntl(fds[0], F_GETFL, 0) & O_NONBLOCK) != 0);
	// A non-blocking read of an empty pipe fails rather than hanging, which is the real
	// proof that F_SETFL reached the underlying description.
	var buf = Array<byte>.new(4);
	check("nonblocking read fails", wali.SYS_read(fds[0], Pointer.atContents(buf), 4) < 0);

	// F_DUPFD returns a descriptor; it must be usable from the guest.
	var dup = wali.SYS_fcntl(fds[1], F_DUPFD, 0);
	check("F_DUPFD", dup >= 0);
	check("write through duped fd", wali.SYS_write(i32.view(dup), Pointer.atContents("hi"), 2) == 2);
	check("close duped fd", wali.SYS_close(i32.view(dup)) == 0);

	wali.SYS_close(fds[0]);
	wali.SYS_close(fds[1]);
	return 0;
}

def check(name: string, cond: bool) {
	print(name);
	print(if(cond, ": ok\n", ": FAIL\n"));
}

def print(str: string) {
	wali.SYS_write(STDOUT, Pointer.atContents(str), str.length);
}
