// poll and select are told about fds by number: poll through the fd field of each
// pollfd, select through bit positions in an fd_set. Those are guest fd numbers, so
// both have to be translated into host fds on the way in and the results mapped back.
import component wali {
	def SYS_write(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_close(fd: i32) -> i64;
	def SYS_pipe2(fds: Pointer, flags: i32) -> i64;
	def SYS_poll(fds: Pointer, nfds: i64, timeout: i32) -> i64;
	def SYS_select(nfds: i32, rd: Pointer, wr: Pointer, ex: Pointer, timeout: Pointer) -> i64;
}

def STDOUT = 1;
def POLLIN = 0x1;

def main() -> i64 {
	var fds = Array<int>.new(2);
	check("pipe2", wali.SYS_pipe2(Pointer.atContents(fds), 0) == 0);

	// struct pollfd { int fd; short events; short revents; } -- 8 bytes.
	var pfd = Array<int>.new(2);
	pfd[0] = fds[0];
	pfd[1] = POLLIN; // events in the low half, revents in the high half

	// Nothing written yet, so a zero timeout must report no ready fds.
	check("poll times out while empty", wali.SYS_poll(Pointer.atContents(pfd), 1, 0) == 0);

	check("write", wali.SYS_write(fds[1], Pointer.atContents("x"), 1) == 1);
	pfd[1] = POLLIN;
	check("poll reports 1 ready", wali.SYS_poll(Pointer.atContents(pfd), 1, 1000) == 1);
	check("poll set POLLIN in revents", ((pfd[1] >> 16) & POLLIN) != 0);

	// fd_set is a 1024-bit bitmap indexed by fd number; struct timeval is 2 i64s.
	var rd = Array<int>.new(32);
	rd[fds[0] >> 5] = 1 << u5.view(fds[0]);
	var tv = Array<i64>.new(2);
	tv[0] = 1;
	var r = wali.SYS_select(fds[0] + 1, Pointer.atContents(rd), Pointer.NULL, Pointer.NULL, Pointer.atContents(tv));
	check("select reports 1 ready", r == 1);
	check("select left the guest fd bit set", (rd[fds[0] >> 5] & (1 << u5.view(fds[0]))) != 0);

	wali.SYS_close(fds[0]);
	wali.SYS_close(fds[1]);
	return 0;
}

def check(name: string, cond: bool) {
	print(name);
	print(if(cond, ": ok\n", ": FAIL\n"));
}

def print(str: string) {
	wali.SYS_write(STDOUT, Pointer.atContents(str), str.length);
}
