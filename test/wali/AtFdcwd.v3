// AT_FDCWD is a sentinel the *at() syscalls accept in place of a directory fd. It is not
// a guest fd, so it must reach the kernel unchanged; mapping it through the fd table
// turns it into -1 and breaks every relative path.
import component wali {
	def SYS_write(fd: i32, buf: Pointer, count: i32) -> i64;
	def SYS_close(fd: i32) -> i64;
	def SYS_openat(dirfd: i32, path: Pointer, flags: i32, mode: i32) -> i64;
	def SYS_faccessat(dirfd: i32, path: Pointer, mode: i32, flags: i32) -> i64;
	def SYS_read(fd: i32, buf: Pointer, count: i32) -> i64;
}

def STDOUT = 1;
def AT_FDCWD = -100;
def O_RDONLY = 0;
def F_OK = 0;

def main() -> i64 {
	// A relative path is only resolvable if AT_FDCWD survived translation.
	var rel = "lorem-ipsum.txt\x00";
	check("faccessat(AT_FDCWD, relative)", wali.SYS_faccessat(AT_FDCWD, Pointer.atContents(rel), F_OK, 0) == 0);

	var fd = wali.SYS_openat(AT_FDCWD, Pointer.atContents(rel), O_RDONLY, 0);
	check("openat(AT_FDCWD, relative)", fd >= 0);

	var buf = Array<byte>.new(5);
	check("read", wali.SYS_read(i32.view(fd), Pointer.atContents(buf), 5) == 5);
	check("contents", buf[0] == 'L' && buf[4] == 'm');
	wali.SYS_close(i32.view(fd));

	var missing = "no-such-file\x00";
	check("faccessat on a missing file fails", wali.SYS_faccessat(AT_FDCWD, Pointer.atContents(missing), F_OK, 0) < 0);
	return 0;
}

def check(name: string, cond: bool) {
	print(name);
	print(if(cond, ": ok\n", ": FAIL\n"));
}

def print(str: string) {
	wali.SYS_write(STDOUT, Pointer.atContents(str), str.length);
}
