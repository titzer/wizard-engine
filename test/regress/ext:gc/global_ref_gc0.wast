;; Objects reachable only from reference-typed globals survive allocation churn (and any garbage
;; collections it causes), and globals holding i31 values are not mistaken for pointers.
(module
  (type $s (struct (field i32) (field (ref null $s))))
  (type $big (array (mut i64)))
  (global $anyref (mut anyref) (ref.null any))
  (global $eqref (mut eqref) (ref.null eq))
  (global $structref (mut structref) (ref.null struct))
  (global $arrayref (mut arrayref) (ref.null array))
  (global $externref (mut externref) (ref.null extern))
  (global $chain (mut (ref null $s)) (ref.null $s))
  (global $i31_any (mut anyref) (ref.null any))

  (func $churn (param $n i32)
    (loop $l
      (drop (array.new $big (i64.const -1) (i32.const 1000)))
      (br_if $l (local.tee $n (i32.sub (local.get $n) (i32.const 1))))))
  ;; Builds a linked list of {n} structs with values n-1..0.
  (func $list (param $n i32) (result (ref null $s))
    (local $l (ref null $s)) (local $i i32)
    (loop $lp
      (local.set $l (struct.new $s (local.get $i) (local.get $l)))
      (br_if $lp (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
    (local.get $l))
  (func $sum (param $l (ref null $s)) (result i32)
    (local $t i32)
    (block $done (loop $lp
      (br_if $done (ref.is_null (local.get $l)))
      (local.set $t (i32.add (local.get $t) (struct.get $s 0 (local.get $l))))
      (local.set $l (struct.get $s 1 (local.get $l)))
      (br $lp)))
    (local.get $t))

  (func (export "init")
    (global.set $anyref (struct.new $s (i32.const 1) (ref.null $s)))
    (global.set $eqref (ref.i31 (i32.const 0x2bcdef01)))
    (global.set $structref (struct.new $s (i32.const 3) (ref.null $s)))
    (global.set $arrayref (array.new $big (i64.const 0x123456789) (i32.const 4)))
    (global.set $externref (extern.convert_any (struct.new $s (i32.const 5) (ref.null $s))))
    (global.set $chain (call $list (i32.const 100)))
    (global.set $i31_any (ref.i31 (i32.const 1))))
  (func (export "churn") (param i32) (call $churn (local.get 0)))
  (func (export "check") (result i32)
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (global.get $anyref))) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.ne (i31.get_u (ref.cast (ref i31) (global.get $eqref))) (i32.const 0x2bcdef01)) (then (return (i32.const 2))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (global.get $structref))) (i32.const 3)) (then (return (i32.const 3))))
    (if (i64.ne (array.get $big (ref.cast (ref $big) (global.get $arrayref)) (i32.const 3)) (i64.const 0x123456789)) (then (return (i32.const 4))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (any.convert_extern (global.get $externref)))) (i32.const 5)) (then (return (i32.const 5))))
    (if (i32.ne (call $sum (global.get $chain)) (i32.const 4950)) (then (return (i32.const 6))))
    (if (i32.ne (i31.get_u (ref.cast (ref i31) (global.get $i31_any))) (i32.const 1)) (then (return (i32.const 7))))
    (i32.const 0))
  ;; Swaps the i31 and object values of {$anyref} and {$i31_any}, so that each global holds both kinds.
  (func (export "swap")
    (local $t anyref)
    (local.set $t (global.get $anyref))
    (global.set $anyref (global.get $i31_any))
    (global.set $i31_any (local.get $t)))
  (func (export "check_swapped") (result i32)
    (if (i32.ne (i31.get_u (ref.cast (ref i31) (global.get $anyref))) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (global.get $i31_any))) (i32.const 1)) (then (return (i32.const 2))))
    (i32.const 0))
)

(invoke "init")
(assert_return (invoke "check") (i32.const 0))
(invoke "churn" (i32.const 3000))
(assert_return (invoke "check") (i32.const 0))
(invoke "swap")
(invoke "churn" (i32.const 3000))
(assert_return (invoke "check_swapped") (i32.const 0))
(invoke "swap")
(invoke "churn" (i32.const 3000))
(assert_return (invoke "check") (i32.const 0))
