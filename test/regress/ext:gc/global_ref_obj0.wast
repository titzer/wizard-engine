;; Reference-typed globals holding GC objects: identity, aliasing, and non-null types.
(module
  (type $s (struct (field (mut i32))))
  (type $t (sub (struct (field (mut i32)))))
  (type $u (sub $t (struct (field (mut i32)) (field i64))))
  (type $a (array (mut i32)))
  (global $structref (mut structref) (ref.null struct))
  (global $arrayref (mut arrayref) (ref.null array))
  (global $eqref (mut eqref) (ref.null eq))
  (global $anyref (mut anyref) (ref.null any))
  (global $s1 (mut (ref $s)) (struct.new $s (i32.const 100)))
  (global $s2 (mut (ref null $s)) (ref.null $s))
  (global $a1 (mut (ref $a)) (array.new $a (i32.const 3) (i32.const 5)))
  (global $t (mut (ref null $t)) (struct.new $u (i32.const 200) (i64.const 300)))
  (global $imm_s (ref $s) (struct.new $s (i32.const 400)))
  (global $imm_alias (ref $s) (global.get $imm_s))

  (func (export "s1_get") (result i32) (struct.get $s 0 (global.get $s1)))
  (func (export "s1_set") (param i32) (struct.set $s 0 (global.get $s1) (local.get 0)))
  (func (export "new_s1") (param i32) (global.set $s1 (struct.new $s (local.get 0))))
  ;; Aliases {$s1} in all the other globals that can hold it.
  (func (export "alias_s1")
    (global.set $s2 (global.get $s1))
    (global.set $structref (global.get $s1))
    (global.set $eqref (global.get $s1))
    (global.set $anyref (global.get $s1)))
  (func (export "all_alias_s1") (result i32)
    (i32.and (i32.and (ref.eq (global.get $s1) (global.get $s2)) (ref.eq (global.get $s1) (global.get $structref)))
      (i32.and (ref.eq (global.get $s1) (global.get $eqref)) (ref.eq (global.get $s1) (ref.cast eqref (global.get $anyref))))))
  (func (export "s2_get") (result i32) (struct.get $s 0 (global.get $s2)))
  (func (export "structref_get") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get $structref))))
  (func (export "anyref_get") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get $anyref))))

  (func (export "a1_len") (result i32) (array.len (global.get $a1)))
  (func (export "a1_get") (param i32) (result i32) (array.get $a (global.get $a1) (local.get 0)))
  (func (export "a1_set") (param i32 i32) (array.set $a (global.get $a1) (local.get 0) (local.get 1)))
  (func (export "arrayref_from_a1") (global.set $arrayref (global.get $a1)))
  (func (export "arrayref_len") (result i32) (array.len (ref.as_non_null (global.get $arrayref))))
  (func (export "arrayref_is_a1") (result i32) (ref.eq (global.get $arrayref) (global.get $a1)))
  (func (export "new_a1") (param i32) (global.set $a1 (array.new $a (local.get 0) (i32.const 9))))

  ;; A global of a supertype holding a subtype.
  (func (export "t_get") (result i32) (struct.get $t 0 (global.get $t)))
  (func (export "t_is_u") (result i32) (ref.test (ref $u) (global.get $t)))
  (func (export "t_u_field") (result i64) (struct.get $u 1 (ref.cast (ref $u) (global.get $t))))
  (func (export "t_set_t") (param i32) (global.set $t (struct.new $t (local.get 0))))

  (func (export "imm_alias_same") (result i32) (ref.eq (global.get $imm_s) (global.get $imm_alias)))
  (func (export "imm_get") (result i32) (struct.get $s 0 (global.get $imm_alias)))
)

(assert_return (invoke "s1_get") (i32.const 100))
(invoke "alias_s1")
(assert_return (invoke "all_alias_s1") (i32.const 1))
(invoke "s1_set" (i32.const 101))
(assert_return (invoke "s2_get") (i32.const 101))
(assert_return (invoke "structref_get") (i32.const 101))
(assert_return (invoke "anyref_get") (i32.const 101))
(invoke "new_s1" (i32.const 102))
(assert_return (invoke "all_alias_s1") (i32.const 0))
(assert_return (invoke "s1_get") (i32.const 102))
(assert_return (invoke "s2_get") (i32.const 101))
(invoke "alias_s1")
(assert_return (invoke "all_alias_s1") (i32.const 1))
(assert_return (invoke "anyref_get") (i32.const 102))

(assert_return (invoke "a1_len") (i32.const 5))
(assert_return (invoke "a1_get" (i32.const 4)) (i32.const 3))
(invoke "a1_set" (i32.const 2) (i32.const 77))
(invoke "arrayref_from_a1")
(assert_return (invoke "arrayref_is_a1") (i32.const 1))
(assert_return (invoke "arrayref_len") (i32.const 5))
(invoke "new_a1" (i32.const 8))
(assert_return (invoke "arrayref_is_a1") (i32.const 0))
(assert_return (invoke "a1_len") (i32.const 9))
(assert_return (invoke "a1_get" (i32.const 8)) (i32.const 8))
(assert_return (invoke "arrayref_len") (i32.const 5))

(assert_return (invoke "t_get") (i32.const 200))
(assert_return (invoke "t_is_u") (i32.const 1))
(assert_return (invoke "t_u_field") (i64.const 300))
(invoke "t_set_t" (i32.const 201))
(assert_return (invoke "t_is_u") (i32.const 0))
(assert_return (invoke "t_get") (i32.const 201))

(assert_return (invoke "imm_alias_same") (i32.const 1))
(assert_return (invoke "imm_get") (i32.const 400))
