;; Exercises inline (JIT) allocation with many collections: allocates many objects of each kind,
;; keeping some live in a list, and checks all their contents afterwards.
(module
  (type $vals (array (mut anyref)))
  (type $bytes (array (mut i8)))
  (type $longs (array (mut i64)))
  (type $node (struct (field i32) (field (ref null $node)) (field anyref) (field i64) (field f64)
                      (field i8) (field v128) (field (ref null $bytes)) (field (ref null $longs))))
  (type $empty (struct))

  ;; Allocates {n} nodes, keeping every {k}th one in a list, and returns a checksum of the list.
  (func (export "run") (param $n i32) (param $k i32) (result i64)
    (local $i i32) (local $list (ref null $node)) (local $x (ref null $node)) (local $sum i64)
    (local $vs (ref null $vals)) (local $bs (ref null $bytes)) (local $ls (ref null $longs))
    (loop $l
      (local.set $bs (array.new_default $bytes (i32.and (local.get $i) (i32.const 15))))
      (if (i32.gt_u (array.len (local.get $bs)) (i32.const 0))
        (then (array.set $bytes (local.get $bs) (i32.const 0) (local.get $i))))
      (local.set $ls (array.new_fixed $longs 2 (i64.extend_i32_u (local.get $i)) (i64.const -1)))
      (local.set $vs (array.new_fixed $vals 3
        (ref.i31 (local.get $i))
        (struct.new_default $empty)
        (local.get $list)))
      (local.set $x (struct.new $node
        (local.get $i)
        (local.get $list)
        (local.get $vs)
        (i64.mul (i64.extend_i32_u (local.get $i)) (i64.const 0x100000001))
        (f64.convert_i32_u (local.get $i))
        (local.get $i)
        (i64x2.splat (i64.extend_i32_u (local.get $i)))
        (local.get $bs)
        (local.get $ls)))
      (if (i32.eqz (i32.rem_u (local.get $i) (local.get $k)))
        (then (local.set $list (local.get $x))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    ;; Walk the list and check each node against its index.
    (local.set $x (local.get $list))
    (block $done
      (loop $w
        (br_if $done (ref.is_null (local.get $x)))
        (local.set $i (struct.get $node 0 (local.get $x)))
        (if (i64.ne (struct.get $node 3 (local.get $x)) (i64.mul (i64.extend_i32_u (local.get $i)) (i64.const 0x100000001)))
          (then (return (i64.const -3))))
        (if (f64.ne (struct.get $node 4 (local.get $x)) (f64.convert_i32_u (local.get $i)))
          (then (return (i64.const -4))))
        (if (i32.ne (struct.get_u $node 5 (local.get $x)) (i32.and (local.get $i) (i32.const 255)))
          (then (return (i64.const -5))))
        (if (i64.ne (i64x2.extract_lane 1 (struct.get $node 6 (local.get $x))) (i64.extend_i32_u (local.get $i)))
          (then (return (i64.const -6))))
        (local.set $vs (ref.cast (ref $vals) (struct.get $node 2 (local.get $x))))
        (if (i32.ne (i31.get_u (ref.cast (ref i31) (array.get $vals (local.get $vs) (i32.const 0)))) (local.get $i))
          (then (return (i64.const -7))))
        (if (i32.eqz (ref.test (ref $empty) (array.get $vals (local.get $vs) (i32.const 1))))
          (then (return (i64.const -8))))
        (if (i32.eqz (ref.eq (ref.cast eqref (array.get $vals (local.get $vs) (i32.const 2))) (struct.get $node 1 (local.get $x))))
          (then (return (i64.const -9))))
        (local.set $bs (struct.get $node 7 (local.get $x)))
        (if (i32.ne (array.len (local.get $bs)) (i32.and (local.get $i) (i32.const 15)))
          (then (return (i64.const -10))))
        (if (i32.gt_u (array.len (local.get $bs)) (i32.const 0))
          (then (if (i32.ne (array.get_u $bytes (local.get $bs) (i32.const 0)) (i32.and (local.get $i) (i32.const 255)))
            (then (return (i64.const -11))))))
        (local.set $ls (struct.get $node 8 (local.get $x)))
        (if (i64.ne (array.get $longs (local.get $ls) (i32.const 1)) (i64.const -1))
          (then (return (i64.const -12))))
        (local.set $sum (i64.add (local.get $sum) (array.get $longs (local.get $ls) (i32.const 0))))
        (local.set $x (struct.get $node 1 (local.get $x)))
        (br $w)))
    (local.get $sum))

  (func (export "too_long") (param i32) (result i32)
    (array.len (array.new_default $bytes (local.get 0))))
)

(assert_return (invoke "run" (i32.const 10) (i32.const 1)) (i64.const 45))
(assert_return (invoke "run" (i32.const 2000) (i32.const 7)) (i64.const 285285))
(assert_return (invoke "too_long" (i32.const 3)) (i32.const 3))
