;; ref.test and ref.cast are only valid if the target type is in the same type hierarchy as the
;; operand (any, func, extern, or exn); a test or cast across hierarchies is invalid (#654).
(assert_invalid (module (func (result i32) (ref.test (ref extern) (ref.i31 (i32.const 5)))))
  "type mismatch")
(assert_invalid (module (type $s (struct)) (func (result i32) (ref.test (ref func) (struct.new $s))))
  "type mismatch")
(assert_invalid (module (func (result i32) (drop (ref.cast (ref extern) (ref.i31 (i32.const 5)))) (i32.const 7)))
  "type mismatch")
(assert_invalid (module (type $s (struct)) (func (drop (ref.cast (ref func) (struct.new $s)))))
  "type mismatch")
(assert_invalid (module (func (result i32) (ref.is_null (ref.cast (ref null i31) (ref.null func)))))
  "type mismatch")
;; Every other pair of hierarchies, in both directions, with nullable and non-null targets.
(assert_invalid (module (func (param externref) (result i32) (ref.test anyref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param externref) (result i32) (ref.test funcref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param funcref) (result i32) (ref.test anyref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param funcref) (result i32) (ref.test (ref noextern) (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param anyref) (result i32) (ref.test nullfuncref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param anyref) (result i32) (ref.test exnref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param exnref) (result i32) (ref.test anyref (local.get 0)))) "type mismatch")
(assert_invalid (module (type $f (func)) (func (param anyref) (result (ref $f)) (ref.cast (ref $f) (local.get 0)))) "type mismatch")
(assert_invalid (module (type $a (array i8)) (func (param funcref) (result (ref null $a)) (ref.cast (ref null $a) (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param externref) (result nullref) (ref.cast nullref (local.get 0)))) "type mismatch")
(assert_invalid (module (func (param nullexternref) (result eqref) (ref.cast eqref (local.get 0)))) "type mismatch")

;; Tests and casts within a hierarchy are valid, including to and from bottom types.
(module
  (type $s (struct))
  (type $a (array i8))
  (type $f (func))
  (func $g (type $f))
  (elem declare func $g)
  (func (export "i31_is_i31") (result i32) (ref.test (ref i31) (ref.i31 (i32.const 5))))
  (func (export "i31_is_struct") (result i32) (ref.test (ref $s) (ref.i31 (i32.const 5))))
  (func (export "any_is_none") (param anyref) (result i32) (ref.test nullref (local.get 0)))
  (func (export "eq_to_i31") (result i32) (i31.get_u (ref.cast (ref i31) (ref.cast eqref (ref.i31 (i32.const 9))))))
  (func (export "struct_is_array") (result i32) (ref.test (ref $a) (struct.new $s)))
  (func (export "func_is_f") (result i32) (ref.test (ref $f) (ref.func $g)))
  (func (export "func_is_nofunc") (param funcref) (result i32) (ref.test nullfuncref (local.get 0)))
  (func (export "extern_is_extern") (param externref) (result i32) (ref.test (ref extern) (local.get 0)))
  (func (export "extern_is_noextern") (param externref) (result i32) (ref.test nullexternref (local.get 0)))
  (func (export "noextern_to_extern") (result i32) (ref.is_null (ref.cast externref (ref.null noextern))))
  (func (export "exn_is_exn") (param exnref) (result i32) (ref.test exnref (local.get 0)))
)
(assert_return (invoke "i31_is_i31") (i32.const 1))
(assert_return (invoke "i31_is_struct") (i32.const 0))
(assert_return (invoke "any_is_none" (ref.null any)) (i32.const 1))
(assert_return (invoke "eq_to_i31") (i32.const 9))
(assert_return (invoke "struct_is_array") (i32.const 0))
(assert_return (invoke "func_is_f") (i32.const 1))
(assert_return (invoke "func_is_nofunc" (ref.null func)) (i32.const 1))
(assert_return (invoke "extern_is_extern" (ref.extern 1)) (i32.const 1))
(assert_return (invoke "extern_is_extern" (ref.null extern)) (i32.const 0))
(assert_return (invoke "extern_is_noextern" (ref.extern 1)) (i32.const 0))
(assert_return (invoke "noextern_to_extern") (i32.const 1))
(assert_return (invoke "exn_is_exn" (ref.null exn)) (i32.const 1))
