;; Reference-typed globals of every nullable type: default null values, and setting them to null.
(module
  (type $s (struct (field i32)))
  (type $a (array i32))
  (type $f (func))
  (global $funcref (mut funcref) (ref.null func))
  (global $externref (mut externref) (ref.null extern))
  (global $anyref (mut anyref) (ref.null any))
  (global $eqref (mut eqref) (ref.null eq))
  (global $i31ref (mut i31ref) (ref.null i31))
  (global $structref (mut structref) (ref.null struct))
  (global $arrayref (mut arrayref) (ref.null array))
  (global $nullref (mut nullref) (ref.null none))
  (global $nullfuncref (mut nullfuncref) (ref.null nofunc))
  (global $nullexternref (mut nullexternref) (ref.null noextern))
  (global $s (mut (ref null $s)) (ref.null $s))
  (global $a (mut (ref null $a)) (ref.null $a))
  (global $f (mut (ref null $f)) (ref.null $f))
  (global $imm_anyref anyref (ref.null any))
  (global $imm_s (ref null $s) (ref.null $s))

  (func (export "all_null") (result i32)
    (i32.and (i32.and (i32.and (ref.is_null (global.get $funcref)) (ref.is_null (global.get $externref)))
                      (i32.and (ref.is_null (global.get $anyref)) (ref.is_null (global.get $eqref))))
      (i32.and (i32.and (i32.and (ref.is_null (global.get $i31ref)) (ref.is_null (global.get $structref)))
                        (i32.and (ref.is_null (global.get $arrayref)) (ref.is_null (global.get $nullref))))
        (i32.and (i32.and (i32.and (ref.is_null (global.get $nullfuncref)) (ref.is_null (global.get $nullexternref)))
                          (i32.and (ref.is_null (global.get $s)) (ref.is_null (global.get $a))))
          (i32.and (ref.is_null (global.get $f))
            (i32.and (ref.is_null (global.get $imm_anyref)) (ref.is_null (global.get $imm_s))))))))
  (func (export "set_all_null")
    (global.set $funcref (ref.null func))
    (global.set $externref (ref.null extern))
    (global.set $anyref (ref.null any))
    (global.set $eqref (ref.null eq))
    (global.set $i31ref (ref.null i31))
    (global.set $structref (ref.null struct))
    (global.set $arrayref (ref.null array))
    (global.set $nullref (ref.null none))
    (global.set $nullfuncref (ref.null nofunc))
    (global.set $nullexternref (ref.null noextern))
    (global.set $s (ref.null $s))
    (global.set $a (ref.null $a))
    (global.set $f (ref.null $f)))
  (func $g)
  (elem declare func $g)
  (func (export "set_all_nonnull")
    (global.set $funcref (ref.func $g))
    (global.set $externref (extern.convert_any (ref.i31 (i32.const 1))))
    (global.set $anyref (ref.i31 (i32.const 2)))
    (global.set $eqref (struct.new $s (i32.const 3)))
    (global.set $i31ref (ref.i31 (i32.const 4)))
    (global.set $structref (struct.new $s (i32.const 5)))
    (global.set $arrayref (array.new_fixed $a 0))
    (global.set $s (struct.new $s (i32.const 6)))
    (global.set $a (array.new_fixed $a 1 (i32.const 7)))
    (global.set $f (ref.func $g)))
  (func (export "none_null") (result i32)
    (i32.eqz (i32.or (i32.or (i32.or (ref.is_null (global.get $funcref)) (ref.is_null (global.get $externref)))
                             (i32.or (ref.is_null (global.get $anyref)) (ref.is_null (global.get $eqref))))
      (i32.or (i32.or (i32.or (ref.is_null (global.get $i31ref)) (ref.is_null (global.get $structref)))
                      (i32.or (ref.is_null (global.get $arrayref)) (ref.is_null (global.get $s))))
        (i32.or (ref.is_null (global.get $a)) (ref.is_null (global.get $f)))))))
  ;; The bottom-typed globals stay null.
  (func (export "bottoms_null") (result i32)
    (i32.and (ref.is_null (global.get $nullref))
      (i32.and (ref.is_null (global.get $nullfuncref)) (ref.is_null (global.get $nullexternref)))))
)

(assert_return (invoke "all_null") (i32.const 1))
(invoke "set_all_null")
(assert_return (invoke "all_null") (i32.const 1))
(invoke "set_all_nonnull")
(assert_return (invoke "none_null") (i32.const 1))
(assert_return (invoke "bottoms_null") (i32.const 1))
(invoke "set_all_null")
(assert_return (invoke "all_null") (i32.const 1))
(invoke "set_all_nonnull")
(assert_return (invoke "none_null") (i32.const 1))
