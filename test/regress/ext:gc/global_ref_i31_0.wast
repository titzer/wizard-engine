;; Reference-typed globals holding i31 values, including transitions between i31, object, and null
;; values in globals whose type can hold both.
(module
  (type $s (struct (field i32)))
  (global $i31ref (mut i31ref) (ref.i31 (i32.const 0x2a)))
  (global $anyref (mut anyref) (ref.i31 (i32.const -1)))
  (global $eqref (mut eqref) (ref.i31 (i32.const 0x3fffffff)))
  (global $externref (mut externref) (extern.convert_any (ref.i31 (i32.const -0x40000000))))
  (global $nn_i31 (mut (ref i31)) (ref.i31 (i32.const 7)))
  (global $imm_i31 i31ref (ref.i31 (i32.const 0x12345)))

  (func (export "i31ref_s") (result i32) (i31.get_s (global.get $i31ref)))
  (func (export "i31ref_u") (result i32) (i31.get_u (global.get $i31ref)))
  (func (export "anyref_s") (result i32) (i31.get_s (ref.cast i31ref (global.get $anyref))))
  (func (export "anyref_u") (result i32) (i31.get_u (ref.cast i31ref (global.get $anyref))))
  (func (export "eqref_s") (result i32) (i31.get_s (ref.cast i31ref (global.get $eqref))))
  (func (export "externref_s") (result i32) (i31.get_s (ref.cast i31ref (any.convert_extern (global.get $externref)))))
  (func (export "nn_i31") (result i32) (i31.get_s (global.get $nn_i31)))
  (func (export "imm_i31") (result i32) (i31.get_u (global.get $imm_i31)))

  (func (export "set_i31ref") (param i32) (global.set $i31ref (ref.i31 (local.get 0))))
  (func (export "set_anyref_i31") (param i32) (global.set $anyref (ref.i31 (local.get 0))))
  (func (export "set_eqref_i31") (param i32) (global.set $eqref (ref.i31 (local.get 0))))
  (func (export "set_externref_i31") (param i32) (global.set $externref (extern.convert_any (ref.i31 (local.get 0)))))
  (func (export "set_nn_i31") (param i32) (global.set $nn_i31 (ref.i31 (local.get 0))))
  (func (export "set_anyref_obj") (param i32) (global.set $anyref (struct.new $s (local.get 0))))
  (func (export "set_eqref_obj") (param i32) (global.set $eqref (struct.new $s (local.get 0))))
  (func (export "set_externref_obj") (param i32) (global.set $externref (extern.convert_any (struct.new $s (local.get 0)))))
  (func (export "set_anyref_null") (global.set $anyref (ref.null any)))
  (func (export "set_eqref_null") (global.set $eqref (ref.null eq)))
  (func (export "set_externref_null") (global.set $externref (ref.null extern)))
  (func (export "set_i31ref_null") (global.set $i31ref (ref.null i31)))

  ;; Classifies a reference: 0 = null, 1 = i31, 2 = struct, 3 = other.
  (func $classify (param anyref) (result i32)
    (if (ref.is_null (local.get 0)) (then (return (i32.const 0))))
    (if (ref.test i31ref (local.get 0)) (then (return (i32.const 1))))
    (if (ref.test (ref $s) (local.get 0)) (then (return (i32.const 2))))
    (i32.const 3))
  (func (export "anyref_kind") (result i32) (call $classify (global.get $anyref)))
  (func (export "eqref_kind") (result i32) (call $classify (global.get $eqref)))
  (func (export "externref_kind") (result i32) (call $classify (any.convert_extern (global.get $externref))))
  (func (export "i31ref_kind") (result i32) (call $classify (global.get $i31ref)))
  (func (export "anyref_field") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get $anyref))))
  (func (export "eqref_field") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get $eqref))))
  (func (export "externref_field") (result i32) (struct.get $s 0 (ref.cast (ref $s) (any.convert_extern (global.get $externref)))))
  ;; ref.eq of an i31 global and a fresh i31 compares values.
  (func (export "eqref_eq_i31") (param i32) (result i32) (ref.eq (global.get $eqref) (ref.i31 (local.get 0))))
  (func (export "i31ref_eq_i31") (param i32) (result i32) (ref.eq (global.get $i31ref) (ref.i31 (local.get 0))))
  ;; br_on_cast on a global's value.
  (func (export "anyref_br_on_cast") (result i32)
    (block $is_i31 (result i31ref)
      (br_on_cast $is_i31 anyref i31ref (global.get $anyref))
      (drop)
      (return (i32.const -1)))
    (i31.get_u))
  ;; Moves the value of one global to another of a supertype.
  (func (export "i31ref_to_anyref") (global.set $anyref (global.get $i31ref)))
  (func (export "anyref_to_eqref") (global.set $eqref (ref.cast eqref (global.get $anyref))))
)

;; Initial values from constant expressions.
(assert_return (invoke "i31ref_s") (i32.const 0x2a))
(assert_return (invoke "anyref_s") (i32.const -1))
(assert_return (invoke "anyref_u") (i32.const 0x7fffffff))
(assert_return (invoke "eqref_s") (i32.const 0x3fffffff))
(assert_return (invoke "externref_s") (i32.const -0x40000000))
(assert_return (invoke "nn_i31") (i32.const 7))
(assert_return (invoke "imm_i31") (i32.const 0x12345))
(assert_return (invoke "anyref_kind") (i32.const 1))
(assert_return (invoke "eqref_kind") (i32.const 1))
(assert_return (invoke "externref_kind") (i32.const 1))

;; Boundary values: 0, 1, -1, the extremes, and values that wrap to 31 bits.
(invoke "set_i31ref" (i32.const 0))
(assert_return (invoke "i31ref_s") (i32.const 0))
(assert_return (invoke "i31ref_kind") (i32.const 1))
(invoke "set_i31ref" (i32.const 1))
(assert_return (invoke "i31ref_s") (i32.const 1))
(invoke "set_i31ref" (i32.const -1))
(assert_return (invoke "i31ref_s") (i32.const -1))
(assert_return (invoke "i31ref_u") (i32.const 0x7fffffff))
(invoke "set_i31ref" (i32.const 0x3fffffff))
(assert_return (invoke "i31ref_s") (i32.const 0x3fffffff))
(invoke "set_i31ref" (i32.const 0x40000000))
(assert_return (invoke "i31ref_s") (i32.const -0x40000000))
(assert_return (invoke "i31ref_u") (i32.const 0x40000000))
(invoke "set_i31ref" (i32.const 0x7fffffff))
(assert_return (invoke "i31ref_s") (i32.const -1))
(invoke "set_i31ref" (i32.const 0x80000000))
(assert_return (invoke "i31ref_s") (i32.const 0))
(invoke "set_i31ref" (i32.const 0xc0000001))
(assert_return (invoke "i31ref_s") (i32.const -0x3fffffff))
(assert_return (invoke "i31ref_eq_i31" (i32.const 0x40000001)) (i32.const 1))
(assert_return (invoke "i31ref_eq_i31" (i32.const 0x40000002)) (i32.const 0))
(invoke "set_i31ref_null")
(assert_return (invoke "i31ref_kind") (i32.const 0))
(invoke "set_nn_i31" (i32.const -7))
(assert_return (invoke "nn_i31") (i32.const -7))

;; anyref: i31 -> object -> null -> i31 -> object.
(invoke "set_anyref_i31" (i32.const 0x1234))
(assert_return (invoke "anyref_kind") (i32.const 1))
(assert_return (invoke "anyref_s") (i32.const 0x1234))
(assert_return (invoke "anyref_br_on_cast") (i32.const 0x1234))
(invoke "set_anyref_obj" (i32.const 0x5678))
(assert_return (invoke "anyref_kind") (i32.const 2))
(assert_return (invoke "anyref_field") (i32.const 0x5678))
(assert_return (invoke "anyref_br_on_cast") (i32.const -1))
(invoke "set_anyref_null")
(assert_return (invoke "anyref_kind") (i32.const 0))
(invoke "set_anyref_i31" (i32.const 0))
(assert_return (invoke "anyref_kind") (i32.const 1))
(assert_return (invoke "anyref_s") (i32.const 0))
(invoke "set_anyref_obj" (i32.const -9))
(assert_return (invoke "anyref_field") (i32.const -9))
(invoke "set_anyref_i31" (i32.const -0x40000000))
(assert_return (invoke "anyref_s") (i32.const -0x40000000))

;; eqref: the same transitions, plus ref.eq.
(invoke "set_eqref_obj" (i32.const 11))
(assert_return (invoke "eqref_kind") (i32.const 2))
(assert_return (invoke "eqref_field") (i32.const 11))
(assert_return (invoke "eqref_eq_i31" (i32.const 11)) (i32.const 0))
(invoke "set_eqref_i31" (i32.const 11))
(assert_return (invoke "eqref_kind") (i32.const 1))
(assert_return (invoke "eqref_eq_i31" (i32.const 11)) (i32.const 1))
(invoke "set_eqref_null")
(assert_return (invoke "eqref_kind") (i32.const 0))
(invoke "set_eqref_i31" (i32.const -1))
(assert_return (invoke "eqref_s") (i32.const -1))

;; externref: the same transitions, through extern.convert_any.
(invoke "set_externref_obj" (i32.const 22))
(assert_return (invoke "externref_kind") (i32.const 2))
(assert_return (invoke "externref_field") (i32.const 22))
(invoke "set_externref_i31" (i32.const 33))
(assert_return (invoke "externref_kind") (i32.const 1))
(assert_return (invoke "externref_s") (i32.const 33))
(invoke "set_externref_null")
(assert_return (invoke "externref_kind") (i32.const 0))
(invoke "set_externref_i31" (i32.const 0x3fffffff))
(assert_return (invoke "externref_s") (i32.const 0x3fffffff))

;; Moves between globals.
(invoke "set_i31ref" (i32.const 0x55))
(invoke "i31ref_to_anyref")
(assert_return (invoke "anyref_s") (i32.const 0x55))
(invoke "anyref_to_eqref")
(assert_return (invoke "eqref_s") (i32.const 0x55))
(invoke "set_anyref_obj" (i32.const 0x66))
(invoke "anyref_to_eqref")
(assert_return (invoke "eqref_field") (i32.const 0x66))
