;; Mutable reference-typed globals shared between modules by import and export.
(module $A
  (type $s (struct (field i32)))
  (global (export "anyref") (mut anyref) (ref.i31 (i32.const 1)))
  (global (export "eqref") (mut eqref) (ref.null eq))
  (global (export "externref") (mut externref) (ref.null extern))
  (global (export "funcref") (mut funcref) (ref.null func))
  (func (export "anyref_i31") (result i32) (i31.get_s (ref.cast i31ref (global.get 0))))
  (func (export "anyref_field") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get 0))))
  (func (export "anyref_is_null") (result i32) (ref.is_null (global.get 0)))
  (func (export "set_anyref_obj") (param i32) (global.set 0 (struct.new $s (local.get 0))))
  (func (export "eqref_i31") (result i32) (i31.get_u (ref.cast i31ref (global.get 1))))
  (func (export "externref_get") (result externref) (global.get 2))
  (func (export "funcref_is_null") (result i32) (ref.is_null (global.get 3)))
)
(register "A" $A)

(module $B
  (type $s (struct (field i32)))
  (type $v (func (result i32)))
  (global $anyref (import "A" "anyref") (mut anyref))
  (global $eqref (import "A" "eqref") (mut eqref))
  (global $externref (import "A" "externref") (mut externref))
  (global $funcref (import "A" "funcref") (mut funcref))
  (func $seven (result i32) (i32.const 7))
  (elem declare func $seven)
  (func (export "set_anyref_i31") (param i32) (global.set $anyref (ref.i31 (local.get 0))))
  (func (export "set_anyref_obj") (param i32) (global.set $anyref (struct.new $s (local.get 0))))
  (func (export "set_anyref_null") (global.set $anyref (ref.null any)))
  (func (export "anyref_i31") (result i32) (i31.get_s (ref.cast i31ref (global.get $anyref))))
  (func (export "anyref_field") (result i32) (struct.get $s 0 (ref.cast (ref $s) (global.get $anyref))))
  (func (export "set_eqref_i31") (param i32) (global.set $eqref (ref.i31 (local.get 0))))
  (func (export "set_externref") (param externref) (global.set $externref (local.get 0)))
  (func (export "set_funcref") (global.set $funcref (ref.func $seven)))
  (func (export "call_funcref") (result i32) (call_ref $v (ref.cast (ref $v) (global.get $funcref))))
)

(assert_return (invoke $A "anyref_i31") (i32.const 1))
(assert_return (invoke $B "anyref_i31") (i32.const 1))
(invoke $B "set_anyref_i31" (i32.const -5))
(assert_return (invoke $A "anyref_i31") (i32.const -5))
(invoke $B "set_anyref_obj" (i32.const 42))
(assert_return (invoke $A "anyref_field") (i32.const 42))
(invoke $A "set_anyref_obj" (i32.const 43))
(assert_return (invoke $B "anyref_field") (i32.const 43))
(invoke $B "set_anyref_null")
(assert_return (invoke $A "anyref_is_null") (i32.const 1))
(invoke $B "set_eqref_i31" (i32.const 0x7fffffff))
(assert_return (invoke $A "eqref_i31") (i32.const 0x7fffffff))
(invoke $B "set_externref" (ref.extern 17))
(assert_return (invoke $A "externref_get") (ref.extern 17))
(invoke $B "set_externref" (ref.null extern))
(assert_return (invoke $A "externref_get") (ref.null extern))
(assert_return (invoke $A "funcref_is_null") (i32.const 1))
(invoke $B "set_funcref")
(assert_return (invoke $A "funcref_is_null") (i32.const 0))
(assert_return (invoke $B "call_funcref") (i32.const 7))
