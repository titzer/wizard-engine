;; Exercises inline (JIT) casts against concrete and abstract heap types.
(module $M
  (type $A (sub (struct (field i32))))
  (type $B (sub $A (struct (field i32) (field i64))))
  (type $C (sub $B (struct (field i32) (field i64) (field f32))))
  (type $F (sub final $A (struct (field i32) (field f64))))
  (type $X (struct (field i32)))
  (type $Arr (array i8))

  (table $t 9 anyref)
  (func (export "init")
    (table.set $t (i32.const 0) (ref.null any))
    (table.set $t (i32.const 1) (ref.i31 (i32.const 7)))
    (table.set $t (i32.const 2) (struct.new_default $A))
    (table.set $t (i32.const 3) (struct.new_default $B))
    (table.set $t (i32.const 4) (struct.new_default $C))
    (table.set $t (i32.const 5) (struct.new_default $F))
    (table.set $t (i32.const 6) (struct.new_default $X))
    (table.set $t (i32.const 7) (array.new_default $Arr (i32.const 1)))
    (table.set $t (i32.const 8) (any.convert_extern (extern.convert_any (struct.new_default $C)))))
  (func (export "get") (param i32) (result anyref) (table.get $t (local.get 0)))

  ;; Returns a bitmask of the results of ref.test against several types for element {i}.
  (func (export "test") (param $i i32) (result i32)
    (local $r anyref)
    (local.set $r (table.get $t (local.get $i)))
    (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or (i32.or
      (ref.test (ref $A) (local.get $r))
      (i32.shl (ref.test (ref $B) (local.get $r)) (i32.const 1)))
      (i32.shl (ref.test (ref $C) (local.get $r)) (i32.const 2)))
      (i32.shl (ref.test (ref $F) (local.get $r)) (i32.const 3)))
      (i32.shl (ref.test (ref $X) (local.get $r)) (i32.const 4)))
      (i32.shl (ref.test (ref $Arr) (local.get $r)) (i32.const 5)))
      (i32.shl (ref.test (ref struct) (local.get $r)) (i32.const 6)))
      (i32.shl (ref.test (ref array) (local.get $r)) (i32.const 7)))
      (i32.shl (ref.test (ref eq) (local.get $r)) (i32.const 8)))
      (i32.shl (ref.test (ref i31) (local.get $r)) (i32.const 9)))
      (i32.shl (ref.test (ref any) (local.get $r)) (i32.const 10)))
      (i32.shl (ref.test (ref none) (local.get $r)) (i32.const 11))))
  (func (export "test_null") (param $i i32) (result i32)
    (local $r anyref)
    (local.set $r (table.get $t (local.get $i)))
    (i32.or (i32.or (i32.or
      (ref.test (ref null $B) (local.get $r))
      (i32.shl (ref.test (ref null $F) (local.get $r)) (i32.const 1)))
      (i32.shl (ref.test (ref null eq) (local.get $r)) (i32.const 2)))
      (i32.shl (ref.test (ref null none) (local.get $r)) (i32.const 3))))
  (func (export "cast_B") (param i32) (result i32)
    (ref.is_null (ref.cast (ref $B) (table.get $t (local.get 0)))))
  (func (export "cast_null_B") (param i32) (result i32)
    (ref.is_null (ref.cast (ref null $B) (table.get $t (local.get 0)))))
  (func (export "cast_F") (param i32) (result i32)
    (ref.is_null (ref.cast (ref $F) (table.get $t (local.get 0)))))
  (func (export "cast_struct") (param i32) (result i32)
    (ref.is_null (ref.cast (ref struct) (table.get $t (local.get 0)))))
  ;; br_on_cast: returns 1 if taken (with the value still usable), 0 if not.
  (func (export "br_on_B") (param i32) (result i32)
    (block $l (result (ref $B))
      (br_on_cast $l anyref (ref $B) (table.get $t (local.get 0)))
      (drop)
      (return (i32.const 0)))
    (drop)
    (i32.const 1))
  (func (export "br_on_null_B") (param i32) (result i32)
    (block $l (result (ref null $B))
      (br_on_cast $l anyref (ref null $B) (table.get $t (local.get 0)))
      (drop)
      (return (i32.const 0)))
    (drop)
    (i32.const 1))
  (func (export "br_on_fail_B") (param i32) (result i32)
    (block $l (result anyref)
      (br_on_cast_fail $l anyref (ref $B) (table.get $t (local.get 0)))
      ;; not taken: the value is a $B
      (return (i32.add (struct.get $B 0) (i32.const 10))))
    (drop)
    (i32.const 1))
  ;; The input type is non-nullable and concrete, so the compiler may skip null and i31 checks.
  (func (export "br_on_C_from_A") (param i32) (result i32)
    (local $a (ref $A))
    (local.set $a (ref.cast (ref $A) (table.get $t (local.get 0))))
    (block $l (result (ref $C))
      (br_on_cast $l (ref $A) (ref $C) (local.get $a))
      (drop)
      (return (i32.const 0)))
    (drop)
    (i32.const 1))
  ;; br_on_cast with other values live on the stack and in locals across the cast.
  (func (export "br_on_live") (param i32) (result i32 i32)
    (local $x i32)
    (local.set $x (i32.mul (local.get 0) (i32.const 3)))
    (block $l (result i32 (ref eq))
      (i32.add (local.get $x) (i32.const 1))
      (br_on_cast $l anyref (ref eq) (table.get $t (local.get 0)))
      (drop)
      (return (local.get $x) (i32.const 0)))
    (drop)
    (local.get $x))
)
(register "M" $M)
(invoke "init")

;; bits: A B C F X Arr struct array eq i31 any none
(assert_return (invoke "test" (i32.const 0)) (i32.const 0))
(assert_return (invoke "test" (i32.const 1)) (i32.const 0x700))
(assert_return (invoke "test" (i32.const 2)) (i32.const 0x541))
(assert_return (invoke "test" (i32.const 3)) (i32.const 0x543))
(assert_return (invoke "test" (i32.const 4)) (i32.const 0x547))
(assert_return (invoke "test" (i32.const 5)) (i32.const 0x549))
(assert_return (invoke "test" (i32.const 6)) (i32.const 0x550))
(assert_return (invoke "test" (i32.const 7)) (i32.const 0x5a0))
(assert_return (invoke "test" (i32.const 8)) (i32.const 0x547))
(assert_return (invoke "test_null" (i32.const 0)) (i32.const 0xf))
(assert_return (invoke "test_null" (i32.const 1)) (i32.const 0x4))
(assert_return (invoke "test_null" (i32.const 2)) (i32.const 0x4))
(assert_return (invoke "test_null" (i32.const 4)) (i32.const 0x5))
(assert_return (invoke "test_null" (i32.const 5)) (i32.const 0x6))
(assert_return (invoke "test_null" (i32.const 7)) (i32.const 0x4))

(assert_trap (invoke "cast_B" (i32.const 0)) "cast")
(assert_trap (invoke "cast_B" (i32.const 1)) "cast")
(assert_trap (invoke "cast_B" (i32.const 2)) "cast")
(assert_return (invoke "cast_B" (i32.const 3)) (i32.const 0))
(assert_return (invoke "cast_B" (i32.const 4)) (i32.const 0))
(assert_trap (invoke "cast_B" (i32.const 5)) "cast")
(assert_trap (invoke "cast_B" (i32.const 7)) "cast")
(assert_return (invoke "cast_null_B" (i32.const 0)) (i32.const 1))
(assert_trap (invoke "cast_null_B" (i32.const 6)) "cast")
(assert_return (invoke "cast_F" (i32.const 5)) (i32.const 0))
(assert_trap (invoke "cast_F" (i32.const 2)) "cast")
(assert_trap (invoke "cast_F" (i32.const 4)) "cast")
(assert_return (invoke "cast_struct" (i32.const 6)) (i32.const 0))
(assert_trap (invoke "cast_struct" (i32.const 1)) "cast")
(assert_trap (invoke "cast_struct" (i32.const 7)) "cast")

(assert_return (invoke "br_on_B" (i32.const 0)) (i32.const 0))
(assert_return (invoke "br_on_B" (i32.const 1)) (i32.const 0))
(assert_return (invoke "br_on_B" (i32.const 2)) (i32.const 0))
(assert_return (invoke "br_on_B" (i32.const 3)) (i32.const 1))
(assert_return (invoke "br_on_B" (i32.const 4)) (i32.const 1))
(assert_return (invoke "br_on_B" (i32.const 7)) (i32.const 0))
(assert_return (invoke "br_on_null_B" (i32.const 0)) (i32.const 1))
(assert_return (invoke "br_on_null_B" (i32.const 6)) (i32.const 0))
(assert_return (invoke "br_on_fail_B" (i32.const 0)) (i32.const 1))
(assert_return (invoke "br_on_fail_B" (i32.const 3)) (i32.const 10))
(assert_return (invoke "br_on_fail_B" (i32.const 4)) (i32.const 10))
(assert_return (invoke "br_on_fail_B" (i32.const 5)) (i32.const 1))
(assert_return (invoke "br_on_C_from_A" (i32.const 2)) (i32.const 0))
(assert_return (invoke "br_on_C_from_A" (i32.const 3)) (i32.const 0))
(assert_return (invoke "br_on_C_from_A" (i32.const 4)) (i32.const 1))
(assert_return (invoke "br_on_C_from_A" (i32.const 5)) (i32.const 0))
(assert_return (invoke "br_on_live" (i32.const 1)) (i32.const 4) (i32.const 3))
(assert_return (invoke "br_on_live" (i32.const 0)) (i32.const 0) (i32.const 0))
(assert_return (invoke "br_on_live" (i32.const 7)) (i32.const 22) (i32.const 21))

;; A second module with the same (canonicalized) types casts objects from the first.
(module
  (type $A (sub (struct (field i32))))
  (type $B (sub $A (struct (field i32) (field i64))))
  (type $C (sub $B (struct (field i32) (field i64) (field f32))))
  (type $F (sub final $A (struct (field i32) (field f64))))
  (import "M" "get" (func $get (param i32) (result anyref)))
  (func (export "test2") (param i32) (result i32)
    (local $r anyref)
    (local.set $r (call $get (local.get 0)))
    (i32.or (i32.or (i32.or
      (ref.test (ref $A) (local.get $r))
      (i32.shl (ref.test (ref $B) (local.get $r)) (i32.const 1)))
      (i32.shl (ref.test (ref $C) (local.get $r)) (i32.const 2)))
      (i32.shl (ref.test (ref $F) (local.get $r)) (i32.const 3))))
)
(assert_return (invoke "test2" (i32.const 2)) (i32.const 0x1))
(assert_return (invoke "test2" (i32.const 3)) (i32.const 0x3))
(assert_return (invoke "test2" (i32.const 4)) (i32.const 0x7))
(assert_return (invoke "test2" (i32.const 5)) (i32.const 0x9))
(assert_return (invoke "test2" (i32.const 6)) (i32.const 0x0))
