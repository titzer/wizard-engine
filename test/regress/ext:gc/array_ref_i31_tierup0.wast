;; Arrays whose elements may be i31 or object references, accessed by both the interpreter and
;; compiled code. The array accesses are in "cold" functions, called fewer than 10 times so that
;; they stay in the interpreter, and "hot" functions, called ~100 times so that they tier up.
;; Element {k} for iteration {i} cycles through i31, object, and null values by {(i + k) % 3}.
;; Failures return (array << 4 | check), plus (iteration << 8) in the hot loop.
;; Arrays: 1 = anyref, 2 = eqref, 3 = externref.
(module
  (type $s (struct (field i32)))
  (type $any (array (mut anyref)))
  (type $eq (array (mut eqref)))
  (type $ext (array (mut externref)))
  (type $sa (array (mut (ref null $s))))
  (global $a (mut (ref $any)) (array.new_default $any (i32.const 6)))
  (global $e (mut (ref $eq)) (array.new_default $eq (i32.const 6)))
  (global $x (mut (ref $ext)) (array.new_default $ext (i32.const 6)))
  (elem $el anyref (ref.i31 (i32.const 3)) (ref.null any) (item (struct.new $s (i32.const 4))))

  (func $x (param $i i32) (result i32) (i32.mul (local.get $i) (i32.const 0x01234567)))
  (func $x31 (param $i i32) (result i32) (i32.shr_s (i32.shl (call $x (local.get $i)) (i32.const 1)) (i32.const 1)))
  (func $mk (param $i i32) (result anyref)
    (block $b0 (block $b1 (block $b2
      (br_table $b0 $b1 $b2 (i32.rem_u (local.get $i) (i32.const 3))))
      (return (ref.null any)))
      (return (struct.new $s (call $x (local.get $i)))))
    (ref.i31 (call $x (local.get $i))))
  (func $chk (param $r anyref) (param $i i32) (result i32)
    (block $b0 (block $b1 (block $b2
      (br_table $b0 $b1 $b2 (i32.rem_u (local.get $i) (i32.const 3))))
      (return (if (result i32) (ref.is_null (local.get $r)) (then (i32.const 0)) (else (i32.const 1)))))
      (if (i32.eqz (ref.test (ref $s) (local.get $r))) (then (return (i32.const 2))))
      (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (local.get $r))) (call $x (local.get $i))) (then (return (i32.const 3))))
      (return (i32.const 0)))
    (if (i32.eqz (ref.test (ref i31) (local.get $r))) (then (return (i32.const 4))))
    (if (i32.ne (i31.get_s (ref.cast (ref i31) (local.get $r))) (call $x31 (local.get $i))) (then (return (i32.const 5))))
    (i32.const 0))

  (func $set_cold (param $i i32)
    (local $k i32)
    (loop $l
      (array.set $any (global.get $a) (local.get $k) (call $mk (i32.add (local.get $i) (local.get $k))))
      (array.set $eq (global.get $e) (local.get $k) (ref.cast eqref (call $mk (i32.add (local.get $i) (local.get $k)))))
      (array.set $ext (global.get $x) (local.get $k) (extern.convert_any (call $mk (i32.add (local.get $i) (local.get $k)))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 6)))))
  (func $set_hot (param $i i32)
    (local $k i32)
    (loop $l
      (array.set $any (global.get $a) (local.get $k) (call $mk (i32.add (local.get $i) (local.get $k))))
      (array.set $eq (global.get $e) (local.get $k) (ref.cast eqref (call $mk (i32.add (local.get $i) (local.get $k)))))
      (array.set $ext (global.get $x) (local.get $k) (extern.convert_any (call $mk (i32.add (local.get $i) (local.get $k)))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 6)))))
  (func $check_cold (param $i i32) (result i32)
    (local $k i32) (local $r i32)
    (loop $l
      (if (local.tee $r (call $chk (array.get $any (global.get $a) (local.get $k)) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x10) (local.get $r)))))
      (if (local.tee $r (call $chk (array.get $eq (global.get $e) (local.get $k)) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x20) (local.get $r)))))
      (if (local.tee $r (call $chk (any.convert_extern (array.get $ext (global.get $x) (local.get $k))) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x30) (local.get $r)))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 6))))
    (i32.const 0))
  (func $check_hot (param $i i32) (result i32)
    (local $k i32) (local $r i32)
    (loop $l
      (if (local.tee $r (call $chk (array.get $any (global.get $a) (local.get $k)) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x10) (local.get $r)))))
      (if (local.tee $r (call $chk (array.get $eq (global.get $e) (local.get $k)) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x20) (local.get $r)))))
      (if (local.tee $r (call $chk (any.convert_extern (array.get $ext (global.get $x) (local.get $k))) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.or (i32.const 0x30) (local.get $r)))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 6))))
    (i32.const 0))

  (func (export "loop") (param $n i32) (result i32)
    (local $i i32) (local $r i32)
    (loop $l
      (if (local.tee $r (call $check_hot (local.get $i)))
        (then (return (i32.or (i32.shl (local.get $i) (i32.const 8)) (local.get $r)))))
      (call $set_hot (i32.add (local.get $i) (i32.const 1)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (i32.const 0))
  (func (export "cold_set") (param i32) (call $set_cold (local.get 0)))
  (func (export "cold_check") (param i32) (result i32) (call $check_cold (local.get 0)))
  (func (export "hot_set") (param i32) (call $set_hot (local.get 0)))
  (func (export "hot_check") (param i32) (result i32) (call $check_hot (local.get 0)))

  ;; Other array operations on i31-or-reference elements, each checked element by element.
  (func $check_range (param $arr (ref $any)) (param $from i32) (param $n i32) (param $i i32) (result i32)
    (local $k i32) (local $r i32)
    (loop $l
      (if (local.tee $r (call $chk (array.get $any (local.get $arr) (i32.add (local.get $from) (local.get $k))) (i32.add (local.get $i) (local.get $k))))
        (then (return (i32.add (i32.mul (local.get $k) (i32.const 16)) (local.get $r)))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (local.get $n))))
    (i32.const 0))
  (func (export "new_fixed") (param $i i32) (result i32)
    (call $check_range
      (array.new_fixed $any 4 (call $mk (local.get $i)) (call $mk (i32.add (local.get $i) (i32.const 1)))
                              (call $mk (i32.add (local.get $i) (i32.const 2))) (call $mk (i32.add (local.get $i) (i32.const 3))))
      (i32.const 0) (i32.const 4) (local.get $i)))
  ;; array.new and array.fill with a value of kind {i % 3}: every element is the same.
  (func (export "new_fill") (param $i i32) (result i32)
    (local $arr (ref $any)) (local $r i32)
    (local.set $arr (array.new $any (call $mk (local.get $i)) (i32.const 5)))
    (if (local.tee $r (call $chk (array.get $any (local.get $arr) (i32.const 4)) (local.get $i))) (then (return (local.get $r))))
    (array.fill $any (local.get $arr) (i32.const 1) (call $mk (i32.add (local.get $i) (i32.const 1))) (i32.const 3))
    (if (local.tee $r (call $chk (array.get $any (local.get $arr) (i32.const 0)) (local.get $i))) (then (return (i32.add (i32.const 16) (local.get $r)))))
    (if (local.tee $r (call $chk (array.get $any (local.get $arr) (i32.const 3)) (i32.add (local.get $i) (i32.const 1)))) (then (return (i32.add (i32.const 32) (local.get $r)))))
    (if (local.tee $r (call $chk (array.get $any (local.get $arr) (i32.const 4)) (local.get $i))) (then (return (i32.add (i32.const 48) (local.get $r)))))
    (i32.const 0))
  ;; array.copy within the same array (overlapping, both directions) and between arrays.
  (func (export "copy") (param $i i32) (result i32)
    (local $arr (ref $any)) (local $b (ref $any)) (local $k i32) (local $r i32)
    (local.set $arr (array.new_default $any (i32.const 8)))
    (loop $l
      (array.set $any (local.get $arr) (local.get $k) (call $mk (i32.add (local.get $i) (local.get $k))))
      (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 8))))
    (local.set $b (array.new_default $any (i32.const 8)))
    (array.copy $any $any (local.get $b) (i32.const 0) (local.get $arr) (i32.const 0) (i32.const 8))
    (if (local.tee $r (call $check_range (local.get $b) (i32.const 0) (i32.const 8) (local.get $i))) (then (return (local.get $r))))
    (array.copy $any $any (local.get $arr) (i32.const 2) (local.get $arr) (i32.const 0) (i32.const 6)) ;; forward overlap
    (if (local.tee $r (call $check_range (local.get $arr) (i32.const 2) (i32.const 6) (local.get $i))) (then (return (i32.add (i32.const 0x100) (local.get $r)))))
    (array.copy $any $any (local.get $arr) (i32.const 0) (local.get $arr) (i32.const 2) (i32.const 6)) ;; backward overlap
    (if (local.tee $r (call $check_range (local.get $arr) (i32.const 0) (i32.const 6) (local.get $i))) (then (return (i32.add (i32.const 0x200) (local.get $r)))))
    (i32.const 0))
  ;; array.copy from an array of non-null struct references (a different representation).
  (func (export "copy_from_structs") (result i32)
    (local $src (ref $sa)) (local $dst (ref $any))
    (local.set $src (array.new_fixed $sa 2 (struct.new $s (i32.const 8)) (ref.null $s)))
    (local.set $dst (array.new $any (ref.i31 (i32.const 9)) (i32.const 3)))
    (array.copy $any $sa (local.get $dst) (i32.const 1) (local.get $src) (i32.const 0) (i32.const 2))
    (if (i32.eqz (ref.test (ref i31) (array.get $any (local.get $dst) (i32.const 0)))) (then (return (i32.const 1))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (array.get $any (local.get $dst) (i32.const 1)))) (i32.const 8)) (then (return (i32.const 2))))
    (if (i32.eqz (ref.is_null (array.get $any (local.get $dst) (i32.const 2)))) (then (return (i32.const 3))))
    (i32.const 0))
  ;; array.new_elem and array.init_elem from a segment with an i31, a null, and an object.
  (func (export "elems") (result i32)
    (local $arr (ref $any))
    (local.set $arr (array.new_elem $any $el (i32.const 0) (i32.const 3)))
    (if (i32.ne (i31.get_s (ref.cast (ref i31) (array.get $any (local.get $arr) (i32.const 0)))) (i32.const 3)) (then (return (i32.const 1))))
    (if (i32.eqz (ref.is_null (array.get $any (local.get $arr) (i32.const 1)))) (then (return (i32.const 2))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (array.get $any (local.get $arr) (i32.const 2)))) (i32.const 4)) (then (return (i32.const 3))))
    (array.init_elem $any $el (local.get $arr) (i32.const 1) (i32.const 0) (i32.const 2))
    (if (i32.ne (i31.get_s (ref.cast (ref i31) (array.get $any (local.get $arr) (i32.const 1)))) (i32.const 3)) (then (return (i32.const 4))))
    (if (i32.eqz (ref.is_null (array.get $any (local.get $arr) (i32.const 2)))) (then (return (i32.const 5))))
    (i32.const 0))
  (func (export "default_null") (result i32)
    (ref.is_null (array.get $any (array.new_default $any (i32.const 3)) (i32.const 2))))
)

(invoke "cold_set" (i32.const 0))
(assert_return (invoke "loop" (i32.const 100)) (i32.const 0))
(assert_return (invoke "cold_check" (i32.const 100)) (i32.const 0))
(invoke "hot_set" (i32.const 101))
(assert_return (invoke "cold_check" (i32.const 101)) (i32.const 0))
(invoke "hot_set" (i32.const 102))
(assert_return (invoke "cold_check" (i32.const 102)) (i32.const 0))
(invoke "cold_set" (i32.const 103))
(assert_return (invoke "hot_check" (i32.const 103)) (i32.const 0))
(invoke "cold_set" (i32.const 104))
(assert_return (invoke "hot_check" (i32.const 104)) (i32.const 0))
(invoke "cold_set" (i32.const 105))
(assert_return (invoke "hot_check" (i32.const 105)) (i32.const 0))
(assert_return (invoke "new_fixed" (i32.const 0)) (i32.const 0))
(assert_return (invoke "new_fixed" (i32.const 1)) (i32.const 0))
(assert_return (invoke "new_fixed" (i32.const 2)) (i32.const 0))
(assert_return (invoke "new_fill" (i32.const 0)) (i32.const 0))
(assert_return (invoke "new_fill" (i32.const 1)) (i32.const 0))
(assert_return (invoke "new_fill" (i32.const 2)) (i32.const 0))
(assert_return (invoke "copy" (i32.const 0)) (i32.const 0))
(assert_return (invoke "copy" (i32.const 1)) (i32.const 0))
(assert_return (invoke "copy" (i32.const 2)) (i32.const 0))
(assert_return (invoke "copy_from_structs") (i32.const 0))
(assert_return (invoke "elems") (i32.const 0))
(assert_return (invoke "default_null") (i32.const 1))
