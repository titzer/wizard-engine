;; Reference-typed globals holding functions.
(module
  (type $ii (func (param i32) (result i32)))
  (func $inc (type $ii) (i32.add (local.get 0) (i32.const 1)))
  (func $dbl (type $ii) (i32.mul (local.get 0) (i32.const 2)))
  (elem declare func $inc $dbl)
  (global $funcref (mut funcref) (ref.func $inc))
  (global $typed (mut (ref null $ii)) (ref.func $dbl))
  (global $nn (mut (ref $ii)) (ref.func $inc))
  (global $imm (ref $ii) (ref.func $dbl))

  (func (export "call_funcref") (param i32) (result i32)
    (call_ref $ii (local.get 0) (ref.cast (ref $ii) (global.get $funcref))))
  (func (export "call_typed") (param i32) (result i32)
    (call_ref $ii (local.get 0) (global.get $typed)))
  (func (export "call_nn") (param i32) (result i32)
    (call_ref $ii (local.get 0) (global.get $nn)))
  (func (export "call_imm") (param i32) (result i32)
    (call_ref $ii (local.get 0) (global.get $imm)))
  (func (export "swap")
    (local $t (ref $ii))
    (local.set $t (global.get $nn))
    (global.set $nn (ref.as_non_null (global.get $typed)))
    (global.set $typed (local.get $t))
    (global.set $funcref (global.get $nn)))
  (func (export "set_typed_null") (global.set $typed (ref.null $ii)))
  (func (export "typed_is_null") (result i32) (ref.is_null (global.get $typed)))
)

(assert_return (invoke "call_funcref" (i32.const 5)) (i32.const 6))
(assert_return (invoke "call_typed" (i32.const 5)) (i32.const 10))
(assert_return (invoke "call_nn" (i32.const 5)) (i32.const 6))
(assert_return (invoke "call_imm" (i32.const 5)) (i32.const 10))
(invoke "swap")
(assert_return (invoke "call_nn" (i32.const 7)) (i32.const 14))
(assert_return (invoke "call_typed" (i32.const 7)) (i32.const 8))
(assert_return (invoke "call_funcref" (i32.const 7)) (i32.const 14))
(invoke "set_typed_null")
(assert_return (invoke "typed_is_null") (i32.const 1))
(assert_trap (invoke "call_typed" (i32.const 1)) "null")
