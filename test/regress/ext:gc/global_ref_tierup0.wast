;; Reference-typed globals accessed by both the interpreter and compiled code. The global accesses
;; are in "cold" functions, called fewer than 10 times so that they stay in the interpreter, and
;; "hot" functions, called ~100 times so that they tier up. Values written by one tier are read by
;; the other, cycling through i31, object, and null values.
;; Failures return (global << 4 | check), plus (iteration << 8) in the hot loop.
;; Globals: 1 = anyref, 2 = eqref, 3 = i31ref, 4 = structref, 5 = funcref, 6 = externref.
(module
  (type $s (struct (field i32)))
  (type $v (func (result i32)))
  (global $any (mut anyref) (ref.null any))
  (global $eq (mut eqref) (ref.null eq))
  (global $i31 (mut i31ref) (ref.null i31))
  (global $st (mut structref) (ref.null struct))
  (global $fn (mut funcref) (ref.null func))
  (global $ex (mut externref) (ref.null extern))

  (func $ret7 (type $v) (i32.const 7))
  (func $ret9 (type $v) (i32.const 9))
  (elem declare func $ret7 $ret9)

  ;; The integer for iteration {i}, which wraps to 31 bits when stored in an i31.
  (func $x (param $i i32) (result i32) (i32.mul (local.get $i) (i32.const 0x01234567)))
  ;; {x} sign-extended from 31 bits, as read back with i31.get_s.
  (func $x31 (param $i i32) (result i32) (i32.shr_s (i32.shl (call $x (local.get $i)) (i32.const 1)) (i32.const 1)))
  ;; An i31, struct, or null for iteration {i}, by {i % 3}.
  (func $mk (param $i i32) (result anyref)
    (block $b0 (block $b1 (block $b2
      (br_table $b0 $b1 $b2 (i32.rem_u (local.get $i) (i32.const 3))))
      (return (ref.null any)))
      (return (struct.new $s (call $x (local.get $i)))))
    (ref.i31 (call $x (local.get $i))))
  (func $chk (param $r anyref) (param $i i32) (result i32)
    (block $b0 (block $b1 (block $b2
      (br_table $b0 $b1 $b2 (i32.rem_u (local.get $i) (i32.const 3))))
      (return (if (result i32) (ref.is_null (local.get $r)) (then (i32.const 0)) (else (i32.const 1)))))
      (if (i32.eqz (ref.test (ref $s) (local.get $r))) (then (return (i32.const 2))))
      (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (local.get $r))) (call $x (local.get $i))) (then (return (i32.const 3))))
      (return (i32.const 0)))
    (if (i32.eqz (ref.test (ref i31) (local.get $r))) (then (return (i32.const 4))))
    (if (i32.ne (i31.get_s (ref.cast (ref i31) (local.get $r))) (call $x31 (local.get $i))) (then (return (i32.const 5))))
    (i32.const 0))
  ;; An i31 or null for iteration {i}, by {i % 2}.
  (func $mk_i31 (param $i i32) (result i31ref)
    (if (result i31ref) (i32.and (local.get $i) (i32.const 1)) (then (ref.null i31)) (else (ref.i31 (call $x (local.get $i))))))
  (func $chk_i31 (param $r i31ref) (param $i i32) (result i32)
    (if (i32.and (local.get $i) (i32.const 1))
      (then (return (if (result i32) (ref.is_null (local.get $r)) (then (i32.const 0)) (else (i32.const 6))))))
    (if (ref.is_null (local.get $r)) (then (return (i32.const 7))))
    (if (i32.ne (i31.get_s (local.get $r)) (call $x31 (local.get $i))) (then (return (i32.const 8))))
    (i32.const 0))
  ;; A struct or null for iteration {i}, by {i % 2}.
  (func $mk_st (param $i i32) (result structref)
    (if (result structref) (i32.and (local.get $i) (i32.const 1)) (then (ref.null struct)) (else (struct.new $s (call $x (local.get $i))))))
  (func $chk_st (param $r structref) (param $i i32) (result i32)
    (if (i32.and (local.get $i) (i32.const 1))
      (then (return (if (result i32) (ref.is_null (local.get $r)) (then (i32.const 0)) (else (i32.const 9))))))
    (if (ref.is_null (local.get $r)) (then (return (i32.const 10))))
    (if (i32.ne (struct.get $s 0 (ref.cast (ref $s) (local.get $r))) (call $x (local.get $i))) (then (return (i32.const 11))))
    (i32.const 0))
  ;; {$ret7}, {$ret9}, or null for iteration {i}, by {i % 3}.
  (func $mk_fn (param $i i32) (result funcref)
    (block $b0 (block $b1 (block $b2
      (br_table $b0 $b1 $b2 (i32.rem_u (local.get $i) (i32.const 3))))
      (return (ref.null func)))
      (return (ref.func $ret9)))
    (ref.func $ret7))
  (func $chk_fn (param $r funcref) (param $i i32) (result i32)
    (local $want i32)
    (if (i32.eq (i32.rem_u (local.get $i) (i32.const 3)) (i32.const 2))
      (then (return (if (result i32) (ref.is_null (local.get $r)) (then (i32.const 0)) (else (i32.const 12))))))
    (if (ref.is_null (local.get $r)) (then (return (i32.const 13))))
    (local.set $want (if (result i32) (i32.rem_u (local.get $i) (i32.const 3)) (then (i32.const 9)) (else (i32.const 7))))
    (if (i32.ne (call_ref $v (ref.cast (ref $v) (local.get $r))) (local.get $want)) (then (return (i32.const 14))))
    (i32.const 0))

  (func $set_cold (param $i i32)
    (global.set $any (call $mk (local.get $i)))
    (global.set $eq (ref.cast eqref (call $mk (local.get $i))))
    (global.set $i31 (call $mk_i31 (local.get $i)))
    (global.set $st (call $mk_st (local.get $i)))
    (global.set $fn (call $mk_fn (local.get $i)))
    (global.set $ex (extern.convert_any (call $mk (local.get $i)))))
  (func $set_hot (param $i i32)
    (global.set $any (call $mk (local.get $i)))
    (global.set $eq (ref.cast eqref (call $mk (local.get $i))))
    (global.set $i31 (call $mk_i31 (local.get $i)))
    (global.set $st (call $mk_st (local.get $i)))
    (global.set $fn (call $mk_fn (local.get $i)))
    (global.set $ex (extern.convert_any (call $mk (local.get $i)))))
  (func $check_cold (param $i i32) (result i32)
    (local $r i32)
    (if (local.tee $r (call $chk (global.get $any) (local.get $i))) (then (return (i32.or (i32.const 0x10) (local.get $r)))))
    (if (local.tee $r (call $chk (global.get $eq) (local.get $i))) (then (return (i32.or (i32.const 0x20) (local.get $r)))))
    (if (local.tee $r (call $chk_i31 (global.get $i31) (local.get $i))) (then (return (i32.or (i32.const 0x30) (local.get $r)))))
    (if (local.tee $r (call $chk_st (global.get $st) (local.get $i))) (then (return (i32.or (i32.const 0x40) (local.get $r)))))
    (if (local.tee $r (call $chk_fn (global.get $fn) (local.get $i))) (then (return (i32.or (i32.const 0x50) (local.get $r)))))
    (if (local.tee $r (call $chk (any.convert_extern (global.get $ex)) (local.get $i))) (then (return (i32.or (i32.const 0x60) (local.get $r)))))
    (i32.const 0))
  (func $check_hot (param $i i32) (result i32)
    (local $r i32)
    (if (local.tee $r (call $chk (global.get $any) (local.get $i))) (then (return (i32.or (i32.const 0x10) (local.get $r)))))
    (if (local.tee $r (call $chk (global.get $eq) (local.get $i))) (then (return (i32.or (i32.const 0x20) (local.get $r)))))
    (if (local.tee $r (call $chk_i31 (global.get $i31) (local.get $i))) (then (return (i32.or (i32.const 0x30) (local.get $r)))))
    (if (local.tee $r (call $chk_st (global.get $st) (local.get $i))) (then (return (i32.or (i32.const 0x40) (local.get $r)))))
    (if (local.tee $r (call $chk_fn (global.get $fn) (local.get $i))) (then (return (i32.or (i32.const 0x50) (local.get $r)))))
    (if (local.tee $r (call $chk (any.convert_extern (global.get $ex)) (local.get $i))) (then (return (i32.or (i32.const 0x60) (local.get $r)))))
    (i32.const 0))

  ;; Runs {n} iterations: checks the values of the previous iteration (or {cold_set}), then writes new ones.
  (func (export "loop") (param $n i32) (result i32)
    (local $i i32) (local $r i32)
    (loop $l
      (if (local.tee $r (call $check_hot (local.get $i)))
        (then (return (i32.or (i32.shl (local.get $i) (i32.const 8)) (local.get $r)))))
      (call $set_hot (i32.add (local.get $i) (i32.const 1)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (i32.const 0))
  (func (export "cold_set") (param i32) (call $set_cold (local.get 0)))
  (func (export "cold_check") (param i32) (result i32) (call $check_cold (local.get 0)))
  (func (export "hot_set") (param i32) (call $set_hot (local.get 0)))
  (func (export "hot_check") (param i32) (result i32) (call $check_hot (local.get 0)))
)

;; Written by cold code, read by hot code (as it tiers up), and written by hot code.
(invoke "cold_set" (i32.const 0))
(assert_return (invoke "loop" (i32.const 100)) (i32.const 0))
;; Written by hot code, read by cold code: i31, struct, and null values.
(assert_return (invoke "cold_check" (i32.const 100)) (i32.const 0))
(invoke "hot_set" (i32.const 101))
(assert_return (invoke "cold_check" (i32.const 101)) (i32.const 0))
(invoke "hot_set" (i32.const 102))
(assert_return (invoke "cold_check" (i32.const 102)) (i32.const 0))
;; Written by cold code, read by (now compiled) hot code.
(invoke "cold_set" (i32.const 103))
(assert_return (invoke "hot_check" (i32.const 103)) (i32.const 0))
(invoke "cold_set" (i32.const 104))
(assert_return (invoke "hot_check" (i32.const 104)) (i32.const 0))
(invoke "cold_set" (i32.const 105))
(assert_return (invoke "hot_check" (i32.const 105)) (i32.const 0))
