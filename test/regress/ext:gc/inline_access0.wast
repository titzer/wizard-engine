;; Exercises inline (JIT) struct and array accesses for all field representations.
(module
  (type $s (struct (field (mut i8)) (field (mut i16)) (field (mut i32)) (field (mut i64))
                   (field (mut f32)) (field (mut f64)) (field (mut v128))
                   (field (mut anyref)) (field (mut eqref)) (field (mut (ref null $s)))))
  (global $g (mut (ref null $s)) (ref.null $s))

  (func (export "init")
    (global.set $g (struct.new_default $s)))

  (func (export "i8") (param i32) (result i32 i32)
    (struct.set $s 0 (global.get $g) (local.get 0))
    (struct.get_s $s 0 (global.get $g))
    (struct.get_u $s 0 (global.get $g)))
  (func (export "i16") (param i32) (result i32 i32)
    (struct.set $s 1 (global.get $g) (local.get 0))
    (struct.get_s $s 1 (global.get $g))
    (struct.get_u $s 1 (global.get $g)))
  (func (export "i32") (param i32) (result i32)
    (struct.set $s 2 (global.get $g) (local.get 0))
    (struct.get $s 2 (global.get $g)))
  (func (export "i64") (param i64) (result i64)
    (struct.set $s 3 (global.get $g) (local.get 0))
    (struct.get $s 3 (global.get $g)))
  (func (export "f32") (param f32) (result f32)
    (struct.set $s 4 (global.get $g) (local.get 0))
    (struct.get $s 4 (global.get $g)))
  (func (export "f64") (param f64) (result f64)
    (struct.set $s 5 (global.get $g) (local.get 0))
    (struct.get $s 5 (global.get $g)))
  (func (export "v128") (param i64 i64) (result i64 i64)
    (struct.set $s 6 (global.get $g) (i64x2.replace_lane 1 (i64x2.splat (local.get 0)) (local.get 1)))
    (i64x2.extract_lane 0 (struct.get $s 6 (global.get $g)))
    (i64x2.extract_lane 1 (struct.get $s 6 (global.get $g))))
  ;; Stores an i31 into an anyref field and reads it back, comparing with a fresh i31.
  (func (export "anyref_i31") (param i32) (result i32 i32)
    (struct.set $s 7 (global.get $g) (ref.i31 (local.get 0)))
    (i31.get_s (ref.cast (ref i31) (struct.get $s 7 (global.get $g))))
    (ref.eq (ref.cast eqref (struct.get $s 7 (global.get $g))) (ref.i31 (local.get 0))))
  (func (export "eqref_self") (result i32)
    (struct.set $s 8 (global.get $g) (global.get $g))
    (ref.eq (struct.get $s 8 (global.get $g)) (global.get $g)))
  (func (export "ref_self") (result i32)
    (struct.set $s 9 (global.get $g) (global.get $g))
    (ref.eq (struct.get $s 9 (global.get $g)) (global.get $g)))
  (func (export "null_get") (result i32)
    (struct.get $s 2 (ref.null $s)))
  (func (export "null_get2") (param (ref null $s)) (result i32)
    (struct.get $s 2 (local.get 0)))
  (func (export "null_set") (param (ref null $s))
    (struct.set $s 2 (local.get 0) (i32.const 1)))
)

(invoke "init")
(assert_return (invoke "i8" (i32.const 0x1ff)) (i32.const -1) (i32.const 0xff))
(assert_return (invoke "i8" (i32.const 0x7f)) (i32.const 0x7f) (i32.const 0x7f))
(assert_return (invoke "i16" (i32.const 0x18000)) (i32.const -32768) (i32.const 0x8000))
(assert_return (invoke "i32" (i32.const -7)) (i32.const -7))
(assert_return (invoke "i64" (i64.const 0x8877665544332211)) (i64.const 0x8877665544332211))
(assert_return (invoke "f32" (f32.const -1.5)) (f32.const -1.5))
(assert_return (invoke "f64" (f64.const 3.25)) (f64.const 3.25))
(assert_return (invoke "v128" (i64.const 0x1111) (i64.const -2)) (i64.const 0x1111) (i64.const -2))
(assert_return (invoke "anyref_i31" (i32.const 5)) (i32.const 5) (i32.const 1))
(assert_return (invoke "anyref_i31" (i32.const 0x40000000)) (i32.const -0x40000000) (i32.const 1))
(assert_return (invoke "anyref_i31" (i32.const -1)) (i32.const -1) (i32.const 1))
(assert_return (invoke "eqref_self") (i32.const 1))
(assert_return (invoke "ref_self") (i32.const 1))
(assert_trap (invoke "null_get") "null")
(assert_trap (invoke "null_get2" (ref.null none)) "null")
(assert_trap (invoke "null_set" (ref.null none)) "null")

(module
  (type $b (array (mut i8)))
  (type $h (array (mut i16)))
  (type $i (array (mut i32)))
  (type $l (array (mut i64)))
  (type $f (array (mut f32)))
  (type $d (array (mut f64)))
  (type $v (array (mut v128)))
  (type $a (array (mut anyref)))
  (type $s (struct (field i32)))
  (type $r (array (mut (ref null $s))))

  (func (export "b") (param i32 i32) (result i32 i32 i32)
    (local $x (ref $b))
    (local.set $x (array.new_default $b (i32.const 3)))
    (array.set $b (local.get $x) (local.get 0) (local.get 1))
    (array.get_s $b (local.get $x) (local.get 0))
    (array.get_u $b (local.get $x) (local.get 0))
    (array.len (local.get $x)))
  (func (export "h") (param i32 i32) (result i32 i32)
    (local $x (ref $h))
    (local.set $x (array.new_default $h (i32.const 3)))
    (array.set $h (local.get $x) (local.get 0) (local.get 1))
    (array.get_s $h (local.get $x) (local.get 0))
    (array.get_u $h (local.get $x) (local.get 0)))
  (func (export "i") (param i32 i32) (result i32)
    (local $x (ref $i))
    (local.set $x (array.new_default $i (i32.const 3)))
    (array.set $i (local.get $x) (local.get 0) (local.get 1))
    (array.get $i (local.get $x) (local.get 0)))
  (func (export "l") (param i32 i64) (result i64)
    (local $x (ref $l))
    (local.set $x (array.new_default $l (i32.const 3)))
    (array.set $l (local.get $x) (local.get 0) (local.get 1))
    (array.get $l (local.get $x) (local.get 0)))
  (func (export "f") (param i32 f32) (result f32)
    (local $x (ref $f))
    (local.set $x (array.new_default $f (i32.const 3)))
    (array.set $f (local.get $x) (local.get 0) (local.get 1))
    (array.get $f (local.get $x) (local.get 0)))
  (func (export "d") (param i32 f64) (result f64)
    (local $x (ref $d))
    (local.set $x (array.new_default $d (i32.const 3)))
    (array.set $d (local.get $x) (local.get 0) (local.get 1))
    (array.get $d (local.get $x) (local.get 0)))
  (func (export "v") (param i32 i64 i64) (result i64 i64 i64)
    (local $x (ref $v))
    (local.set $x (array.new_default $v (i32.const 3)))
    (array.set $v (local.get $x) (local.get 0) (i64x2.replace_lane 1 (i64x2.splat (local.get 1)) (local.get 2)))
    (i64x2.extract_lane 0 (array.get $v (local.get $x) (local.get 0)))
    (i64x2.extract_lane 1 (array.get $v (local.get $x) (local.get 0)))
    ;; other elements are untouched
    (i64.add (i64x2.extract_lane 0 (array.get $v (local.get $x) (i32.const 0)))
             (i64x2.extract_lane 1 (array.get $v (local.get $x) (i32.const 2)))))
  ;; Alternates i31s and structs in an anyref array, then checks each element.
  (func (export "a") (param i32) (result i32)
    (local $x (ref $a)) (local $i i32) (local $sum i32) (local $e anyref)
    (local.set $x (array.new_default $a (local.get 0)))
    (loop $l
      (if (i32.and (local.get $i) (i32.const 1))
        (then (array.set $a (local.get $x) (local.get $i) (struct.new $s (local.get $i))))
        (else (array.set $a (local.get $x) (local.get $i) (ref.i31 (i32.add (local.get $i) (i32.const 0x40000000))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get 0))))
    ;; overwrite element 1 (a struct) with an i31 and element 2 (an i31) with null
    (array.set $a (local.get $x) (i32.const 1) (ref.i31 (i32.const 1)))
    (array.set $a (local.get $x) (i32.const 2) (ref.null any))
    (local.set $i (i32.const 0))
    (loop $l
      (local.set $e (array.get $a (local.get $x) (local.get $i)))
      (block $next
        (br_if $next (ref.is_null (local.get $e)))
        (if (ref.test (ref i31) (local.get $e))
          (then (local.set $sum (i32.add (local.get $sum) (i31.get_u (ref.cast (ref i31) (local.get $e))))))
          (else (local.set $sum (i32.add (local.get $sum) (struct.get $s 0 (ref.cast (ref $s) (local.get $e))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get 0))))
    (local.get $sum))
  (func (export "r") (result i32)
    (local $x (ref $r))
    (local.set $x (array.new_default $r (i32.const 2)))
    (array.set $r (local.get $x) (i32.const 1) (struct.new $s (i32.const 42)))
    (i32.add (struct.get $s 0 (array.get $r (local.get $x) (i32.const 1)))
             (ref.is_null (array.get $r (local.get $x) (i32.const 0)))))
  (func (export "oob_get") (param i32) (result i32)
    (array.get $i (array.new_default $i (i32.const 3)) (local.get 0)))
  (func (export "oob_set") (param i32)
    (array.set $v (array.new_default $v (i32.const 3)) (local.get 0) (v128.const i64x2 0 0)))
  (func (export "null_len") (param (ref null $i)) (result i32)
    (array.len (local.get 0)))
  (func (export "null_get") (param (ref null $a)) (result anyref)
    (array.get $a (local.get 0) (i32.const 0)))
)

(assert_return (invoke "b" (i32.const 2) (i32.const 0x80)) (i32.const -128) (i32.const 0x80) (i32.const 3))
(assert_return (invoke "h" (i32.const 0) (i32.const 0xffff)) (i32.const -1) (i32.const 0xffff))
(assert_return (invoke "i" (i32.const 1) (i32.const -3)) (i32.const -3))
(assert_return (invoke "l" (i32.const 2) (i64.const -0x123456789)) (i64.const -0x123456789))
(assert_return (invoke "f" (i32.const 0) (f32.const 0.5)) (f32.const 0.5))
(assert_return (invoke "d" (i32.const 1) (f64.const -0.125)) (f64.const -0.125))
(assert_return (invoke "v" (i32.const 1) (i64.const 7) (i64.const -8)) (i64.const 7) (i64.const -8) (i64.const 0))
;; elements: 0 -> i31(0x40000000), 1 -> i31(1), 2 -> null, 3 -> s(3), 4 -> i31(0x40000004), 5 -> s(5)
;; sum (mod 2^32) = 0x40000000 + 1 + 3 + 0x40000004 + 5 = 0x8000000d
(assert_return (invoke "a" (i32.const 6)) (i32.const 0x8000000d))
(assert_return (invoke "r") (i32.const 43))
(assert_return (invoke "oob_get" (i32.const 2)) (i32.const 0))
(assert_trap (invoke "oob_get" (i32.const 3)) "out of bounds")
(assert_trap (invoke "oob_get" (i32.const -1)) "out of bounds")
(assert_trap (invoke "oob_set" (i32.const 3)) "out of bounds")
(assert_trap (invoke "null_len" (ref.null none)) "null")
(assert_trap (invoke "null_get" (ref.null none)) "null")
