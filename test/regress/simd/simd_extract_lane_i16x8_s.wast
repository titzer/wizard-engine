(assert_return (invoke "lane0_add" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00ff8180))
(assert_return (invoke "lane0_eqz" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00000000))
(assert_return (invoke "lane0_ext64u" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i64.const 0x00000000ffff8180))
(assert_return (invoke "lane0_ext64s" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i64.const 0xffffffffffff8180))
(assert_return (invoke "lane0_local" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0xffff8180))
