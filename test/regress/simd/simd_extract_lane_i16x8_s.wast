;; Results consumed by other instructions (shifts, arithmetic, 64-bit extension, locals,
;; calls, memory, globals), and extracts from splats with nonzero bytes above the lane.
(module
  (memory 1)
  (global $g (mut i32) (i32.const 0))
  (func $id64 (param i32) (result i64) (i64.extend_i32_u (local.get 0)))
  (func (export "lane0_ret") (param v128) (result i32) (local i32) (i16x8.extract_lane_s 0 (local.get 0)))
  (func (export "lane0_shr8") (param v128) (result i32) (local i32) (i32.shr_u (i16x8.extract_lane_s 0 (local.get 0)) (i32.const 8)))
  (func (export "lane0_shr16") (param v128) (result i32) (local i32) (i32.shr_u (i16x8.extract_lane_s 0 (local.get 0)) (i32.const 16)))
  (func (export "lane0_shr24") (param v128) (result i32) (local i32) (i32.shr_u (i16x8.extract_lane_s 0 (local.get 0)) (i32.const 24)))
  (func (export "lane0_add") (param v128) (result i32) (local i32) (i32.add (i16x8.extract_lane_s 0 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane0_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i16x8.extract_lane_s 0 (local.get 0)) (i32.const 0xffff0000))))
  (func (export "lane0_ext64u") (param v128) (result i64) (local i32) (i64.extend_i32_u (i16x8.extract_lane_s 0 (local.get 0))))
  (func (export "lane0_ext64s") (param v128) (result i64) (local i32) (i64.extend_i32_s (i16x8.extract_lane_s 0 (local.get 0))))
  (func (export "lane0_local") (param v128) (result i32) (local i32) (local.set 1 (i16x8.extract_lane_s 0 (local.get 0))) (local.get 1))
  (func (export "lane0_call") (param v128) (result i64) (local i32) (call $id64 (i16x8.extract_lane_s 0 (local.get 0))))
  (func (export "lane0_mem") (param v128) (result i64) (local i32) (i64.store (i32.const 8) (i64.const -1)) (i32.store (i32.const 8) (i16x8.extract_lane_s 0 (local.get 0))) (i64.load (i32.const 8)))
  (func (export "lane0_global") (param v128) (result i32) (local i32) (global.set $g (i16x8.extract_lane_s 0 (local.get 0))) (global.get $g))
