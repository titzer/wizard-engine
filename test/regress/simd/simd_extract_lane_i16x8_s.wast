  (func (export "lane1_add") (param v128) (result i32) (local i32) (i32.add (i16x8.extract_lane_s 1 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane1_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i16x8.extract_lane_s 1 (local.get 0)) (i32.const 0xffff0000))))
