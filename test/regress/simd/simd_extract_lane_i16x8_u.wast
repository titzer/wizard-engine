(assert_return (invoke "lane5" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x000000ff))
