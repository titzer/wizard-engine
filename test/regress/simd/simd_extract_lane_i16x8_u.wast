;; Tests i16x8.extract_lane_u on vectors whose bytes next to the extracted lane are nonzero, so that any
;; upper bits left over from the vector in the result would show up.
;; Generated by gen_extract.py.

;; Every lane index, with the result returned directly.
(module
  (func (export "lane0") (param v128) (result i32) (i16x8.extract_lane_u 0 (local.get 0)))
  (func (export "lane1") (param v128) (result i32) (i16x8.extract_lane_u 1 (local.get 0)))
  (func (export "lane2") (param v128) (result i32) (i16x8.extract_lane_u 2 (local.get 0)))
  (func (export "lane3") (param v128) (result i32) (i16x8.extract_lane_u 3 (local.get 0)))
  (func (export "lane4") (param v128) (result i32) (i16x8.extract_lane_u 4 (local.get 0)))
  (func (export "lane5") (param v128) (result i32) (i16x8.extract_lane_u 5 (local.get 0)))
  (func (export "lane6") (param v128) (result i32) (i16x8.extract_lane_u 6 (local.get 0)))
  (func (export "lane7") (param v128) (result i32) (i16x8.extract_lane_u 7 (local.get 0)))
)
;; Vector "hi".
(assert_return (invoke "lane0" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008180))
(assert_return (invoke "lane1" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008382))
(assert_return (invoke "lane2" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008584))
(assert_return (invoke "lane3" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008786))
(assert_return (invoke "lane4" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008988))
(assert_return (invoke "lane5" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008b8a))
(assert_return (invoke "lane6" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008d8c))
(assert_return (invoke "lane7" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00008f8e))
;; Vector "ones".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane4" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane5" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane6" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
(assert_return (invoke "lane7" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0x0000ffff))
;; Vector "lo".
(assert_return (invoke "lane0" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000201))
(assert_return (invoke "lane1" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000403))
(assert_return (invoke "lane2" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000605))
(assert_return (invoke "lane3" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000807))
(assert_return (invoke "lane4" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000a09))
(assert_return (invoke "lane5" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000c0b))
(assert_return (invoke "lane6" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x00000e0d))
(assert_return (invoke "lane7" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x0000100f))
;; Vector "zff".
(assert_return (invoke "lane0" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane1" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane2" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane3" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane4" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane5" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane6" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
(assert_return (invoke "lane7" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0x0000ff00))
;; Vector "ffz".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x000000ff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x000000ff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x000000ff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x000000ff))
