;; Vector "mix".
(assert_return (invoke "lane0" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x0000807f))
(assert_return (invoke "lane1" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x000001fe))
