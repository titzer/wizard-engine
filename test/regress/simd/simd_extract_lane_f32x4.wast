;; Tests f32x4.extract_lane on vectors whose bytes next to the extracted lane are nonzero, so that any
;; upper bits left over from the vector in the result would show up.
;; Generated by gen_extract.py.

;; Every lane index, with the result returned directly. Floats are compared by bits.
(module
  (func (export "lane0") (param v128) (result i32) (i32.reinterpret_f32 (f32x4.extract_lane 0 (local.get 0))))
  (func (export "lane1") (param v128) (result i32) (i32.reinterpret_f32 (f32x4.extract_lane 1 (local.get 0))))
  (func (export "lane2") (param v128) (result i32) (i32.reinterpret_f32 (f32x4.extract_lane 2 (local.get 0))))
  (func (export "lane3") (param v128) (result i32) (i32.reinterpret_f32 (f32x4.extract_lane 3 (local.get 0))))
)
;; Vector "hi".
(assert_return (invoke "lane0" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x83828180))
(assert_return (invoke "lane1" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x87868584))
(assert_return (invoke "lane2" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x8b8a8988))
(assert_return (invoke "lane3" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x8f8e8d8c))
;; Vector "ones".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
;; Vector "lo".
(assert_return (invoke "lane0" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x04030201))
(assert_return (invoke "lane1" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x08070605))
(assert_return (invoke "lane2" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x0c0b0a09))
(assert_return (invoke "lane3" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x100f0e0d))
;; Vector "zff".
(assert_return (invoke "lane0" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane1" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane2" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane3" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
;; Vector "ffz".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
;; Vector "mix".
(assert_return (invoke "lane0" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x01fe807f))
(assert_return (invoke "lane1" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x7eff8100))
(assert_return (invoke "lane2" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x0080aa55))
(assert_return (invoke "lane3" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0xc37fff01))
