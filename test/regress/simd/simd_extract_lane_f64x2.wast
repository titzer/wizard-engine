;; Tests f64x2.extract_lane on vectors whose bytes next to the extracted lane are nonzero, so that any
;; upper bits left over from the vector in the result would show up.
;; Generated by gen_extract.py.

;; Every lane index, with the result returned directly. Floats are compared by bits.
(module
  (func (export "lane0") (param v128) (result i64) (i64.reinterpret_f64 (f64x2.extract_lane 0 (local.get 0))))
  (func (export "lane1") (param v128) (result i64) (i64.reinterpret_f64 (f64x2.extract_lane 1 (local.get 0))))
)
;; Vector "hi".
(assert_return (invoke "lane0" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i64.const 0x8786858483828180))
(assert_return (invoke "lane1" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i64.const 0x8f8e8d8c8b8a8988))
;; Vector "ones".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i64.const 0xffffffffffffffff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i64.const 0xffffffffffffffff))
;; Vector "lo".
(assert_return (invoke "lane0" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i64.const 0x0807060504030201))
(assert_return (invoke "lane1" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i64.const 0x100f0e0d0c0b0a09))
;; Vector "zff".
(assert_return (invoke "lane0" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i64.const 0xff00ff00ff00ff00))
(assert_return (invoke "lane1" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i64.const 0xff00ff00ff00ff00))
;; Vector "ffz".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i64.const 0x00ff00ff00ff00ff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i64.const 0x00ff00ff00ff00ff))
;; Vector "mix".
(assert_return (invoke "lane0" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i64.const 0x7eff810001fe807f))
(assert_return (invoke "lane1" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i64.const 0xc37fff010080aa55))
