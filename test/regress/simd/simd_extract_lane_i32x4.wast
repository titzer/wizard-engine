;; Tests i32x4.extract_lane on vectors whose bytes next to the extracted lane are nonzero, so that any
;; upper bits left over from the vector in the result would show up.
;; Generated by gen_extract.py.

;; Every lane index, with the result returned directly.
(module
  (func (export "lane0") (param v128) (result i32) (i32x4.extract_lane 0 (local.get 0)))
  (func (export "lane1") (param v128) (result i32) (i32x4.extract_lane 1 (local.get 0)))
  (func (export "lane2") (param v128) (result i32) (i32x4.extract_lane 2 (local.get 0)))
  (func (export "lane3") (param v128) (result i32) (i32x4.extract_lane 3 (local.get 0)))
)
;; Vector "hi".
(assert_return (invoke "lane0" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x83828180))
(assert_return (invoke "lane1" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x87868584))
(assert_return (invoke "lane2" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x8b8a8988))
(assert_return (invoke "lane3" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x8f8e8d8c))
;; Vector "ones".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff)) (i32.const 0xffffffff))
;; Vector "lo".
(assert_return (invoke "lane0" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x04030201))
(assert_return (invoke "lane1" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x08070605))
(assert_return (invoke "lane2" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x0c0b0a09))
(assert_return (invoke "lane3" (v128.const i8x16 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)) (i32.const 0x100f0e0d))
;; Vector "zff".
(assert_return (invoke "lane0" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane1" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane2" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
(assert_return (invoke "lane3" (v128.const i8x16 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff)) (i32.const 0xff00ff00))
;; Vector "ffz".
(assert_return (invoke "lane0" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane1" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane2" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
(assert_return (invoke "lane3" (v128.const i8x16 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00 0xff 0x00)) (i32.const 0x00ff00ff))
;; Vector "mix".
(assert_return (invoke "lane0" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x01fe807f))
(assert_return (invoke "lane1" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x7eff8100))
(assert_return (invoke "lane2" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0x0080aa55))
(assert_return (invoke "lane3" (v128.const i8x16 0x7f 0x80 0xfe 0x01 0x00 0x81 0xff 0x7e 0x55 0xaa 0x80 0x00 0x01 0xff 0x7f 0xc3)) (i32.const 0xc37fff01))

;; Results consumed by other instructions (shifts, arithmetic, 64-bit extension, locals,
;; calls, memory, globals), and extracts from splats with nonzero bytes above the lane.
(module
  (memory 1)
  (global $g (mut i32) (i32.const 0))
  (func $id64 (param i32) (result i64) (i64.extend_i32_u (local.get 0)))
  (func (export "lane0_ret") (param v128) (result i32) (local i32) (i32x4.extract_lane 0 (local.get 0)))
  (func (export "lane0_shr8") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 0 (local.get 0)) (i32.const 8)))
  (func (export "lane0_shr16") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 0 (local.get 0)) (i32.const 16)))
  (func (export "lane0_shr24") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 0 (local.get 0)) (i32.const 24)))
  (func (export "lane0_add") (param v128) (result i32) (local i32) (i32.add (i32x4.extract_lane 0 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane0_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i32x4.extract_lane 0 (local.get 0)) (i32.const 0xffff0000))))
  (func (export "lane0_ext64u") (param v128) (result i64) (local i32) (i64.extend_i32_u (i32x4.extract_lane 0 (local.get 0))))
  (func (export "lane0_ext64s") (param v128) (result i64) (local i32) (i64.extend_i32_s (i32x4.extract_lane 0 (local.get 0))))
  (func (export "lane0_local") (param v128) (result i32) (local i32) (local.set 1 (i32x4.extract_lane 0 (local.get 0))) (local.get 1))
  (func (export "lane0_call") (param v128) (result i64) (local i32) (call $id64 (i32x4.extract_lane 0 (local.get 0))))
  (func (export "lane0_mem") (param v128) (result i64) (local i32) (i64.store (i32.const 8) (i64.const -1)) (i32.store (i32.const 8) (i32x4.extract_lane 0 (local.get 0))) (i64.load (i32.const 8)))
  (func (export "lane0_global") (param v128) (result i32) (local i32) (global.set $g (i32x4.extract_lane 0 (local.get 0))) (global.get $g))
  (func (export "lane1_ret") (param v128) (result i32) (local i32) (i32x4.extract_lane 1 (local.get 0)))
  (func (export "lane1_shr8") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 1 (local.get 0)) (i32.const 8)))
  (func (export "lane1_shr16") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 1 (local.get 0)) (i32.const 16)))
  (func (export "lane1_shr24") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 1 (local.get 0)) (i32.const 24)))
  (func (export "lane1_add") (param v128) (result i32) (local i32) (i32.add (i32x4.extract_lane 1 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane1_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i32x4.extract_lane 1 (local.get 0)) (i32.const 0xffff0000))))
  (func (export "lane1_ext64u") (param v128) (result i64) (local i32) (i64.extend_i32_u (i32x4.extract_lane 1 (local.get 0))))
  (func (export "lane1_ext64s") (param v128) (result i64) (local i32) (i64.extend_i32_s (i32x4.extract_lane 1 (local.get 0))))
  (func (export "lane1_local") (param v128) (result i32) (local i32) (local.set 1 (i32x4.extract_lane 1 (local.get 0))) (local.get 1))
  (func (export "lane1_call") (param v128) (result i64) (local i32) (call $id64 (i32x4.extract_lane 1 (local.get 0))))
  (func (export "lane1_mem") (param v128) (result i64) (local i32) (i64.store (i32.const 8) (i64.const -1)) (i32.store (i32.const 8) (i32x4.extract_lane 1 (local.get 0))) (i64.load (i32.const 8)))
  (func (export "lane1_global") (param v128) (result i32) (local i32) (global.set $g (i32x4.extract_lane 1 (local.get 0))) (global.get $g))
  (func (export "lane2_ret") (param v128) (result i32) (local i32) (i32x4.extract_lane 2 (local.get 0)))
  (func (export "lane2_shr8") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 2 (local.get 0)) (i32.const 8)))
  (func (export "lane2_shr16") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 2 (local.get 0)) (i32.const 16)))
  (func (export "lane2_shr24") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 2 (local.get 0)) (i32.const 24)))
  (func (export "lane2_add") (param v128) (result i32) (local i32) (i32.add (i32x4.extract_lane 2 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane2_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i32x4.extract_lane 2 (local.get 0)) (i32.const 0xffff0000))))
  (func (export "lane2_ext64u") (param v128) (result i64) (local i32) (i64.extend_i32_u (i32x4.extract_lane 2 (local.get 0))))
  (func (export "lane2_ext64s") (param v128) (result i64) (local i32) (i64.extend_i32_s (i32x4.extract_lane 2 (local.get 0))))
  (func (export "lane2_local") (param v128) (result i32) (local i32) (local.set 1 (i32x4.extract_lane 2 (local.get 0))) (local.get 1))
  (func (export "lane2_call") (param v128) (result i64) (local i32) (call $id64 (i32x4.extract_lane 2 (local.get 0))))
  (func (export "lane2_mem") (param v128) (result i64) (local i32) (i64.store (i32.const 8) (i64.const -1)) (i32.store (i32.const 8) (i32x4.extract_lane 2 (local.get 0))) (i64.load (i32.const 8)))
  (func (export "lane2_global") (param v128) (result i32) (local i32) (global.set $g (i32x4.extract_lane 2 (local.get 0))) (global.get $g))
  (func (export "lane3_ret") (param v128) (result i32) (local i32) (i32x4.extract_lane 3 (local.get 0)))
  (func (export "lane3_shr8") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 3 (local.get 0)) (i32.const 8)))
  (func (export "lane3_shr16") (param v128) (result i32) (local i32) (i32.shr_u (i32x4.extract_lane 3 (local.get 0)) (i32.const 16)))
