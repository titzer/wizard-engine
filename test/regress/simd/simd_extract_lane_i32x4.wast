  (func (export "lane3_add") (param v128) (result i32) (local i32) (i32.add (i32x4.extract_lane 3 (local.get 0)) (i32.const 0x01000000)))
  (func (export "lane3_eqz") (param v128) (result i32) (local i32) (i32.eqz (i32.and (i32x4.extract_lane 3 (local.get 0)) (i32.const 0xffff0000))))
  (func (export "lane3_ext64u") (param v128) (result i64) (local i32) (i64.extend_i32_u (i32x4.extract_lane 3 (local.get 0))))
  (func (export "lane3_ext64s") (param v128) (result i64) (local i32) (i64.extend_i32_s (i32x4.extract_lane 3 (local.get 0))))
  (func (export "lane3_local") (param v128) (result i32) (local i32) (local.set 1 (i32x4.extract_lane 3 (local.get 0))) (local.get 1))
  (func (export "lane3_call") (param v128) (result i64) (local i32) (call $id64 (i32x4.extract_lane 3 (local.get 0))))
  (func (export "lane3_mem") (param v128) (result i64) (local i32) (i64.store (i32.const 8) (i64.const -1)) (i32.store (i32.const 8) (i32x4.extract_lane 3 (local.get 0))) (i64.load (i32.const 8)))
