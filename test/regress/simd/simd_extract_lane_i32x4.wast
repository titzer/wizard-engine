(assert_return (invoke "splat" (i32.const 0x000001ff)) (i32.const 0x000001ff))
(assert_return (invoke "splat" (i32.const 0x00018001)) (i32.const 0x00018001))
(assert_return (invoke "splat" (i32.const 0x7f7f7f80)) (i32.const 0x7f7f7f80))
(assert_return (invoke "splat" (i32.const 0x80808080)) (i32.const 0x80808080))
(assert_return (invoke "splat" (i32.const 0x12345678)) (i32.const 0x12345678))
(assert_return (invoke "splat" (i32.const 0xfffe0000)) (i32.const 0xfffe0000))
(assert_return (invoke "splat" (i32.const 0x0000ff00)) (i32.const 0x0000ff00))
