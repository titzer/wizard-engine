;; Tests i8x16.extract_lane_u on vectors whose bytes next to the extracted lane are nonzero, so that any
;; upper bits left over from the vector in the result would show up.
;; Generated by gen_extract.py.

;; Every lane index, with the result returned directly.
(module
  (func (export "lane0") (param v128) (result i32) (i8x16.extract_lane_u 0 (local.get 0)))
  (func (export "lane1") (param v128) (result i32) (i8x16.extract_lane_u 1 (local.get 0)))
  (func (export "lane2") (param v128) (result i32) (i8x16.extract_lane_u 2 (local.get 0)))
  (func (export "lane3") (param v128) (result i32) (i8x16.extract_lane_u 3 (local.get 0)))
  (func (export "lane4") (param v128) (result i32) (i8x16.extract_lane_u 4 (local.get 0)))
  (func (export "lane5") (param v128) (result i32) (i8x16.extract_lane_u 5 (local.get 0)))
  (func (export "lane6") (param v128) (result i32) (i8x16.extract_lane_u 6 (local.get 0)))
  (func (export "lane7") (param v128) (result i32) (i8x16.extract_lane_u 7 (local.get 0)))
  (func (export "lane8") (param v128) (result i32) (i8x16.extract_lane_u 8 (local.get 0)))
  (func (export "lane9") (param v128) (result i32) (i8x16.extract_lane_u 9 (local.get 0)))
  (func (export "lane10") (param v128) (result i32) (i8x16.extract_lane_u 10 (local.get 0)))
  (func (export "lane11") (param v128) (result i32) (i8x16.extract_lane_u 11 (local.get 0)))
  (func (export "lane12") (param v128) (result i32) (i8x16.extract_lane_u 12 (local.get 0)))
  (func (export "lane13") (param v128) (result i32) (i8x16.extract_lane_u 13 (local.get 0)))
  (func (export "lane14") (param v128) (result i32) (i8x16.extract_lane_u 14 (local.get 0)))
  (func (export "lane15") (param v128) (result i32) (i8x16.extract_lane_u 15 (local.get 0)))
)
;; Vector "hi".
(assert_return (invoke "lane0" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00000080))
(assert_return (invoke "lane1" (v128.const i8x16 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f)) (i32.const 0x00000081))
