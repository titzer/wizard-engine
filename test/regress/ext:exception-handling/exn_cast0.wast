;; ref.test / ref.cast on non-null and null exnrefs
(module
  (tag $e)
  (func $mkexn (result exnref)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (throw $e))
      (unreachable)
    )
  )
  (func (export "test-nonnull") (result i32) (ref.test (ref exn) (call $mkexn)))
  (func (export "test-nullable") (result i32) (ref.test exnref (call $mkexn)))
  (func (export "test-null") (result i32) (ref.test (ref exn) (ref.null exn)))
  (func (export "test-null-nullable") (result i32) (ref.test exnref (ref.null exn)))
  (func (export "test-noexn") (result i32) (ref.test (ref null noexn) (call $mkexn)))
  (func (export "cast-nullable") (result i32) (ref.is_null (ref.cast exnref (call $mkexn))))
  (func (export "cast-null") (result i32) (ref.is_null (ref.cast exnref (ref.null exn))))
  (func (export "cast-null-fail") (result i32) (ref.is_null (ref.cast (ref exn) (ref.null exn))))
)
(assert_return (invoke "test-nonnull") (i32.const 1))
(assert_return (invoke "test-nullable") (i32.const 1))
(assert_return (invoke "test-null") (i32.const 0))
(assert_return (invoke "test-null-nullable") (i32.const 1))
(assert_return (invoke "test-noexn") (i32.const 0))
(assert_return (invoke "cast-nullable") (i32.const 0))
(assert_return (invoke "cast-null") (i32.const 1))
(assert_trap (invoke "cast-null-fail") "cast failure")
