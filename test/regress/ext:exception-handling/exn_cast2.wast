;; a cast exnref can still be rethrown and caught with its payload
(module
  (tag $e (param i32))
  (func $mkexn (param i32) (result exnref)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (throw $e (local.get 0)))
      (unreachable)
    )
  )
  (func (export "rethrow-cast") (param i32) (result i32)
    (block $h (result i32)
      (try_table (catch $e $h)
        (throw_ref (ref.cast (ref exn) (call $mkexn (local.get 0))))
      )
      (unreachable)
    )
  )
)
(assert_return (invoke "rethrow-cast" (i32.const 42)) (i32.const 42))
(assert_return (invoke "rethrow-cast" (i32.const -7)) (i32.const -7))
