;; Reference-typed globals holding exceptions: caught with catch_ref, stored in a global, and
;; rethrown later with throw_ref, from both cold and hot (tiered-up) code.
(module
  (tag $t (param i32))
  (tag $u (param i64 i32))
  (global $e (mut exnref) (ref.null exn))
  (global $f (mut exnref) (ref.null exn))
  (global $n (mut nullexnref) (ref.null noexn))

  ;; Throws {$t(v)}, catches it as an exnref, and stores it in {$e}.
  (func $store_t (param $v i32)
    (block $h (result i32 exnref)
      (try_table (catch_ref $t $h) (throw $t (local.get $v)))
      (unreachable))
    (global.set $e)
    (drop))
  (func $store_u (param $a i64) (param $b i32)
    (block $h (result i64 i32 exnref)
      (try_table (catch_ref $u $h) (throw $u (local.get $a) (local.get $b)))
      (unreachable))
    (global.set $f)
    (drop) (drop))
  ;; Rethrows {$e} and returns the payload of the caught {$t}.
  (func $rethrow_t (result i32)
    (block $h (result i32)
      (try_table (catch $t $h) (throw_ref (global.get $e)))
      (unreachable)))
  (func $rethrow_u (result i64 i32)
    (block $h (result i64 i32)
      (try_table (catch $u $h) (throw_ref (global.get $f)))
      (unreachable)))

  (func (export "store_t") (param i32) (call $store_t (local.get 0)))
  (func (export "rethrow_t") (result i32) (call $rethrow_t))
  (func (export "store_u") (param i64 i32) (call $store_u (local.get 0) (local.get 1)))
  (func (export "rethrow_u") (result i64 i32) (call $rethrow_u))
  (func (export "e_is_null") (result i32) (ref.is_null (global.get $e)))
  (func (export "n_is_null") (result i32) (ref.is_null (global.get $n)))
  (func (export "clear") (global.set $e (ref.null exn)) (global.set $f (ref.null exn)))
  (func (export "copy_f_to_e") (global.set $e (global.get $f)))
  ;; Rethrowing {$e} when it holds a {$u} is caught by a catch_all.
  (func (export "rethrow_e_any") (result i32)
    (block $h
      (try_table (catch_all $h) (throw_ref (global.get $e)))
      (unreachable))
    (i32.const 1))
  ;; Stores and rethrows {n} times, each time with a different payload.
  (func (export "loop") (param $n i32) (result i32)
    (local $i i32)
    (loop $l
      (call $store_t (i32.mul (local.get $i) (i32.const 0x10001)))
      (if (i32.ne (call $rethrow_t) (i32.mul (local.get $i) (i32.const 0x10001))) (then (return (i32.add (local.get $i) (i32.const 1)))))
      (br_if $l (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
    (i32.const 0))
)

(assert_return (invoke "e_is_null") (i32.const 1))
(assert_return (invoke "n_is_null") (i32.const 1))
(assert_trap (invoke "rethrow_t") "null")
(invoke "store_t" (i32.const 42))
(assert_return (invoke "e_is_null") (i32.const 0))
(assert_return (invoke "rethrow_t") (i32.const 42))
(assert_return (invoke "rethrow_t") (i32.const 42))
(invoke "store_u" (i64.const -1) (i32.const 7))
(assert_return (invoke "rethrow_u") (i64.const -1) (i32.const 7))
(assert_return (invoke "rethrow_t") (i32.const 42))
(invoke "copy_f_to_e")
(assert_return (invoke "rethrow_e_any") (i32.const 1))
(invoke "clear")
(assert_return (invoke "e_is_null") (i32.const 1))
(assert_return (invoke "loop" (i32.const 100)) (i32.const 0))
(assert_return (invoke "rethrow_t") (i32.const 0x630063))
