;; br_on_cast / br_on_cast_fail with exnrefs
(module
  (tag $e)
  (func $mkexn (result exnref)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (throw $e))
      (unreachable)
    )
  )
  (func $on_cast (param exnref) (result i32)
    (block $l (result (ref exn))
      (br_on_cast $l exnref (ref exn) (local.get 0))
      (drop)
      (return (i32.const 0))
    )
    (drop)
    (i32.const 1)
  )
  (func $on_cast_fail (param exnref) (result i32)
    (block $l (result exnref)
      (br_on_cast_fail $l exnref (ref exn) (local.get 0))
      (drop)
      (return (i32.const 1))
    )
    (drop)
    (i32.const 0)
  )
  (func (export "br_on_cast-nonnull") (result i32) (call $on_cast (call $mkexn)))
  (func (export "br_on_cast-null") (result i32) (call $on_cast (ref.null exn)))
  (func (export "br_on_cast_fail-nonnull") (result i32) (call $on_cast_fail (call $mkexn)))
  (func (export "br_on_cast_fail-null") (result i32) (call $on_cast_fail (ref.null exn)))
)
(assert_return (invoke "br_on_cast-nonnull") (i32.const 1))
(assert_return (invoke "br_on_cast-null") (i32.const 0))
(assert_return (invoke "br_on_cast_fail-nonnull") (i32.const 1))
(assert_return (invoke "br_on_cast_fail-null") (i32.const 0))
