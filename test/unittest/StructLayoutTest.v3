def T = UnitTests.registerT("layout:", _, StructLayoutTester.new, _);
def X_ = void(
	T("empty", test_empty),
	T("prim_i8", test_prim_i8),
	T("prim_i16", test_prim_i16),
	T("prim_i32", test_prim_i32),
	T("prim_i64", test_prim_i64),
	T("prim_f32", test_prim_f32),
	T("prim_f64", test_prim_f64),
	T("prim_v128", test_prim_v128),
	T("prim_order", test_prim_order),
	T("ref", test_ref),
	T("ref_i31", test_ref_i31),
	T("ref_u64", test_ref_u64),
	T("ref_kinds", test_ref_kinds),
	T("mixed", test_mixed),
	T("header", test_header),
	T("byte_size", test_byte_size),
	T("extend", test_extend),
	T("extend2", test_extend2),
	T("word4", test_word4),
	T("limit", test_limit),
	T("big", test_big),
	T("refmap_i32", test_refmap_i32),
	T("check_ok", test_check_ok),
	T("check_bad", test_check_bad),
	()
);

def I8 = StorageType(ValueType.I32, Packedness.PACKED_I8, true);
def I16 = StorageType(ValueType.I32, Packedness.PACKED_I16, true);
def I32 = StorageType(ValueType.I32, Packedness.UNPACKED, true);
def I64 = StorageType(ValueType.I64, Packedness.UNPACKED, true);
def F32 = StorageType(ValueType.F32, Packedness.UNPACKED, true);
def F64 = StorageType(ValueType.F64, Packedness.UNPACKED, true);
def V128 = StorageType(ValueType.V128, Packedness.UNPACKED, true);
def ANYREF = StorageType(ValueTypes.ANYREF, Packedness.UNPACKED, true);
def EQREF = StorageType(ValueTypes.EQREF, Packedness.UNPACKED, true);
def I31REF = StorageType(ValueTypes.I31REF, Packedness.UNPACKED, true);
def EXTERNREF = StorageType(ValueTypes.EXTERNREF, Packedness.UNPACKED, true);
def STRUCTREF = StorageType(ValueTypes.STRUCTREF, Packedness.UNPACKED, true);
def ARRAYREF = StorageType(ValueTypes.ARRAYREF, Packedness.UNPACKED, true);
def FUNCREF = StorageType(ValueTypes.FUNCREF, Packedness.UNPACKED, true);
def CONTREF = StorageType(ValueTypes.CONTREF, Packedness.UNPACKED, true);
def NULLCONTREF = StorageType(ValueTypes.NULLCONTREF, Packedness.UNPACKED, true);

def U8 = NativeFieldKind.U8, U16 = NativeFieldKind.U16, U32 = NativeFieldKind.U32, U64 = NativeFieldKind.U64;
def F32K = NativeFieldKind.F32, F64K = NativeFieldKind.F64, V128K = NativeFieldKind.V128;
def REF = NativeFieldKind.REF, I31 = NativeFieldKind.I31REF, RU64 = NativeFieldKind.REF_U64;
def f(kind: NativeFieldKind, offset: int) -> NativeFieldInfo { return NativeFieldInfo(kind, u16.!(offset)); }
def HEADER = 0b11;	// runtime encoding of a one-word header holding a reference

class StructLayoutTester(t: Tester) {
	// Lays out {types} after a one-word header on a 64-bit word, where word 0 holds a reference.
	def hdr(types: Range<StorageType>) -> StructLayoutBuilder {
		return build(StructLayoutBuilder.new(8, 8, HEADER), types);
	}
	// Extends the layout {b} with more fields of {types}, the way a subtype's layout is computed.
	def ext(b: StructLayoutBuilder, types: Range<StorageType>) -> StructLayoutBuilder {
		var inherited = b.fields.copy();
		var sub = StructLayoutBuilder.new(8, b.size, b.getRefmapI32()).inherit(inherited);
		sub.extend(types[inherited.length ...]);
		return check(sub, types);
	}
	def build(b: StructLayoutBuilder, types: Range<StorageType>) -> StructLayoutBuilder {
		b.extend(types);
		return check(b, types);
	}
	def check(b: StructLayoutBuilder, types: Range<StorageType>) -> StructLayoutBuilder {
		var msg = b.check(types);
		if (msg != null) t.fail1("layout failed check: %s", msg);
		return b;
	}
	// Checks the aligned size, the reference words (bit {i} of {refs} for word {i}), and the fields.
	def assert_layout(b: StructLayoutBuilder, size: int, refs: u64, fields: Range<NativeFieldInfo>) {
		if (size != b.alignedSize()) t.fail2("expected size %d, got %s", size, render(b));
		for (i < 64) {
			var expected = ((refs >> u6.view(i)) & 1) != 0;
			if (expected != b.isRef(i)) t.fail2("word #%d has wrong reference bit in %s", i, render(b));
		}
		if (fields.length != b.fields.length) return t.fail2("expected %d fields, got %s", fields.length, render(b));
		for (i < fields.length) {
			if (fields[i] != b.fields[i]) t.fail2("field #%d has wrong info in %s", i, render(b));
		}
	}
	def render(b: StructLayoutBuilder) -> string {
		var buf = StringBuilder.new().put1("size=%d refs=", b.size);
		for (i < b.words()) buf.putc(if(b.isRef(i), '1', '0'));
		for (i < b.fields.length) buf.put2(" (%s, %d)", b.fields[i].kind.name, b.fields[i].offset);
		return buf.toString();
	}
	def sameTypes(n: int, st: StorageType) -> Array<StorageType> {
		var types = Array<StorageType>.new(n);
		for (i < n) types[i] = st;
		return types;
	}
}

def test_empty(t: StructLayoutTester) {
	var b = t.build(StructLayoutBuilder.new(8, 0, 0b1), []);
	t.assert_layout(b, 0, 0, []);
	t.t.assert_eq(0, b.words());
	b = t.hdr([]);
	t.assert_layout(b, 8, 0b1, []);
	t.t.assert_eq(8, b.size);
	t.t.assert_eq(1, b.words());
	// The aligned size is rounded up to whole words, but not the byte size.
	b = t.build(StructLayoutBuilder.new(8, 12, 0b110), []);
	t.assert_layout(b, 16, 0b10, []);
	t.t.assert_eq(12, b.size);
	t.t.assert_eq(2, b.words());
}
def test_prim_i8(t: StructLayoutTester) {
	t.assert_layout(t.hdr([I8]), 16, 0b1, [f(U8, 8)]);
	t.assert_layout(t.hdr([I8, I8, I8]), 16, 0b1, [f(U8, 8), f(U8, 9), f(U8, 10)]);
}
def test_prim_i16(t: StructLayoutTester) {
	t.assert_layout(t.hdr([I16]), 16, 0b1, [f(U16, 8)]);
	t.assert_layout(t.hdr([I16, I16]), 16, 0b1, [f(U16, 8), f(U16, 10)]);
}
def test_prim_i32(t: StructLayoutTester) {
	t.assert_layout(t.hdr([I32]), 16, 0b1, [f(U32, 8)]);
	t.assert_layout(t.hdr([I32, I32]), 16, 0b1, [f(U32, 8), f(U32, 12)]);
	t.assert_layout(t.hdr([I32, I32, I32]), 24, 0b1, [f(U32, 8), f(U32, 12), f(U32, 16)]);
}
def test_prim_i64(t: StructLayoutTester) {
	t.assert_layout(t.hdr([I64]), 16, 0b1, [f(U64, 8)]);
	t.assert_layout(t.hdr([I64, I64]), 24, 0b1, [f(U64, 8), f(U64, 16)]);
}
def test_prim_f32(t: StructLayoutTester) {
	t.assert_layout(t.hdr([F32]), 16, 0b1, [f(F32K, 8)]);
	t.assert_layout(t.hdr([F32, I32]), 16, 0b1, [f(F32K, 8), f(U32, 12)]);
}
def test_prim_f64(t: StructLayoutTester) {
	t.assert_layout(t.hdr([F64]), 16, 0b1, [f(F64K, 8)]);
	t.assert_layout(t.hdr([F32, F64]), 24, 0b1, [f(F32K, 8), f(F64K, 16)]);
}
def test_prim_v128(t: StructLayoutTester) {
	t.assert_layout(t.hdr([V128]), 24, 0b1, [f(V128K, 8)]);
	t.assert_layout(t.hdr([I8, V128, I32]), 40, 0b1, [f(U8, 8), f(V128K, 16), f(U32, 32)]);
}
def test_prim_order(t: StructLayoutTester) {
	// Fields are laid out in declaration order with natural alignment; padding is not reused.
	t.assert_layout(t.hdr([I8, I16, I32, I64]), 24, 0b1, [f(U8, 8), f(U16, 10), f(U32, 12), f(U64, 16)]);
	t.assert_layout(t.hdr([I64, I32, I16, I8]), 24, 0b1, [f(U64, 8), f(U32, 16), f(U16, 20), f(U8, 22)]);
	t.assert_layout(t.hdr([I8, I64, I8, I64]), 40, 0b1, [f(U8, 8), f(U64, 16), f(U8, 24), f(U64, 32)]);
	t.assert_layout(t.hdr([I8, I32, I8, I32, I16, I8]), 32, 0b1,
		[f(U8, 8), f(U32, 12), f(U8, 16), f(U32, 20), f(U16, 24), f(U8, 26)]);
	t.assert_layout(t.hdr([I32, I16, I8, I8, I64]), 24, 0b1,
		[f(U32, 8), f(U16, 12), f(U8, 14), f(U8, 15), f(U64, 16)]);
}
def test_ref(t: StructLayoutTester) {
	t.assert_layout(t.hdr([STRUCTREF]), 16, 0b11, [f(REF, 8)]);
	t.assert_layout(t.hdr([STRUCTREF, FUNCREF]), 24, 0b111, [f(REF, 8), f(REF, 16)]);
	t.assert_layout(t.hdr([STRUCTREF, I32]), 24, 0b11, [f(REF, 8), f(U32, 16)]);
	t.assert_layout(t.hdr([I32, STRUCTREF]), 24, 0b101, [f(U32, 8), f(REF, 16)]);
}
def test_ref_i31(t: StructLayoutTester) {
	// An anyref is a single reference word that may hold a tagged i31.
	t.assert_layout(t.hdr([ANYREF]), 16, 0b11, [f(I31, 8)]);
	t.assert_layout(t.hdr([ANYREF, ANYREF]), 24, 0b111, [f(I31, 8), f(I31, 16)]);
	t.assert_layout(t.hdr([I8, ANYREF, I32]), 32, 0b101, [f(U8, 8), f(I31, 16), f(U32, 24)]);
}
def test_ref_u64(t: StructLayoutTester) {
	// A contref is a reference word followed by a u64; only the first is a reference.
	t.assert_layout(t.hdr([CONTREF]), 24, 0b11, [f(RU64, 8)]);
	t.assert_layout(t.hdr([I32, CONTREF]), 32, 0b101, [f(U32, 8), f(RU64, 16)]);
	t.assert_layout(t.hdr([CONTREF, NULLCONTREF]), 40, 0b1011, [f(RU64, 8), f(RU64, 24)]);
}
def test_ref_kinds(t: StructLayoutTester) {
	// Types that may hold an i31 are distinguished from other references.
	t.assert_layout(t.hdr([EQREF]), 16, 0b11, [f(I31, 8)]);
	t.assert_layout(t.hdr([I31REF]), 16, 0b11, [f(I31, 8)]);
	t.assert_layout(t.hdr([EXTERNREF]), 16, 0b11, [f(I31, 8)]);
	t.assert_layout(t.hdr([ARRAYREF]), 16, 0b11, [f(REF, 8)]);
	t.assert_layout(t.hdr([FUNCREF]), 16, 0b11, [f(REF, 8)]);
}
def test_mixed(t: StructLayoutTester) {
	t.assert_layout(t.hdr([I32, ANYREF, I8, STRUCTREF, I64, CONTREF]), 64, 0b1010101,
		[f(U32, 8), f(I31, 16), f(U8, 24), f(REF, 32), f(U64, 40), f(RU64, 48)]);
}
def test_header(t: StructLayoutTester) {
	// A larger header, with references in words 0 and 2.
	t.assert_layout(t.build(StructLayoutBuilder.new(8, 24, 0b1101), [I32]), 32, 0b101, [f(U32, 24)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(8, 24, 0b1101), [STRUCTREF]), 32, 0b1101, [f(REF, 24)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(8, 24, 0b1101), [STRUCTREF, I32, FUNCREF]), 48, 0b101101, [f(REF, 24), f(U32, 32), f(REF, 40)]);
	// The terminator bit of the base is not a reference.
	var b = t.hdr([]);
	t.t.assertz(true, b.isRef(0));
	t.t.assertz(false, b.isRef(1));
	t.t.assertz(false, b.isRef(-1));
}
def test_byte_size(t: StructLayoutTester) {
	// Fields are appended from the byte size of the base, not from the next word.
	var b = t.build(StructLayoutBuilder.new(8, 12, 0b101), [I32]);
	t.assert_layout(b, 16, 0b1, [f(U32, 12)]);
	t.t.assert_eq(16, b.size);
	b = t.build(StructLayoutBuilder.new(8, 9, 0b101), [I16, I8]);
	t.assert_layout(b, 16, 0b1, [f(U16, 10), f(U8, 12)]);
	t.t.assert_eq(13, b.size);
	// References still start at the next word.
	b = t.build(StructLayoutBuilder.new(8, 12, 0b101), [I8, STRUCTREF]);
	t.assert_layout(b, 24, 0b101, [f(U8, 12), f(REF, 16)]);
	// A subtype packs into the supertype's last word.
	var sup = t.hdr([I32, I8]);
	t.assert_layout(sup, 16, 0b1, [f(U32, 8), f(U8, 12)]);
	t.t.assert_eq(13, sup.size);
	var sub = t.ext(sup, [I32, I8, I16, I8]);
	t.assert_layout(sub, 24, 0b1, [f(U32, 8), f(U8, 12), f(U16, 14), f(U8, 16)]);
	t.t.assert_eq(17, sub.size);
}
def test_extend(t: StructLayoutTester) {
	// The layout of a subtype extends the layout of the supertype, keeping inherited infos.
	var sup_types = [I32, STRUCTREF], sup = t.hdr(sup_types);
	t.assert_layout(sup, 24, 0b101, [f(U32, 8), f(REF, 16)]);

	var sub_types = [I32, STRUCTREF, I8, ANYREF], sub = t.ext(sup, sub_types);
	t.assert_layout(sub, 40, 0b10101, [f(U32, 8), f(REF, 16), f(U8, 24), f(I31, 32)]);
	t.t.assert_eq(40, sub.size);

	// Gaps in the supertype's layout are not filled.
	t.assert_layout(t.ext(sup, sub_types[0 ... 3]), 32, 0b101, [f(U32, 8), f(REF, 16), f(U8, 24)]);

	// A subtype with no additional fields has the same layout.
	t.assert_layout(t.ext(sup, sup_types), 24, 0b101, [f(U32, 8), f(REF, 16)]);
}
def test_extend2(t: StructLayoutTester) {
	// Three levels of extension yield the same layout as a single one.
	var types = [I64, I8, STRUCTREF, I16, ANYREF, FUNCREF];
	var expected = [f(U64, 8), f(U8, 16), f(REF, 24), f(U16, 32), f(I31, 40), f(REF, 48)];
	var l1 = t.hdr(types[0 ... 1]);
	t.assert_layout(l1, 16, 0b1, expected[0 ... 1]);
	var l2 = t.ext(l1, types[0 ... 4]);
	t.assert_layout(l2, 40, 0b1001, expected[0 ... 4]);
	t.t.assert_eq(34, l2.size);
	var l3 = t.ext(l2, types);
	t.assert_layout(l3, 56, 0b1101001, expected);
	t.assert_layout(t.ext(l1, types), 56, 0b1101001, expected);
	t.assert_layout(t.hdr(types), 56, 0b1101001, expected);
}
def test_word4(t: StructLayoutTester) {
	// On a 32-bit word, 8-byte primitives are only aligned to 4 bytes.
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [I64]), 12, 0b1, [f(U64, 4)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [I32]), 8, 0b1, [f(U32, 4)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [I8, I32]), 12, 0b1, [f(U8, 4), f(U32, 8)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [STRUCTREF, I8]), 12, 0b11, [f(REF, 4), f(U8, 8)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [I64, STRUCTREF, I32]), 20, 0b1001, [f(U64, 4), f(REF, 12), f(U32, 16)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [ANYREF, CONTREF]), 20, 0b111, [f(I31, 4), f(RU64, 8)]);
	t.assert_layout(t.build(StructLayoutBuilder.new(4, 4, 0b11), [V128]), 20, 0b1, [f(V128K, 4)]);
}
def test_limit(t: StructLayoutTester) {
	// The maximum of 31 words used by the native object model is where the 32-bit encoding stops.
	var b = t.hdr(t.sameTypes(30, I64));
	t.t.assert_eq(31, b.words());
	t.t.assert_eq(248, b.alignedSize());
	t.t.assert_eq(int.view(0x80000001u), b.getRefmapI32());
	b = t.hdr(t.sameTypes(31, I64));
	t.t.assert_eq(32, b.words());
	t.t.assert_eq(0, b.getRefmapI32());
	// Padding at the end counts too.
	var types = t.sameTypes(30, I64);
	types[29] = I8;
	b = t.hdr(types);
	t.t.assert_eq(31, b.words());
	t.t.assert_eq(241, b.size);
	// References count toward the limit.
	b = t.hdr(t.sameTypes(30, ANYREF));
	t.t.assert_eq(31, b.words());
	t.t.assert_eq(-1, b.getRefmapI32());
	for (i < 31) t.t.assertz(true, b.isRef(i));
	t.t.assertz(false, b.isRef(31));
	b = t.hdr(t.sameTypes(31, ANYREF));
	t.t.assert_eq(32, b.words());
	t.t.assert_eq(0, b.getRefmapI32());
	// Extending an existing layout over the limit.
	b = t.hdr(t.sameTypes(29, I64));
	t.t.assert_eq(31, t.ext(b, t.sameTypes(30, I64)).words());
	t.t.assert_eq(32, t.ext(b, t.sameTypes(31, I64)).words());
}
def test_big(t: StructLayoutTester) {
	// Layouts beyond 32 and 64 words are tracked, but cannot be encoded in 32 bits.
	var b = t.hdr(t.sameTypes(63, STRUCTREF));
	t.t.assert_eq(64, b.words());
	for (i < 64) t.t.assertz(true, b.isRef(i));
	t.t.assertz(false, b.isRef(64));
	t.t.assert_eq(0, b.getRefmapI32());

	b = t.hdr(t.sameTypes(100, STRUCTREF));
	t.t.assert_eq(101, b.words());
	for (i < 101) t.t.assertz(true, b.isRef(i));
	t.t.assertz(false, b.isRef(101));
	for (i < 100) t.t.assert_eq(f(REF, 8 + 8 * i), b.fields[i]);

	var types = t.sameTypes(200, I64);
	for (i < types.length) if (i % 3 == 2) types[i] = ANYREF;
	b = t.hdr(types);
	t.t.assert_eq(201, b.words());
	t.t.assert_eq(1608, b.size);
	for (i < 201) t.t.assertz(i == 0 || i % 3 == 0, b.isRef(i));
	t.t.assert_eq(0, b.getRefmapI32());

	b = t.hdr(t.sameTypes(1000, I64));
	t.t.assert_eq(1001, b.words());
	t.t.assert_eq(8008, b.size);
	t.t.assert_eq(f(U64, 8000), b.fields[999]);
	for (i = 1; i <= 1001; i++) t.t.assertz(false, b.isRef(i));
}
def test_refmap_i32(t: StructLayoutTester) {
	// The runtime encoding: bit {i} for word {i}, and the highest bit marks the end of the object.
	t.t.assert_eq(0b11, t.hdr([]).getRefmapI32());
	t.t.assert_eq(0b101, t.hdr([I32]).getRefmapI32());
	t.t.assert_eq(0b101, t.hdr([I8]).getRefmapI32());
	t.t.assert_eq(0b1001, t.hdr([I64, I64]).getRefmapI32());
	t.t.assert_eq(0b111, t.hdr([STRUCTREF]).getRefmapI32());
	t.t.assert_eq(0b1101, t.hdr([I32, STRUCTREF]).getRefmapI32());
	t.t.assert_eq(0b1011, t.hdr([STRUCTREF, I32]).getRefmapI32());
	t.t.assert_eq(0b1111, t.hdr([ANYREF, FUNCREF]).getRefmapI32());
	t.t.assert_eq(0b1011, t.hdr([CONTREF]).getRefmapI32());
	t.t.assert_eq(0b1001, t.hdr([V128]).getRefmapI32());
	// A base's map round-trips, and the terminator moves as fields are added.
	t.t.assert_eq(0b1101, t.build(StructLayoutBuilder.new(8, 24, 0b1101), []).getRefmapI32());
	t.t.assert_eq(0b10101, t.build(StructLayoutBuilder.new(8, 24, 0b1101), [I32]).getRefmapI32());
	t.t.assert_eq(0b11101, t.build(StructLayoutBuilder.new(8, 24, 0b1101), [STRUCTREF]).getRefmapI32());
	t.t.assert_eq(0b1, t.build(StructLayoutBuilder.new(8, 0, 0b1), []).getRefmapI32());
	t.t.assert_eq(0b10, t.build(StructLayoutBuilder.new(8, 0, 0b1), [I32]).getRefmapI32());
	t.t.assert_eq(0b11, t.build(StructLayoutBuilder.new(8, 0, 0b1), [STRUCTREF]).getRefmapI32());
	// The last representable sizes.
	var b = t.hdr(t.sameTypes(29, STRUCTREF));
	t.t.assert_eq(30, b.words());
	t.t.assert_eq(0x7FFFFFFF, b.getRefmapI32());
	b = t.hdr(t.sameTypes(29, I64));
	t.t.assert_eq(0x40000001, b.getRefmapI32());
	b = t.ext(b, t.sameTypes(30, I64));
	t.t.assert_eq(int.view(0x80000001u), b.getRefmapI32());
	// On a 32-bit word.
	t.t.assert_eq(0b11, t.build(StructLayoutBuilder.new(4, 4, 0b11), []).getRefmapI32());
	t.t.assert_eq(0b1001, t.build(StructLayoutBuilder.new(4, 4, 0b11), [I64]).getRefmapI32());
	t.t.assert_eq(0b10011, t.build(StructLayoutBuilder.new(4, 4, 0b11), [STRUCTREF, I64]).getRefmapI32());
}
def test_check_ok(t: StructLayoutTester) {
	// Hand-adjusted layouts that are consistent, though not what the builder would produce.
	var b = t.hdr([I32, STRUCTREF, I8, ANYREF, CONTREF]);
	b.fields[2] = f(U8, 12); // move the i8 into the padding after the i32
	t.t.assert(b.check([I32, STRUCTREF, I8, ANYREF, CONTREF]) == null, "expected layout to pass check");
	b = t.hdr([I64, I32]);
	b.fields[1] = f(U32, 20); // leave a gap
	t.t.assert(b.check([I64, I32]) == null, "expected layout to pass check");
	b = t.build(StructLayoutBuilder.new(8, 0, 0b1), [I32, STRUCTREF]);
	t.t.assert(b.check([I32, STRUCTREF]) == null, "expected layout to pass check");
}
def test_check_bad(t: StructLayoutTester) {
	def bad = t.t.assert(_, "expected layout to fail check");
	// Wrong storage kinds.
	bad(t.hdr([I32]).check([I64]) != null);
	bad(t.hdr([I32]).check([I8]) != null);
	bad(t.hdr([I64]).check([STRUCTREF]) != null);
	bad(t.hdr([STRUCTREF]).check([I32]) != null);
	bad(t.hdr([STRUCTREF]).check([ANYREF]) != null);
	bad(t.hdr([ANYREF]).check([CONTREF]) != null);
	bad(t.hdr([CONTREF]).check([ANYREF]) != null);
	// Wrong number of fields.
	bad(t.hdr([I32]).check([I32, I32]) != null);
	bad(t.hdr([I32, I32]).check([I32]) != null);
	var b: StructLayoutBuilder;
	// Out of bounds.
	b = t.hdr([I32]); b.fields[0] = f(U32, 16);
	bad(b.check([I32]) != null);
	b = t.hdr([STRUCTREF]); b.fields[0] = f(REF, 16);
	bad(b.check([STRUCTREF]) != null);
	b = t.hdr([I64, CONTREF]); b.fields[1] = f(RU64, 24);
	bad(b.check([I64, CONTREF]) != null);
	// Misaligned.
	b = t.hdr([I16, I16]); b.fields[1] = f(U16, 11);
	bad(b.check([I16, I16]) != null);
	b = t.hdr([I8, I32]); b.fields[1] = f(U32, 10);
	bad(b.check([I8, I32]) != null);
	b = t.hdr([I64, I64]); b.fields[1] = f(U64, 20);
	bad(b.check([I64, I64]) != null);
	b = t.hdr([I32, STRUCTREF]); b.fields[1] = f(REF, 12);
	bad(b.check([I32, STRUCTREF]) != null);
	// Overlapping.
	b = t.hdr([I32, I32]); b.fields[1] = f(U32, 8);
	bad(b.check([I32, I32]) != null);
	b = t.hdr([I64, I32]); b.fields[1] = f(U32, 12);
	bad(b.check([I64, I32]) != null);
	b = t.hdr([I8, I8]); b.fields[1] = f(U8, 8);
	bad(b.check([I8, I8]) != null);
	b = t.hdr([STRUCTREF, FUNCREF]); b.fields[1] = f(REF, 8);
	bad(b.check([STRUCTREF, FUNCREF]) != null);
	b = t.hdr([CONTREF, I64]); b.fields[1] = f(U64, 16);
	bad(b.check([CONTREF, I64]) != null);
	// Overlapping the base header.
	b = t.hdr([I32]); b.fields[0] = f(U32, 4);
	bad(b.check([I32]) != null);
	b = t.hdr([STRUCTREF]); b.fields[0] = f(REF, 0);
	bad(b.check([STRUCTREF]) != null);
	// A primitive in a reference word, or a reference in a non-reference word.
	b = t.hdr([STRUCTREF, I32]); b.fields[1] = f(U32, 12);
	bad(b.check([STRUCTREF, I32]) != null);
	b = t.hdr([I64, STRUCTREF]); b.fields[1] = f(REF, 8);
	bad(b.check([I64, STRUCTREF]) != null);
	b = t.hdr([I64, ANYREF]); b.fields[1] = f(I31, 8);
	bad(b.check([I64, ANYREF]) != null);
	// A reference word that no field uses.
	b = t.hdr([STRUCTREF, I64]); b.fields[0] = f(REF, 16); b.fields[1] = f(U64, 24);
	bad(b.check([STRUCTREF, I64]) != null);
	b = t.hdr([STRUCTREF, I64]); b.fields[0] = f(U64, 16); b.fields[1] = f(U64, 24);
	bad(b.check([I64, I64]) != null);
}
