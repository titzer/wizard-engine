def T = UnitTests.register;
def X_ = void(
	T("TraceUtil:renderFraction", test_renderFraction),
	T("TraceUtil:renderPercent", test_renderPercent),
	()
);

def render(t: Tester, f: (StringBuilder, long, long, int) -> int, dividend: long, divisor: long, prec: int) -> string {
	var sb = StringBuilder.new().puts("x"); // check that returned length is relative to existing contents
	var len = f(sb, dividend, divisor, prec);
	var str = sb.extract();
	t.asserti(str.length - 1, len);
	return Arrays.range(str, 1, str.length);
}

def test_renderFraction(t: Tester) {
	def F = render(t, TraceUtil.renderFraction, _, _, _);
	t.assert_string("0.25", F(1, 4, 2));
	t.assert_string("0.2", F(1, 4, 1));
	t.assert_string("0.2500", F(1, 4, 4));
	t.assert_string("0", F(1, 4, 0));
	t.assert_string("3", F(7, 2, 0));
	t.assert_string("3.5", F(7, 2, 1));
	t.assert_string("0.3333", F(1, 3, 4));
	t.assert_string("0.666", F(2, 3, 3));	// truncates
	t.assert_string("12.000", F(12, 1, 3));
	t.assert_string("0.000", F(0, 7, 3));
	t.assert_string("3", F(7, 2, -1));

	// negative numbers
	t.assert_string("-0.25", F(-1, 4, 2));
	t.assert_string("-0.25", F(1, -4, 2));
	t.assert_string("0.25", F(-1, -4, 2));
	t.assert_string("-3.5", F(-7, 2, 1));
	t.assert_string("-3", F(-7, 2, 0));
	t.assert_string("-12.000", F(-12, 1, 3));
	t.assert_string("0.00", F(-1, 1000, 2));	// no negative zero
	t.assert_string("0", F(-1, 2, 0));

	// extremes that previously overflowed
	t.assert_string("9223372036854775807.00", F(long.max, 1, 2));
	t.assert_string("-9223372036854775808.0", F(long.min, 1, 1));
	t.assert_string("9223372036854775808.0", F(long.min, -1, 1));
	t.assert_string("1.000", F(long.max, long.max, 3));
	t.assert_string("0.999", F(long.max - 1, long.max, 3));
	t.assert_string("-1.000", F(long.min, long.max, 3) );
	t.assert_string("0.00000000000000000010", F(1, long.max, 20));
	t.assert_string("0.33333333333333333333", F(1, 3, 20));
	t.assert_string("4611686018427387903.5", F(long.max, 2, 1));
	t.assert_string("0.4999999999999999999", F(long.max / 2, long.max, 19));

	// zero divisor
	t.assert_string("NaN", F(0, 0, 2));
	t.assert_string("inf", F(1, 0, 2));
	t.assert_string("-inf", F(-1, 0, 2));
}

def test_renderPercent(t: Tester) {
	def P = render(t, TraceUtil.renderPercent, _, _, _);
	t.assert_string("0.000%", P(0, 1, 3));
	t.assert_string("100.000%", P(1, 1, 3));
	t.assert_string("100.00%", P(5, 5, 2));
	t.assert_string("50.0%", P(1, 2, 1));
	t.assert_string("42.85%", P(3, 7, 2));	// truncates
	t.assert_string("33.33%", P(1, 3, 2));
	t.assert_string("0.5%", P(1, 200, 1));
	t.assert_string("0.1%", P(1, 1000, 1));
	t.assert_string("0.0%", P(1, 1001, 1));
	t.assert_string("5%", P(1, 20, 0));
	t.assert_string("0%", P(5, 1000, 0));
	t.assert_string("250.0%", P(5, 2, 1));
	t.assert_string("1000%", P(10, 1, 0));

	// negative numbers
	t.assert_string("-25.0%", P(-1, 4, 1));
	t.assert_string("-25.0%", P(1, -4, 1));
	t.assert_string("25.0%", P(-1, -4, 1));
	t.assert_string("-42.85%", P(-3, 7, 2));
	t.assert_string("-0.5%", P(-1, 200, 1));
	t.assert_string("-100.000%", P(-1, 1, 3));
	t.assert_string("0.0%", P(-1, 1001, 1));	// no negative zero
	t.assert_string("-5%", P(-1, 20, 0));

	// extremes that previously overflowed
	t.assert_string("100.00%", P(long.max, long.max, 2));
	t.assert_string("99.99%", P(long.max - 1, long.max, 2));
	t.assert_string("922337203685477580700%", P(long.max, 1, 0));
	t.assert_string("-922337203685477580800.0%", P(long.min, 1, 1));
	t.assert_string("50.000%", P(long.max / 2 + 1, long.max, 3));

	// zero divisor
	t.assert_string("NaN%", P(0, 0, 2));
	t.assert_string("inf%", P(3, 0, 2));
	t.assert_string("-inf%", P(-3, 0, 2));
}
