	0x7f, 0x1f, 0x40, 0x01, 0x00, 0x03, 0x00, 0x20, 0x00, 0xe3, 0x05, 0x00, 0x1a, 0x0b, 0x41, 0x7f,
	0x0b, 0x0b, 0x87, 0x80, 0x80, 0x80, 0x00, 0x00, 0xd0, 0x05, 0xe3, 0x05, 0x00, 0x0b,

];

private class StackCompressionTester(t: Tester, tiering: ExecutionStrategy) {
	def saved_max = StackTuning.maxStacks;
	def saved_compression = StackTuning.enableCompression;
	def saved_lazy = StackTuning.lazyEntryStacks;
	var held: Array<NativeStack>;	// stacks pinned by {limit}
	var instance: Instance;
	var limit_total = -1;

	new() { Execute.tiering = tiering; }

	def restore() {
		StackTuning.maxStacks = saved_max;
		StackTuning.enableCompression = saved_compression;
		StackTuning.lazyEntryStacks = saved_lazy;
		limit_total = -1;
	}
	// Pins all existing segments, then allows at most {extra} more, so that only stacks
	// created by the test are candidates for reclamation or compression.
	def limit(extra: int) {
		StackTuning.maxStacks = M.total;
		M.cache = null;
		Target.forceGC();
		var free = 0;
		for (seg = M.all; seg != null; seg = seg.next) if (seg.stack.get() == null) free++;
		held = Array<NativeStack>.new(free);
		for (i < free) held[i] = M.getFreshStack();
		StackTuning.maxStacks = M.total + extra;
		limit_total = StackTuning.maxStacks;
	}
	def compressing(extra: int) {
		StackTuning.enableCompression = true;
		limit(extra);
	}
	def checkInvariants(where: string) {
		var count = 0;
		for (seg = M.all; seg != null; seg = seg.next) {
			count++;
			var s = seg.stack.get();
			if (s == null) continue;
			if (s.range != seg) t.fail1("%s: owning stack does not point back at its segment", where);
			if (s.state() == StackState.COMPRESSED) t.fail1("%s: compressed stack owns a segment", where);
		}
		if (count != M.total) t.fail1("%s: segment count mismatch", where);
		if (limit_total >= 0 && M.total > limit_total) t.fail3("%s: expected at most %d segments, got %d", where, limit_total, M.total);
	}
	def assertState(expected: StackState, s: NativeStack) {
		var got = s.state();
		if (got != expected) t.fail2("expected state %s, got %s", expected.name, got.name);
		var compressed = got == StackState.COMPRESSED;
		if (compressed != (s.range == null)) t.fail("expected a stack to have a segment iff not compressed");
		if (!compressed && s.compressed != null) t.fail("expected no compressed data if not compressed");
	}
	def assertResult(expected: Result, got: Result) {
		if (!expected.equals(got)) t.fail2("expected %q, got %q", expected.render, got.render);
	}
	def assertCompress(s: NativeStack) {
		if (s == null) return t.fail("expected a stack, got null");
		if (!M.compressStack(s)) return t.fail1("expected stack in state %s to be compressible", s.state().name);
		assertState(StackState.COMPRESSED, s);
	}
	// A Wasm function [i32, i32] -> [i32] that subtracts its arguments.
	def subFunc() -> WasmFunction {
		var b = ModuleBuilder.new();
		b.sig(SigCache.ii_i).code([
			u8.!(Opcode.LOCAL_GET.code), 0,
			u8.!(Opcode.LOCAL_GET.code), 1,
			u8.!(Opcode.I32_SUB.code)
		]);
		var err = ErrorGen.new("subFunc");
		var inst = Instantiator.new(Extension.set.all, b.module, [], err).run();
		return WasmFunction.!(inst.functions[0]);
	}
	// Instantiates {GEN_MODULE} for this tester's tier.
	def gen() -> this {
		if (instance != null) return;
		var err = ErrorGen.new("GEN_MODULE");
		var limits = Limits.new().set(Extension.set.all);
		var bp = BinParser.new(Extension.set.all, limits, err, "GEN_MODULE");
		bp.tiering = tiering;
		var module = bp.push(GEN_MODULE, 0, GEN_MODULE.length).finish();
		if (!err.ok()) return t.fail(err.error_msg);
		instance = Instantiator.new(Extension.set.all, module, [], err).run();
		if (!err.ok()) return t.fail(err.error_msg);
		tiering.onTestModule(module);
		for (f in instance.functions) {
			if (WasmFunction.?(f)) tiering.onTestRun(WasmFunction.!(f), err);
		}
		if (!err.ok()) return t.fail(err.error_msg);
	}
	def call(name: string, args: Array<Value>) -> Result {
		gen();
		for (i < instance.module.exports.length) {
			if (Strings.equal(name, instance.module.exports[i].0)) {
				return Execute.call(Function.!(instance.exports[i]), args);
			}
		}
		t.fail1("export %s not found", name);
		return Result.Value([]);
	}
	def callCont(name: string, args: Array<Value>) -> Continuation {
		var r = call(name, args);
		match (r) {
			Value(vals) => if (vals.length == 1 && Value.Cont.?(vals[0])) return Value.Cont.!(vals[0]).val;
			_ => ;
		}
		t.fail2("expected %s to return a continuation, got %q", name, r.render);
		return Continuations.NULL;
	}
	def exported(name: string) -> Function {
		gen();
		for (i < instance.module.exports.length) {
			if (Strings.equal(name, instance.module.exports[i].0)) return Function.!(instance.exports[i]);
		}
		t.fail1("export %s not found", name);
		return null;
	}
	def assertTrap(reason: TrapReason, r: Result) {
		match (r) {
			Throw(thrown) => if (Trap.?(thrown) && Trap.!(thrown).reason == reason) return;
			_ => ;
		}
		t.fail2("expected trap %s, got %q", reason.name, r.render);
	}
	def callInt(name: string, args: Array<Value>) -> int {
		var r = call(name, args);
		match (r) {
			Value(vals) => if (vals.length == 1 && Value.I32.?(vals[0])) return int.view(Value.I32.!(vals[0]).val);
			_ => ;
		}
		t.fail2("expected %s to return an i32, got %q", name, r.render);
		return -1;
	}
	// Makes a generator yielding {start} .. {start + 9}, suspended at its first yield.
	def make(start: int) -> Continuation {
		var k = callCont("make", [Values.box_i(start)]);
		if (!Continuations.isNull(k)) assertLast(start);
		return k;
	}
	// Steps a generator, which must yield {expected}, or finish if {expected < 0}.
	def next(k: Continuation, expected: int) -> Continuation {
		var n = callCont("next", [Value.Cont(k)]);
		if (expected < 0) {
			if (!Continuations.isNull(n)) t.fail("expected generator to finish");
		} else {
			if (Continuations.isNull(n)) t.fail1("expected generator to yield %d, but it finished", expected);
			else assertLast(expected);
		}
		return n;
	}
	def assertLast(expected: int) {
		var got = callInt("last", []);
		if (got != expected) t.fail2("expected generator to yield %d, got %d", expected, got);
	}
	def stackOf(k: Continuation) -> NativeStack {
		return NativeStack.!(k.stack);
	}
}

// Runs a test, then restores global settings and checks invariants.
def runTest(f: StackCompressionTester -> void, t: StackCompressionTester) {
	f(t);
	t.checkInvariants("end of test");
	t.restore();
}

def EMPTY_STRUCT = StructDecl.new(false, ValueTypes.NO_HEAPTYPES, []);
def obj() -> Value { return Value.Ref(ObjectModel.newStruct(EMPTY_STRUCT)); }

def test_can_compress_states(t: StackCompressionTester) {
	var f = t.subFunc();
	var s = M.getFreshStack();
	t.assertState(StackState.EMPTY, s);
	if (C.canCompress(s)) t.t.fail("expected EMPTY stack not to be compressible");
	s.reset(f);
	t.assertState(StackState.SUSPENDED, s);
	if (!C.canCompress(s)) t.t.fail("expected SUSPENDED stack to be compressible");
	s.bind([Values.box_i(9)]);
	if (!C.canCompress(s)) t.t.fail("expected SUSPENDED stack with bound values to be compressible");
	t.assertCompress(s);
	if (C.canCompress(s)) t.t.fail("expected COMPRESSED stack not to be compressible");
	if (M.compressStack(s)) t.t.fail("expected compressing a COMPRESSED stack to fail");
	C.decompress(s);
	t.assertState(StackState.SUSPENDED, s);
	if (!C.canCompress(s)) t.t.fail("expected decompressed stack to be compressible again");
	t.assertResult(Result.Value([Values.box_i(5)]), s.bind([Values.box_i(4)]).resume());
	t.assertState(StackState.EMPTY, s);
}

def test_roundtrip_entry(t: StackCompressionTester) {
	var f = t.subFunc();
	var s = M.getFreshStack().reset(f).bind([Values.box_i(100), Values.box_i(1)]);
	var before = (C.numCompressed, C.numDecompressed);
	t.assertCompress(s);
	t.t.assert_eq(before.0 + 1, C.numCompressed);
	t.assertResult(Result.Value([Values.box_i(99)]), s.resume()); // decompresses
	t.t.assert_eq(before.1 + 1, C.numDecompressed);
}

def test_roundtrip_entry_bind(t: StackCompressionTester) {
	var f = t.subFunc();
	var s = M.getFreshStack().reset(f).bind([Values.box_i(50)]);
	t.assertCompress(s);
	s.bind([Values.box_i(8)]); // binds without decompressing
	t.assertState(StackState.COMPRESSED, s);
	t.assertResult(Result.Value([Values.box_i(42)]), s.resume());
}

def test_roundtrip_refs_gc(t: StackCompressionTester) {
	var b = ModuleBuilder.new();
	var sig = b.newSig([ValueTypes.ANYREF, ValueTypes.ANYREF], [ValueTypes.ANYREF, ValueTypes.ANYREF]);
	b.sig(sig).code([u8.!(Opcode.LOCAL_GET.code), 1, u8.!(Opcode.LOCAL_GET.code), 0]);
	var err = ErrorGen.new("swap");
	var f = Instantiator.new(Extension.set.all, b.module, [], err).run().functions[0];
	var a = obj(), c = obj();
	var s = M.getFreshStack().reset(f).bind([a, c]);
	t.assertCompress(s);
	for (i < 3) Target.forceGC(); // the compressed values must keep the objects alive (and be updated)
	t.assertResult(Result.Value([c, a]), s.resume());
}

def test_victim_suspended_only(t: StackCompressionTester) {
	var f = t.subFunc();
	t.compressing(4);
	var empty = M.getFreshStack();
	var s1 = M.getFreshStack().reset(f).bind([Values.box_i(10), Values.box_i(1)]);
	var s2 = M.getFreshStack().reset(f).bind([Values.box_i(20), Values.box_i(2)]);
	var s3 = M.getFreshStack().reset(f).bind([Values.box_i(30), Values.box_i(3)]);
	// All segments are now owned; the next allocation must compress a SUSPENDED stack.
	var fresh = M.getFreshStack();
	t.assertState(StackState.EMPTY, empty);
	t.assertState(StackState.EMPTY, fresh);
	var compressed = 0;
	for (s in [s1, s2, s3]) if (s.state() == StackState.COMPRESSED) compressed++;
	t.t.assert_eq(1, compressed);
	t.checkInvariants("victim");
	t.assertResult(Result.Value([Values.box_i(9)]), s1.resume());
	t.assertResult(Result.Value([Values.box_i(18)]), s2.resume());
	t.assertResult(Result.Value([Values.box_i(27)]), s3.resume());
}

def test_victim_round_robin(t: StackCompressionTester) {
	var f = t.subFunc();
	t.compressing(4);
	var stacks = Array<NativeStack>.new(4);
	for (i < stacks.length) stacks[i] = M.getFreshStack().reset(f).bind([Values.box_i(i), Values.box_i(0)]);
	// Each further allocation compresses a different stack.
	var fresh = Array<NativeStack>.new(4);
	for (i < fresh.length) {
		fresh[i] = M.getFreshStack();
		var compressed = 0;
		for (s in stacks) if (s.state() == StackState.COMPRESSED) compressed++;
		t.t.assert_eq(i + 1, compressed);
	}
	for (i < stacks.length) t.assertResult(Result.Value([Values.box_i(i)]), stacks[i].resume());
}

def test_victim_not_recycled(t: StackCompressionTester) {
	var f = t.subFunc();
	t.compressing(2);
	var a = M.getFreshStack().reset(f).bind([Values.box_i(7), Values.box_i(2)]);
	var b = M.getFreshStack().reset(f);
	M.recycleStack(b); // a recycled stack is cleared, so never compressed
	t.assertState(StackState.EMPTY, b);
	var c = M.getFreshStack();
	if (c != b) t.t.fail("expected the recycled stack to be reused");
	t.assertState(StackState.SUSPENDED, a);
	var d = M.getFreshStack(); // must compress {a}, the only SUSPENDED stack
	t.assertState(StackState.COMPRESSED, a);
	t.assertState(StackState.EMPTY, d);
	if (d == a || d == c) t.t.fail("expected a new stack for the compressed segment");
	t.assertResult(Result.Value([Values.box_i(5)]), a.resume());
}

def test_decompress_compresses_other(t: StackCompressionTester) {
	var f = t.subFunc();
	t.compressing(2);
	var a = M.getFreshStack().reset(f).bind([Values.box_i(100), Values.box_i(1)]);
	var b = M.getFreshStack().reset(f).bind([Values.box_i(200), Values.box_i(2)]);
	t.assertCompress(a);
	var hold = M.getFreshStack(); // takes the segment freed by {a}
	// Decompressing {a} requires a segment, which can only come from compressing {b}.
	C.decompress(a);
	t.assertState(StackState.SUSPENDED, a);
	t.assertState(StackState.COMPRESSED, b);
	t.assertState(StackState.EMPTY, hold);
	t.checkInvariants("ping");
	t.assertResult(Result.Value([Values.box_i(99)]), a.resume());
	t.assertResult(Result.Value([Values.box_i(198)]), b.resume());
}

def test_disabled_no_compress(t: StackCompressionTester) {
	var f = t.subFunc();
	StackTuning.enableCompression = false;
	t.limit(3);
	var a = M.getFreshStack().reset(f);
	var b = M.getFreshStack().reset(f);
	var dropped = allocAndDrop(f);
	var c = M.getFreshStack(); // must come from the dead stack, never compression
	if (c.range.start != dropped) t.t.fail("expected the dead stack's segment to be reclaimed");
	t.assertState(StackState.SUSPENDED, a);
	t.assertState(StackState.SUSPENDED, b);
	t.assertState(StackState.EMPTY, c);
}

def allocAndDrop(f: Function) -> Pointer #no-inline {
	return M.getFreshStack().reset(f).range.start;
}

def test_mid_explicit(t: StackCompressionTester) {
	var k = t.make(100);
	var s = t.stackOf(k);
	t.assertState(StackState.SUSPENDED, s);
	t.assertCompress(s); // three frames deep, with v128 and struct locals
	k = t.next(k, 101); // Wasm resume decompresses
	if (t.stackOf(k) != s) t.t.fail("expected the continuation to keep its stack");
	t.assertState(StackState.SUSPENDED, s);
	for (i = 2; i < 10; i++) {
		t.assertCompress(t.stackOf(k));
		k = t.next(k, 100 + i);
	}
	t.assertCompress(t.stackOf(k));
	t.next(k, -1);
}

def test_mid_twice(t: StackCompressionTester) {
	var k = t.make(7);
	var s = t.stackOf(k);
	t.assertCompress(s);
	C.decompress(s);
	t.assertCompress(s);
	for (i < 3) Target.forceGC();
	k = t.next(k, 8);
	k = t.next(k, 9);
}

def test_mid_host_resume(t: StackCompressionTester) {
	var k = t.callCont("make_once", [Values.box_i(5)]);
	var s = t.stackOf(k);
	t.assertCompress(s);
	t.assertResult(Result.Value([Values.box_i(1005)]), s.resume());
}

def test_mid_host_bind(t: StackCompressionTester) {
	var k = t.callCont("make_asker", [Values.box_i(4)]);
	var s = t.stackOf(k);
	t.assertCompress(s);
	s.bind([Values.box_i(2)]);
	t.assertResult(Result.Value([Values.box_i(42)]), s.resume());
}

def test_mid_wasm_bind(t: StackCompressionTester) {
	var k = t.callCont("make_asker", [Values.box_i(3)]);
	t.assertCompress(t.stackOf(k));
	t.t.assert_eq(37, t.callInt("answer", [Value.Cont(k), Values.box_i(7)])); // cont.bind decompresses
}

def test_mid_gc(t: StackCompressionTester) {
	var gens = Array<Continuation>.new(8);
	for (i < gens.length) {
		gens[i] = t.make(i * 10);
		t.assertCompress(t.stackOf(gens[i]));
	}
	for (i < 3) Target.forceGC();
	for (j = 1; j < 10; j++) {
		for (i < gens.length) {
			gens[i] = t.next(gens[i], i * 10 + j);
			if ((i + j) % 2 == 0) t.assertCompress(t.stackOf(gens[i]));
		}
		Target.forceGC();
	}
	for (i < gens.length) t.next(gens[i], -1);
}

// Steps {n} generators round-robin to completion under a limit of {extra} segments.
def roundRobin(t: StackCompressionTester, n: int, extra: int) {
	t.gen();
	t.compressing(extra);
	var before = (C.numCompressed, C.numDecompressed);
	var gens = Array<Continuation>.new(n);
	for (i < n) gens[i] = t.make(i * 100);
	for (j = 1; j < 10; j++) {
		for (i < n) gens[i] = t.next(gens[i], i * 100 + j);
	}
	for (i < n) t.next(gens[i], -1);
	if (C.numCompressed <= before.0) t.t.fail("expected stacks to be compressed");
	if (C.numDecompressed <= before.1) t.t.fail("expected stacks to be decompressed");
	t.checkInvariants("round robin");
}

def test_gens_round_robin(t: StackCompressionTester) {
	roundRobin(t, 20, 4);
}

def test_gens_many(t: StackCompressionTester) {
	roundRobin(t, 500, 8);
}

def test_gens_limit_one(t: StackCompressionTester) {
	// Each call runs on its own stack and the generator needs another; one more suffices for decompression.
	roundRobin(t, 10, 3);
}

def test_no_frames_not_compressible(t: StackCompressionTester) {
	var s = M.getFreshStack().resetForFrameWrites(t.subFunc());
	t.assertState(StackState.SUSPENDED, s);
	if (C.canCompress(s)) t.t.fail("expected a stack with no frames and no entry not to be compressible");
	s.clear();
}

def test_running_not_compressible(t: StackCompressionTester) {
	// Inside a host call, the running stack cannot be compressed.
	var hf = HostFunction.new("check", SigCache.v_i, checkRunning(t, _));
	t.assertResult(Result.Value([Values.box_i(7)]), M.runOnFreshStack(hf, []));
}
def checkRunning(t: StackCompressionTester, args: Range<Value>) -> HostResult {
	var cur = X86_64Runtime.curStack;
	if (C.canCompress(cur)) t.t.fail1("expected %s stack not to be compressible", cur.state().name);
	if (M.compressStack(cur)) t.t.fail("expected compressing the running stack to fail");
	return HostResult.Value1(Values.box_i(7));
}

def test_entry_host_func(t: StackCompressionTester) {
	var hf = HostFunction.new("add", SigCache.ii_i, fun args => HostResult.Value1(Values.box_i(Values.unbox_i(args[0]) + Values.unbox_i(args[1]))));
	var s = M.getFreshStack().reset(hf).bind([Values.box_i(30)]);
	t.assertCompress(s);
	t.assertResult(Result.Value([Values.box_i(42)]), s.bind([Values.box_i(12)]).resume());
}

def test_repeat_roundtrip(t: StackCompressionTester) {
	var f = t.subFunc();
	var s = M.getFreshStack().reset(f).bind([Values.box_i(1000)]);
	var before = (C.numCompressed, C.numDecompressed);
	for (i < 50) {
		t.assertCompress(s);
		C.decompress(s);
		t.assertState(StackState.SUSPENDED, s);
		if ((i % 10) == 0) Target.forceGC();
	}
	t.t.assert_eq(before.0 + 50, C.numCompressed);
	t.t.assert_eq(before.1 + 50, C.numDecompressed);
	t.checkInvariants("roundtrip");
	t.assertResult(Result.Value([Values.box_i(999)]), s.bind([Values.box_i(1)]).resume());
}

def test_chain_top(t: StackCompressionTester) {
	// The continuation's top stack runs {inner}, whose parent {mid} waits for it.
	var k = t.callCont("make_chain", [Values.box_i(5)]);
	var top = t.stackOf(k);
	var mid = NativeStack.!(top.parent);
	if (mid == null) return t.t.fail("expected the continuation to be a chain of stacks");
	t.assertState(StackState.CALL_CHILD, mid);
	if (M.compressStack(mid)) t.t.fail("expected the waiting parent not to be compressible");
	t.assertCompress(top);
	for (i < 3) Target.forceGC();
	t.t.assert_eq(11, t.callInt("finish", [Value.Cont(k)]));
}

def test_chains_under_limit(t: StackCompressionTester) {
	t.gen();
	var n = 10;
	// The waiting parents cannot be compressed, so leave room for them.
	t.compressing(n + 4);
	var before = C.numCompressed;
	var chains = Array<Continuation>.new(n);
	for (i < n) chains[i] = t.callCont("make_chain", [Values.box_i(i)]);
	for (i < n) { // some tops may already have been compressed to make room
		var top = t.stackOf(chains[i]);
		if (top.state() == StackState.SUSPENDED) t.assertCompress(top);
		t.assertState(StackState.COMPRESSED, top);
		t.assertState(StackState.CALL_CHILD, NativeStack.!(top.parent));
	}
	for (i = n - 1; i >= 0; i--) t.t.assert_eq(2 * i + 1, t.callInt("finish", [Value.Cont(chains[i])]));
	if (C.numCompressed < before + n) t.t.fail("expected chains to be compressed");
}

def DEEP_SUM = 5050; // sum of 0..100
def test_deep_frames(t: StackCompressionTester) {
	var k = t.callCont("make_deep", [Values.box_i(7)]);
	t.assertLast(7);
	t.assertCompress(t.stackOf(k));
	Target.forceGC();
	t.t.assert_eq(DEEP_SUM + 101 * 7, t.callInt("finish", [Value.Cont(k)]));
}

def test_deep_frames_under_limit(t: StackCompressionTester) {
	t.gen();
	t.compressing(4);
	var n = 40;
	var ks = Array<Continuation>.new(n);
	for (i < n) ks[i] = t.callCont("make_deep", [Values.box_i(i)]);
	for (i < n) t.t.assert_eq(DEEP_SUM + 101 * i, t.callInt("finish", [Value.Cont(ks[i])]));
}

def test_used_after_compress(t: StackCompressionTester) {
	var k = t.callCont("make_deep", [Values.box_i(1)]);
	t.assertCompress(t.stackOf(k));
	t.t.assert_eq(DEEP_SUM + 101, t.callInt("finish", [Value.Cont(k)]));
	t.assertTrap(TrapReason.USED_CONTINUATION, t.call("finish", [Value.Cont(k)]));
	// A continuation made unusable by {cont.bind} stays unusable after compression.
	var a = t.callCont("make_asker", [Values.box_i(2)]);
	t.t.assert_eq(25, t.callInt("answer", [Value.Cont(a), Values.box_i(5)]));
	t.assertTrap(TrapReason.USED_CONTINUATION, t.call("answer", [Value.Cont(a), Values.box_i(5)]));
}

def test_trap_after_decompress(t: StackCompressionTester) {
	var k = t.callCont("make_trapper", [Values.box_i(3)]);
	t.assertCompress(t.stackOf(k));
	t.assertTrap(TrapReason.UNREACHABLE, t.call("finish", [Value.Cont(k)]));
}

def test_throw_after_decompress(t: StackCompressionTester) {
	var k = t.callCont("make_thrower", [Values.box_i(9)]);
	t.assertCompress(t.stackOf(k));
	t.t.assert_eq(9, t.callInt("catch", [Value.Cont(k)]));
}

def test_resume_null(t: StackCompressionTester) {
	t.gen();
	t.compressing(4);
	t.assertTrap(TrapReason.NULL_DEREF, t.call("resume_null", []));
}

def test_entry_cont_arg(t: StackCompressionTester) {
	// A compressed stack whose bound argument is a continuation of another compressed stack.
	var k = t.callCont("make_deep", [Values.box_i(2)]);
	var s = M.getFreshStack().reset(t.exported("finish")).bind([Value.Cont(k)]);
	t.assertCompress(t.stackOf(k));
	t.assertCompress(s);
	for (i < 3) Target.forceGC();
	t.assertResult(Result.Value([Values.box_i(DEEP_SUM + 202)]), s.resume());
}

def test_gens_random_order(t: StackCompressionTester) {
	t.gen();
	t.compressing(6);
	var n = 30;
	var gens = Array<Continuation>.new(n), steps = Array<int>.new(n);
	for (i < n) gens[i] = t.make(i * 100);
	var live = n, seed = 12345;
	while (live > 0) {
		seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
		var i = (seed >> 8) % n;
		if (Continuations.isNull(gens[i])) continue;
		var j = ++steps[i];
		gens[i] = t.next(gens[i], if(j < 10, i * 100 + j, -1));
		if (j >= 10) live--;
	}
	t.checkInvariants("random");
}

def test_compress_from_host_call(t: StackCompressionTester) {
	// Stacks are compressed while Wasm frames are live on other stacks.
	var gens = Array<Continuation>.new(5);
	for (i < gens.length) gens[i] = t.make(i * 10);
	var hf = HostFunction.new("compress_all", SigCache.v_i, compressAll(t, gens, _));
	t.assertResult(Result.Value([Values.box_i(gens.length)]), M.runOnFreshStack(hf, []));
	for (j = 1; j < 10; j++) {
		for (i < gens.length) gens[i] = t.next(gens[i], i * 10 + j);
	}
	for (k in gens) t.next(k, -1);
}
def compressAll(t: StackCompressionTester, gens: Array<Continuation>, args: Range<Value>) -> HostResult {
	var count = 0;
	for (k in gens) if (M.compressStack(t.stackOf(k))) count++;
	return HostResult.Value1(Values.box_i(count));
}

def test_lazy_entry_near_capacity(t: StackCompressionTester) {
	var f = t.subFunc();
	t.compressing(2);
	var a = M.getFreshStack().reset(f).bind([Values.box_i(10)]);
	var b = M.getFreshStack().reset(f).bind([Values.box_i(20)]);
	var before = (C.numCompressed, C.numDecompressed);
	// No segment is free, so the new stack gets one only when resumed, without compressing another.
	var s = M.newStackFor(f);
	t.assertState(StackState.COMPRESSED, s);
	t.t.assert_eq(before.0, C.numCompressed);
	s.bind([Values.box_i(50)]);
	s.bind([Values.box_i(8)]);
	t.assertState(StackState.COMPRESSED, s);
	t.t.assert_eq(before.1, C.numDecompressed);
	t.assertResult(Result.Value([Values.box_i(42)]), s.resume());
	t.t.assert_eq(before.1 + 1, C.numDecompressed);
	t.assertResult(Result.Value([Values.box_i(9)]), a.bind([Values.box_i(1)]).resume());
	t.assertResult(Result.Value([Values.box_i(18)]), b.bind([Values.box_i(2)]).resume());
}

def test_lazy_entry_always(t: StackCompressionTester) {
	var f = t.subFunc();
	StackTuning.enableCompression = true;
	StackTuning.lazyEntryStacks = 2;
	var s = M.newStackFor(f);
	t.assertState(StackState.COMPRESSED, s);
	if (C.canCompress(s)) t.t.fail("expected a stack without a segment not to be compressible");
	t.assertResult(Result.Value([Values.box_i(7)]), s.bind([Values.box_i(10), Values.box_i(3)]).resume());
	// A stack with no bound values is entered directly.
	var hf = HostFunction.new("seven", SigCache.v_i, fun args => HostResult.Value1(Values.box_i(7)));
	t.assertResult(Result.Value([Values.box_i(7)]), M.newStackFor(hf).resume());
}

def test_lazy_entry_refs_gc(t: StackCompressionTester) {
	var b = ModuleBuilder.new();
	var sig = b.newSig([ValueTypes.ANYREF, ValueTypes.ANYREF], [ValueTypes.ANYREF, ValueTypes.ANYREF]);
	b.sig(sig).code([u8.!(Opcode.LOCAL_GET.code), 1, u8.!(Opcode.LOCAL_GET.code), 0]);
	var err = ErrorGen.new("swap");
	var f = Instantiator.new(Extension.set.all, b.module, [], err).run().functions[0];
	StackTuning.enableCompression = true;
	StackTuning.lazyEntryStacks = 2;
	var stacks = Array<NativeStack>.new(1000), objs = Array<Value>.new(1000);
	for (i < stacks.length) {
		objs[i] = obj();
		stacks[i] = M.newStackFor(f).bind([objs[i]]);
	}
	for (i < 3) Target.forceGC();
	for (i < stacks.length) {
		var other = obj();
		t.assertResult(Result.Value([other, objs[i]]), stacks[i].bind([other]).resume());
	}
}

def test_lazy_gens_round_robin(t: StackCompressionTester) {
	t.gen();
	StackTuning.lazyEntryStacks = 2;
	roundRobin(t, 20, 4);
}

def test_lazy_mid_wasm_bind(t: StackCompressionTester) {
	t.gen();
	StackTuning.enableCompression = true;
	StackTuning.lazyEntryStacks = 2;
	t.t.assert_eq(37, t.callInt("answer", [Value.Cont(t.callCont("make_asker", [Values.box_i(3)])), Values.box_i(7)]));
}

def test_lazy_chain_top(t: StackCompressionTester) {
	t.gen();
	StackTuning.enableCompression = true;
	StackTuning.lazyEntryStacks = 2;
	t.t.assert_eq(11, t.callInt("finish", [Value.Cont(t.callCont("make_chain", [Values.box_i(5)]))]));
}
