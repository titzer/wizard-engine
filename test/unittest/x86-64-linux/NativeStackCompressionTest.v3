// Tests for compressing suspended native stacks and resuming them from host and Wasm code in every tier.

def M: NativeStackManager;
def C: NativeStackCompression;

def T(name: string, f: StackCompressionTester -> void) {
	UnitTests.registerT("x86stackcomp:", name, StackCompressionTester.new(_, X86_64InterpreterOnlyStrategy.new()), runTest(f, _));
}
def TT(name: string, f: StackCompressionTester -> void) {
	for (l = Target.getTestTiers(); l != null; l = l.tail) {
		UnitTests.registerT(Strings.format1("x86stackcomp:%s", l.head.0), name, StackCompressionTester.new(_, l.head.1), runTest(f, _));
	}
}
def X_ = void(
	T("can_compress_states", test_can_compress_states),
	T("roundtrip_entry", test_roundtrip_entry),
	T("roundtrip_entry_bind", test_roundtrip_entry_bind),
	T("roundtrip_refs_gc", test_roundtrip_refs_gc),
	T("no_frames_not_compressible", test_no_frames_not_compressible),
	T("running_not_compressible", test_running_not_compressible),
	T("entry_host_func", test_entry_host_func),
	T("repeat_roundtrip", test_repeat_roundtrip),
	T("acquire_segment", test_acquire_segment),
	T("decompress_out_of_stacks", test_decompress_out_of_stacks),
	T("version_kept", test_version_kept),
	TT("mid_host_resume", test_mid_host_resume),
	TT("mid_host_bind", test_mid_host_bind),
	TT("mid_twice", test_mid_twice),
	TT("mid_gc", test_mid_gc),
	TT("gen_frames", test_gen_frames),
	TT("deep_frames", test_deep_frames),
	TT("chain_top_roundtrip", test_chain_top_roundtrip),
	TT("trap_after_decompress", test_trap_after_decompress),
	TT("throw_after_decompress", test_throw_after_decompress),
	TT("mid_explicit", test_mid_explicit),
	TT("mid_wasm_twice", test_mid_wasm_twice),
	TT("mid_wasm_bind", test_mid_wasm_bind),
	TT("mid_gc_wasm", test_mid_gc_wasm),
	TT("chain_top", test_chain_top),
	TT("deep_frames_wasm", test_deep_frames_wasm),
	TT("used_after_compress", test_used_after_compress),
	TT("trap_after_decompress_wasm", test_trap_after_decompress_wasm),
	TT("throw_after_decompress_wasm", test_throw_after_decompress_wasm),
	TT("resume_null", test_resume_null),
	TT("entry_cont_arg", test_entry_cont_arg),
	TT("compress_from_host_call", test_compress_from_host_call),
	TT("decompress_traps_in_wasm", test_decompress_traps_in_wasm),
	TT("decompress_via_gc_wasm", test_decompress_via_gc_wasm),
	()
);

// The module below, compiled with the stack-switching reference interpreter.
// (module
//   (type $fv (func))
//   (type $cv (cont $fv))
//   (type $fi (func (param i32)))
//   (type $ci (cont $fi))
//   (type $f_i (func (result i32)))
//   (type $c_i (cont $f_i))
//   (type $fi_i (func (param i32) (result i32)))
//   (type $ci_i (cont $fi_i))
//   (type $box (struct (field i32)))
//
//   (tag $yield (param i32))
//   (tag $ask (result i32))
//
//   (global $last (mut i32) (i32.const -1))
//
//   ;; Recurses {n} frames deep, each holding a v128 and a struct, then yields {v}.
//   (func $deep (param $n i32) (param $v i32)
//     (local $x v128) (local $b (ref null $box))
//     (local.set $x (i32x4.splat (local.get $v)))
//     (local.set $b (struct.new $box (local.get $v)))
//     (if (i32.eqz (local.get $n))
//       (then (suspend $yield (local.get $v)))
//       (else (call $deep (i32.sub (local.get $n) (i32.const 1)) (local.get $v))))
//     (if (i32.ne (i32x4.extract_lane 3 (local.get $x)) (local.get $v)) (then (unreachable)))
//     (if (i32.ne (struct.get $box 0 (local.get $b)) (local.get $v)) (then (unreachable)))
//   )
//   ;; Yields {start}, {start+1}, ..., {start+9} from 3 frames deep, checking i64 and f64 locals.
//   (func $gen (param $start i32)
//     (local $i i32) (local $l i64) (local $d f64) (local $v i32)
//     (loop $loop
//       (local.set $v (i32.add (local.get $start) (local.get $i)))
//       (call $deep (i32.const 3) (local.get $v))
//       (local.set $l (i64.add (local.get $l) (i64.extend_i32_s (local.get $v))))
//       (local.set $d (f64.add (local.get $d) (f64.convert_i32_s (local.get $v))))
//       (if (i64.ne (local.get $l) (i64.trunc_f64_s (local.get $d))) (then (unreachable)))
//       (local.set $i (i32.add (local.get $i) (i32.const 1)))
//       (br_if $loop (i32.lt_u (local.get $i) (i32.const 10)))
//     )
//   )
//   ;; Yields once, then returns {x + 1000}.
//   (func $once (param $x i32) (result i32)
//     (suspend $yield (local.get $x))
//     (i32.add (local.get $x) (i32.const 1000))
//   )
//   ;; Asks for a value, then returns {x * 10 + answer}.
//   (func $asker (param $x i32) (result i32)
//     (i32.add (i32.mul (local.get $x) (i32.const 10)) (suspend $ask))
//   )
//   (elem declare func $gen $once $asker)
//
//   ;; Resumes {k} until it yields (stores the value in $last and returns the new continuation) or returns (null).
//   (func $step (param $k (ref $cv)) (result (ref null $cv))
//     (local $next (ref null $cv))
//     (block $h (result i32 (ref $cv))
//       (resume $cv (on $yield $h) (local.get $k))
//       (return (ref.null $cv))
//     )
//     (local.set $next)
//     (global.set $last)
//     (local.get $next)
//   )
//   (func (export "make") (param $start i32) (result (ref null $cv))
//     (call $step (cont.bind $ci $cv (local.get $start) (cont.new $ci (ref.func $gen))))
//   )
//   (func (export "next") (param $k (ref null $cv)) (result (ref null $cv))
//     (call $step (ref.as_non_null (local.get $k)))
//   )
//   (func (export "last") (result i32) (global.get $last))
//
//   ;; Returns a continuation of {$once} suspended at its yield.
//   (func (export "make_once") (param $x i32) (result (ref null $c_i))
//     (local $k (ref null $c_i))
//     (block $h (result i32 (ref $c_i))
//       (drop (resume $ci_i (on $yield $h) (local.get $x) (cont.new $ci_i (ref.func $once))))
//       (return (ref.null $c_i))
//     )
//     (local.set $k)
//     (drop)
//     (local.get $k)
//   )
//   ;; Returns a continuation of {$asker} suspended at its question.
//   (func (export "make_asker") (param $x i32) (result (ref null $ci_i))
//     (block $h (result (ref $ci_i))
//       (drop (resume $ci_i (on $ask $h) (local.get $x) (cont.new $ci_i (ref.func $asker))))
//       (return (ref.null $ci_i))
//     )
//   )
//   ;; Answers the question of {k} with {v} via cont.bind, then resumes it.
//   (func (export "answer") (param $k (ref null $ci_i)) (param $v i32) (result i32)
//     (resume $c_i (cont.bind $ci_i $c_i (local.get $v) (local.get $k)))
//   )
// ;; --- Chains, deep frames, traps, and exceptions ---
//   (tag $other)
//   (tag $exn (param i32))
//   ;; Suspends with {yield}, which its parent {mid} does not handle, then returns {2 * x}.
//   (func $inner (param $x i32) (result i32)
//     (suspend $yield (local.get $x))
//     (i32.mul (local.get $x) (i32.const 2))
//   )
//   ;; Resumes {inner} with a handler for an unrelated tag, then returns its result + 1.
//   (func $mid (param $x i32) (result i32)
//     (block $h (result (ref $c_i))
//       (return (i32.add (i32.const 1)
//         (resume $ci_i (on $other $h) (local.get $x) (cont.new $ci_i (ref.func $inner)))))
//     )
//     (unreachable)
//   )
//   ;; Recurses {d} frames deep, each with a local, then yields {x}, then returns the sum of locals.
//   (func $deep_sum (param $d i32) (param $x i32) (result i32)
//     (local $mine i32)
//     (local.set $mine (i32.add (local.get $d) (local.get $x)))
//     (if (result i32) (i32.eqz (local.get $d))
//       (then (suspend $yield (local.get $x)) (local.get $mine))
//       (else (i32.add (local.get $mine) (call $deep_sum (i32.sub (local.get $d) (i32.const 1)) (local.get $x)))))
//   )
//   (func $deep_entry (param $x i32) (result i32)
//     (call $deep_sum (i32.const 100) (local.get $x))
//   )
//   ;; Yields, then traps.
//   (func $trapper (param $x i32) (result i32)
//     (suspend $yield (local.get $x))
//     (unreachable)
//   )
//   ;; Yields, then throws {x}.
//   (func $thrower (param $x i32) (result i32)
//     (suspend $yield (local.get $x))
//     (throw $exn (local.get $x))
//   )
//   (elem declare func $inner $mid $deep_entry $trapper $thrower)
//
//   ;; Runs {f(x)} until it yields, returning the suspended continuation.
//   (func $start (param $f (ref $ci_i)) (param $x i32) (result (ref null $c_i))
//     (local $k (ref null $c_i))
//     (block $h (result i32 (ref $c_i))
//       (drop (resume $ci_i (on $yield $h) (local.get $x) (local.get $f)))
//       (return (ref.null $c_i))
//     )
//     (local.set $k)
//     (global.set $last)
//     (local.get $k)
//   )
//   ;; Returns a continuation whose top stack is {inner} and whose bottom stack is {mid}.
//   (func (export "make_chain") (param $x i32) (result (ref null $c_i))
//     (call $start (cont.new $ci_i (ref.func $mid)) (local.get $x))
//   )
//   (func (export "make_deep") (param $x i32) (result (ref null $c_i))
//     (call $start (cont.new $ci_i (ref.func $deep_entry)) (local.get $x))
//   )
//   (func (export "make_trapper") (param $x i32) (result (ref null $c_i))
//     (call $start (cont.new $ci_i (ref.func $trapper)) (local.get $x))
//   )
//   (func (export "make_thrower") (param $x i32) (result (ref null $c_i))
//     (call $start (cont.new $ci_i (ref.func $thrower)) (local.get $x))
//   )
//   ;; Resumes {k} to completion.
//   (func (export "finish") (param $k (ref null $c_i)) (result i32)
//     (resume $c_i (local.get $k))
//   )
//   ;; Resumes {k} to completion, returning the payload of an exception it throws.
//   (func (export "catch") (param $k (ref null $c_i)) (result i32)
//     (block $c (result i32)
//       (try_table (catch $exn $c) (drop (resume $c_i (local.get $k))))
//       (i32.const -1)
//     )
//   )
//   (func (export "resume_null") (result i32)
//     (resume $c_i (ref.null $c_i))
//   )
// )
