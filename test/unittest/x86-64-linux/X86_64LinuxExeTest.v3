component X86_64LinuxExeTest {
	new() {
		for (strategy in [
			("spc:aot:", X86_64SpcAotStrategy.new(false)),
			("spc:lazy:", X86_64SpcLazyStrategy.new()),
			("int:dyn:", X86_64DynamicStrategy.new())]) {

			var newTester = ExeTester.new(_, strategy.1);
			for (test in [
				("empty", test_empty),
				("unreachable", test_unreachable),
				("i32.add", test_i32_add),
				("load_oob0", test_load_oob0),
				("call1005", test_call1005),		// intended to trigger OSR
				("osr_accessor", test_osr_accessor),
				("recompile_after_probe", test_recompile_after_probe)
				]) {
				// register strategy/test pair
				UnitTests.registerT(strategy.0, test.0, newTester, test.1);
			}
		}
		// a path profile counts exactly, in the interpreter
		var newInt = ExeTester.new(_, X86_64InterpreterOnlyStrategy.new());
		for (test in [
			("ifs", test_profile_ifs),
			("br_table", test_profile_br_table)
			]) {
			UnitTests.registerT("pathprofile:", test.0, newInt, test.1);
		}
	}

}

// Tests specific compilation strategies such as AOT, lazy, dynamic tier up.
def X: Array<Value>;
def NONE = BpTypeCode.EmptyBlock.code;

def test_empty(i: ExeTester) {
	i.sig(SigCache.v_v).code([])
		.noargs().assert2_none();
}

def test_unreachable(i: ExeTester) {
	i.code([u8.!(Opcode.UNREACHABLE.code)])
		.noargs().assert2_trap(TrapReason.UNREACHABLE);
}

def test_nop(i: ExeTester) {
	i.sig(SigCache.v_v).code([u8.!(Opcode.NOP.code)])
		.noargs().assert2_none();
}

def test_i32_add(i: ExeTester) {
	i.sig(SigCache.ii_i).code([
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.LOCAL_GET.code), 1,
		u8.!(Opcode.I32_ADD.code)]);
	i.args_ii(0xFF89520F, 9999999).assert2_i(2222222);
}

def test_load_oob0(i: ExeTester) {
	i.addMemory(0, Max.Set(0));
	i.sig(SigCache.i_i);
	i.code([u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_LOAD.code), 0, 0]);
	i.args_i(0).assert2_trap(TrapReason.MEMORY_OOB);
}

// (sum, max, how many are nonzero) of a profile's path counts
def tally(counts: Array<int>) -> (int, int, int) {
	var sum = 0, max = 0, nonzero = 0;
	for (c in counts) {
		sum += c;
		if (c > max) max = c;
		if (c > 0) nonzero++;
	}
	return (sum, max, nonzero);
}

// Three decisions in a row make eight paths, which eight inputs take once each.
def test_profile_ifs(i: ExeTester) {
	var code = Vector<byte>.new();
	for (bit in [1, 2, 4]) code.puta([
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), byte.!(bit),
		u8.!(Opcode.I32_AND.code),
		u8.!(Opcode.IF.code), NONE,
		u8.!(Opcode.NOP.code),
		u8.!(Opcode.END.code)]);
	code.puta([u8.!(Opcode.I32_CONST.code), 7]);
	i.sig(SigCache.i_i).codev(code.extract());
	var profile = PathTrace.new(i.module, i.func);
	i.t.asserti(8, profile.counts.length);
	for (x < 8) i.args_i(x).assert2_i(7);
	i.t.assert_eq((8, 1, 8), tally(profile.counts));
	for (n < 3) i.args_i(5).assert2_i(7);
	i.t.assert_eq((11, 4, 8), tally(profile.counts));
}

// One label and the default make two paths.
def test_profile_br_table(i: ExeTester) {
	i.sig(SigCache.i_i).codev([
		u8.!(Opcode.BLOCK.code), NONE,
		u8.!(Opcode.BLOCK.code), NONE,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.BR_TABLE.code), 1, 0, 1,
		u8.!(Opcode.END.code),
		u8.!(Opcode.I32_CONST.code), 11,
		u8.!(Opcode.RETURN.code),
		u8.!(Opcode.END.code),
		u8.!(Opcode.I32_CONST.code), 22]);
	var profile = PathTrace.new(i.module, i.func);
	i.t.asserti(2, profile.counts.length);
	for (x in [0, 5, 5, 9]) i.args_i(x).assert2_i(if(x == 0, 11, 22));
	i.t.assert_eq((4, 3, 2), tally(profile.counts));
}

def test_call1005(i: ExeTester) {
	var f17 = byte.!(i.newFunction(SigCache.v_i, [u8.!(Opcode.I32_CONST.code), 17]).func_index);
	i.sig(SigCache.i_i);
	i.codev([
		u8.!(Opcode.LOOP.code), BpTypeCode.EmptyBlock.code,
		u8.!(Opcode.CALL.code), f17,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_SUB.code),
		u8.!(Opcode.LOCAL_TEE.code), 0,
		u8.!(Opcode.I32_EQZ.code),
		u8.!(Opcode.BR_IF.code), 1,
		u8.!(Opcode.BR.code), 0,
		u8.!(Opcode.END.code),
		u8.!(Opcode.UNREACHABLE.code)
	]);
	i.args_i(5).assert2_i(17);
	i.args_i(1000).assert2_i(17);
}

// A probe write to a local that SPC holds as a constant must survive OSR tier-up.
def test_osr_accessor(i: ExeTester) {
	i.sig(SigCache.i_i);
	i.addLocal(ValueType.I32);
	i.codev([
		u8.!(Opcode.LOOP.code), BpTypeCode.EmptyBlock.code,
		u8.!(Opcode.I32_CONST.code), 7,
		u8.!(Opcode.LOCAL_SET.code), 1,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_SUB.code),
		u8.!(Opcode.LOCAL_TEE.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code),
		u8.!(Opcode.LOCAL_GET.code), 1
	]);
	// Overwrite the constant 7 in local 1 after it is set.
	Instrumentation.insertLocalProbe(i.module, i.func.func_index, 9, LocalSetter.new(1, Values.box_i(1000)));
	i.args_i(30).assert2_i(1000);
}

// A probe inserted into a callee while its compiled caller runs makes the callee recompile, which
// appends code to the module. The code must land after the module's code, not over the caller.
def test_recompile_after_probe(i: ExeTester) {
	i.sig(SigCache.i_i);
	def g = i.newFunction(SigCache.i_i, [
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_ADD.code)]);
	// main(x) = x if x >= 60, else main(g(x) + 60); the recursive call re-enters the caller's code
	i.codev([
		u8.!(Opcode.BLOCK.code), NONE,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 60,
		u8.!(Opcode.I32_GE_S.code),
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.CALL.code), byte.!(g.func_index),
		u8.!(Opcode.I32_CONST.code), 60,
		u8.!(Opcode.I32_ADD.code),
		u8.!(Opcode.CALL.code), byte.!(i.func.func_index),
		u8.!(Opcode.RETURN.code),
		u8.!(Opcode.END.code),
		u8.!(Opcode.LOCAL_GET.code), 0]);
	// inserted while the caller runs, so the strategy under test handles the insertion
	def inserter = ClosureProbe.new(Instrumentation.insertLocalProbe, (i.module, g.func_index, 1, CountProbe.new()));
	Instrumentation.insertLocalProbe(i.module, i.func.func_index, 10, inserter);
	i.args_i(5).assert2_i(66);
}
