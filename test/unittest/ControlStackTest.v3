def test_if_unreach1(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.LOCAL_GET.code), 0], 			1, 0),
		([u8.!(Opcode.IF.code), BpTypeCode.EmptyBlock.code],	1, 0),
		([u8.!(Opcode.NOP.code)], 				1, 0),
		([u8.!(Opcode.ELSE.code)],				1, 0),
		([u8.!(Opcode.UNREACHABLE.code)], 			1, 1),
		([u8.!(Opcode.NOP.code)],				0, 1),
		([u8.!(Opcode.END.code)],				0, 1)
	],
	(1, 0),
	1);
}

class MarkedBlock extends CfgBlock {
	new(pos: int) super(pos) { }
}
class MarkedEdge extends CfgEdge {
	new(pc: int, source: CfgBlock, target: CfgBlock) super(pc, source, target) { }
}
def test_subclass_hooks(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.BLOCK.code), EMPTY,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code)
	]);
	var b = CfgBuilder.new();
	b.newBlock = MarkedBlock.new;
	b.newEdge = MarkedEdge.new;
	var cfg = b.build(t.func), entry = cfg.0, exit = cfg.1;
	entry.dfs(fun (blk: CfgBlock) { t.t.assert(MarkedBlock.?(blk), "expected the block override to be used"); }, null, null);
	t.t.assert(MarkedEdge.?(entry.outgoing.head), "expected the edge override to be used");
	t.t.assert(MarkedEdge.?(b.link(-1, exit, entry)), "expected `link` to use the edge override");
	t.t.asserti(entry.hash(), entry.id);
	t.t.assertz(true, entry.equals(entry));
	t.t.assertz(false, entry.equals(exit));
}

// every non-backedge points from later to earlier in the order, regardless of walk order
def test_reverse_topo(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.LOOP.code), EMPTY,
		u8.!(Opcode.I32_CONST.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code)
	]);
	var entry = CfgBuilder.new().build(t.func).0;
	var order = entry.reverseTopo(false);
	for (b in order) t.t.asserti(0, b.mark); // a walk leaves every mark cleared
	t.t.assert_eq(entry, order[order.length - 1]);
	for (i < order.length) {
		for (l = order[i].outgoing; l != null; l = l.tail) {
			if (l.head.isBackedge) continue;
			var target = l.head.target, seen = false;
			for (j < i) if (order[j] == target) seen = true;
			t.t.assert(seen, "expected each successor before its block in the order");
		}
	}
}

// both arms of an empty `if` reach the merge block, so they become one edge that either arm selects
def test_merge_parallel(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.IF.code), EMPTY,
		u8.!(Opcode.END.code)
	]);
	var b = CfgBuilder.new();
	var cfg = b.build(t.func), entry = cfg.0, exit = cfg.1;
	b.removeEmptyBlocks(entry, exit);
	t.t.asserti(2, Lists.length(entry.outgoing));
	b.mergeParallelEdges(entry);
	b.mergeParallelEdges(entry); // a second run finds nothing to merge and changes nothing
	t.t.asserti(1, Lists.length(entry.outgoing));
	var e = entry.outgoing.head;
	t.t.asserti(2, Lists.length(e.arms));
	var arm0 = false, arm1 = false;
	for (a = e.arms; a != null; a = a.tail) {
		if (a.head == 0) arm0 = true;
		if (a.head == 1) arm1 = true;
	}
	t.t.assert(arm0 && arm1, "expected the merged edge to carry both arms");
	t.t.asserti(1, Lists.length(e.target.incoming));
	t.t.assert_eq(e, e.target.incoming.head);
}

def newControlPathCounter() -> ControlStack<int> {
	var cs = ControlStack<int>.new();
	cs.newLabel = cs.newBlock = newCount;
	cs.splitBlock = splitCount;
	cs.mergeBlock = mergeCount;
	cs.reset();
	cs.block = 1;
	return cs;
}
def newCount(cs: ControlStack<int>) -> int {
	return 0;
}
def splitCount(cs: ControlStack<int>, a: int) -> (int, int) {
	return if(cs.isUnreachable(), (0, 0), (a, a));
}
def mergeCount(cs: ControlStack<int>, a: int, b: int) -> int {
	return if(cs.isUnreachable(), b, a + b);
}
