def test_loop2(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.LOOP.code), EMPTY],	1, 0),
		([u8.!(Opcode.I32_CONST.code), 0],	1, 1),
		([u8.!(Opcode.BR_IF.code), 0],	1, 1),
		([u8.!(Opcode.NOP.code)],		1, 2),
		([u8.!(Opcode.UNREACHABLE.code)],	1, 2),
		([u8.!(Opcode.END.code)],		0, 2)
