	T("br0", test_br0),
	T("br1", test_br1),
	T("br2", test_br2),
	T("br_if0", test_br_if0),
	T("br_table_succs", test_br_table_succs),
	T("loop_backedge", test_loop_backedge),
	T("return_edge", test_return_edge),
	T("remove_empty", test_remove_empty),
	T("subclass_hooks", test_subclass_hooks),
	T("reverse_topo", test_reverse_topo),
	T("merge_parallel", test_merge_parallel),
	T("unreach", test_unreach),
	T("return", test_return),
	T("return_call_ref", test_return_call_ref),
	T("loop0", test_loop0),
	T("loop1", test_loop1),
	T("loop2", test_loop2),
	T("if0", test_if0),
	T("if1", test_if1),
	T("if2", test_if2),
	T("if_unreach0", test_if_unreach0),
	T("if_unreach1", test_if_unreach1),
	()
);
def C = UnitTests.registerT("cfg:", _, ControlStackTester.new, _);
def Y_ = void(
	C("range_entry", test_range_entry),
	C("range_if", test_range_if),
	C("range_if_else", test_range_if_else),
	C("range_empty_body", test_range_empty_body),
	C("range_loop_in_if", test_range_loop_in_if),
	C("range_if_in_loop", test_range_if_in_loop),
	C("range_br_outer", test_range_br_outer),
	C("range_br_table_loop", test_range_br_table_loop),
	C("range_br_if_chain", test_range_br_if_chain),
	C("range_if_then_dead", test_range_if_then_dead),
	C("range_return_in_if", test_range_return_in_if),
	()
);

def verbose = false;

class ControlStackTester(t: Tester) extends ModuleBuilder {
	def test_count(counts: Array<(int, int, int)>) {
		var cs = newControlPathCounter();
		var bi = BytecodeIterator.new().reset(func);
		bi.current();
		var i = 0;
		var tracer = InstrTracer.new();
		while (bi.more()) {
			if (verbose) {
				Trace.OUT.mark().put1("+%d ", bi.pc).ljustify_mark(7);
				Trace.OUT.mark();
				bi.traceOrig(Trace.OUT, module, tracer);
				Trace.OUT.ljustify_mark(Opcodes.longestName);
				Trace.OUT.put2(" cur=%d, label=%d", counts[i].1, counts[i].2);
				Trace.OUT.ln();
			}

			cs.pc = bi.pc;
			if (i >= counts.length) return t.fail2("expected at least %d entries, got %d", i + 1, counts.length);
			check_count(counts[i], cs);
			if (!t.ok) return;
			bi.dispatch(cs);
			bi.next();
			cs.pc = bi.pc;
			i++;
		}
		check_count(counts[i], cs);
	}
	def check_count(expected: (int, int, int), cs: ControlStack<int>) {
		if (expected.0 != cs.pc) t.fail2("expected pc=%d, got=%d", expected.0, cs.pc);
		if (expected.1 != cs.block) t.fail2("expected cur=%d, got=%d", expected.1, cs.block);
		var e = cs.getTopEntry();
		if (e != null && expected.2 != e.label) t.fail2("expected label=%d, got=%d", expected.2, e.label);
	}
	def test_count2(instrs: Array<(Array<byte>, int, int)>, end: (int, int), last: int) {
		var buf = Vector<byte>.new();
		var expected = Array<(int, int, int)>.new(instrs.length + 2);
		var pc = 1;
		for (i < instrs.length) {
			var e = instrs[i];
			buf.putr(e.0);
			expected[i] = (pc, e.1, e.2);
			pc += e.0.length;
		}
		expected[instrs.length] = (pc, end.0, end.1);
		expected[instrs.length + 1] = (pc + 1, last, 0);
		code(buf.extract());
		test_count(expected);
	}
	// Checks the blocks reachable from the entry: those that own instructions against {expected},
	// given as (first pc, last instruction pc, end) in pc order, and that the rest are empty.
	def test_ranges(raw: Array<byte>, expected: Array<(int, int, int)>) {
		code(raw);
		def entry = CfgBuilder.new().build(func).0;
		entry.mark = 1;
		def blocks = Vector<CfgBlock>.new().put(entry);
		def owners = Vector<(int, int, int)>.new();
		for (i = 0; i < blocks.length; i++) {
			def b = blocks[i];
			if (b.last_instr_pc >= 0) owners.put((b.bind_pos, b.last_instr_pc, b.end));
			else if (b.end != b.bind_pos) return t.fail1("block at +%d owns nothing but isn't empty", b.bind_pos);
			for (l = b.outgoing; l != null; l = l.tail) {
				def s = l.head.target;
				if (s.mark == 0) {
					s.mark = 1;
					blocks.put(s);
				}
			}
		}
		def unsorted = owners.extract();
		def got = Arrays.sort(unsorted, 0, unsorted.length, byLastInstr);
		if (Arrays.equal(expected, got)) return;
		def buf = StringBuilder.new().puts("expected");
		putRanges(buf, expected);
		putRanges(buf.puts(", got"), got);
		t.fail(buf.toString());
	}
}
def byLastInstr(a: (int, int, int), b: (int, int, int)) -> bool {
	return a.1 < b.1;
}
def putRanges(buf: StringBuilder, ranges: Array<(int, int, int)>) {
	for (e in ranges) buf.put3(" (%d, %d, %d)", e.0, e.1, e.2);
}

def test_count0(t: ControlStackTester) {
	t.test_count2([], (1, 0), 1);
}

def test_br0(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.BR.code), 0], 1, 0)
	],
	(0, 1),
	1);
}

def test_br1(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.BLOCK.code), EMPTY],	1, 0),
		([u8.!(Opcode.BR.code), 1],		1, 0),
		([u8.!(Opcode.END.code)],		0, 0)
	],
	(0, 1),
	1);
}

def test_br2(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.BLOCK.code), EMPTY],	1, 0),
		([u8.!(Opcode.BR.code), 0],		1, 0),
		([u8.!(Opcode.END.code)],		0, 1)
	],
	(1, 0),
	1);
}

def test_br_if0(t: ControlStackTester) {
	t.test_count2([
		([u8.!(Opcode.I32_CONST.code), 0],	1, 0),
		([u8.!(Opcode.BR_IF.code), 0],	1, 0),
		([u8.!(Opcode.I32_CONST.code), 0],	1, 1),
		([u8.!(Opcode.BR_IF.code), 0],	1, 1)
	],
	(1, 2),
	3);
}

def test_range_entry(t: ControlStackTester) {
	t.addLocal(ValueType.I32);
	t.test_ranges([
		u8.!(Opcode.NOP.code),				// +3
		u8.!(Opcode.NOP.code)				// +4
	], [(3, 4, 5), (5, 5, 6)]);
}

def test_range_if(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.I32_CONST.code), 0,			// +1
		u8.!(Opcode.IF.code), EMPTY,			// +3
		u8.!(Opcode.NOP.code),				// +5
		u8.!(Opcode.END.code)				// +6
	], [(1, 3, 5), (5, 5, 6), (6, 6, 7), (7, 7, 8)]);
}

def test_range_if_else(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.I32_CONST.code), 0,			// +1
		u8.!(Opcode.IF.code), EMPTY,			// +3
		u8.!(Opcode.NOP.code),				// +5
		u8.!(Opcode.ELSE.code),				// +6
		u8.!(Opcode.NOP.code),				// +7
		u8.!(Opcode.END.code)				// +8
	], [(1, 3, 5), (5, 6, 7), (7, 7, 8), (8, 8, 9), (9, 9, 10)]);
}

def test_range_empty_body(t: ControlStackTester) {
	t.test_ranges([], [(1, 1, 2)]);
}

def test_range_loop_in_if(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.I32_CONST.code), 0,			// +1
		u8.!(Opcode.IF.code), EMPTY,			// +3
		u8.!(Opcode.LOOP.code), EMPTY,			// +5
		u8.!(Opcode.I32_CONST.code), 0,			// +7
		u8.!(Opcode.BR_IF.code), 0,			// +9
		u8.!(Opcode.END.code),				// +11
		u8.!(Opcode.END.code)				// +12
	], [(1, 3, 5), (5, 9, 11), (11, 11, 12), (12, 12, 13), (13, 13, 14)]);
}

def test_range_if_in_loop(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.LOOP.code), EMPTY,			// +1
		u8.!(Opcode.I32_CONST.code), 0,			// +3
		u8.!(Opcode.IF.code), EMPTY,			// +5
		u8.!(Opcode.BR.code), 1,			// +7
		u8.!(Opcode.END.code),				// +9
		u8.!(Opcode.NOP.code),				// +10
		u8.!(Opcode.END.code)				// +11
	], [(1, 5, 7), (7, 7, 9), (9, 11, 12), (12, 12, 13)]);
}

// The `nop` after `br 0` is dead, so no block owns it.
def test_range_br_outer(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.BLOCK.code), EMPTY,			// +1
		u8.!(Opcode.BLOCK.code), EMPTY,			// +3
		u8.!(Opcode.I32_CONST.code), 0,			// +5
		u8.!(Opcode.BR_IF.code), 1,			// +7
		u8.!(Opcode.BR.code), 0,			// +9
		u8.!(Opcode.NOP.code),				// +11
		u8.!(Opcode.END.code),				// +12
		u8.!(Opcode.NOP.code),				// +13
		u8.!(Opcode.END.code)				// +14
	], [(1, 7, 9), (9, 9, 11), (12, 13, 14), (14, 14, 15), (15, 15, 16)]);
}

// The loop body ends in `br_table`, so no block owns the loop's `end`.
def test_range_br_table_loop(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.BLOCK.code), EMPTY,			// +1
		u8.!(Opcode.LOOP.code), EMPTY,			// +3
		u8.!(Opcode.I32_CONST.code), 0,			// +5
		u8.!(Opcode.BR_TABLE.code), 2, 0, 1, 1,		// +7
		u8.!(Opcode.END.code),				// +12
		u8.!(Opcode.END.code)				// +13
	], [(1, 1, 3), (3, 7, 12), (13, 13, 14), (14, 14, 15)]);
}

def test_range_br_if_chain(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.BLOCK.code), EMPTY,			// +1
		u8.!(Opcode.I32_CONST.code), 0,			// +3
		u8.!(Opcode.BR_IF.code), 0,			// +5
		u8.!(Opcode.I32_CONST.code), 0,			// +7
		u8.!(Opcode.BR_IF.code), 0,			// +9
		u8.!(Opcode.NOP.code),				// +11
		u8.!(Opcode.END.code)				// +12
	], [(1, 5, 7), (7, 9, 11), (11, 11, 12), (12, 12, 13), (13, 13, 14)]);
}

// The then-arm branches out, so no block owns the `else`.
def test_range_if_then_dead(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.BLOCK.code), EMPTY,			// +1
		u8.!(Opcode.I32_CONST.code), 0,			// +3
		u8.!(Opcode.IF.code), EMPTY,			// +5
		u8.!(Opcode.BR.code), 1,			// +7
		u8.!(Opcode.ELSE.code),				// +9
		u8.!(Opcode.NOP.code),				// +10
		u8.!(Opcode.END.code),				// +11
		u8.!(Opcode.END.code)				// +12
	], [(1, 5, 7), (7, 7, 9), (10, 10, 11), (11, 11, 12), (12, 12, 13), (13, 13, 14)]);
}


def test_range_return_in_if(t: ControlStackTester) {
	t.test_ranges([
		u8.!(Opcode.I32_CONST.code), 0,			// +1
		u8.!(Opcode.IF.code), EMPTY,			// +3
		u8.!(Opcode.RETURN.code),			// +5
		u8.!(Opcode.END.code),				// +6
		u8.!(Opcode.NOP.code)				// +7
	], [(1, 3, 5), (5, 5, 6), (6, 7, 8), (8, 8, 9)]);
}

def test_br_table_succs(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.BLOCK.code), EMPTY,
		u8.!(Opcode.BR_TABLE.code), 2, 0, 0, 0,
		u8.!(Opcode.END.code)
	]);
	var start = CfgBuilder.new().build(t.func).0;
	t.t.asserti(3, Lists.length(start.outgoing));
}

// the br_if targets the loop label, which is bound at the loop, so only that edge reaches backwards
def test_loop_backedge(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.LOOP.code), EMPTY,
		u8.!(Opcode.I32_CONST.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code)
	]);
	var entry = CfgBuilder.new().build(t.func).0;
	var header = entry.outgoing.head;
	t.t.assertz(false, header.isBackedge);
	var back = 0;
	for (l = header.target.outgoing; l != null; l = l.tail) if (l.head.isBackedge) back++;
	t.t.asserti(1, back);
}

// a return leaves the function, so its block reaches EXIT only once the edge is added
def test_return_edge(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.RETURN.code)
	]);
	var cfg = CfgBuilder.new();
	var t2 = cfg.build(t.func), entry = t2.0, exit = t2.1;
	t.t.assertz(true, entry.outgoing == null);
	cfg.addReturnEdges(t.func, entry, exit);
	t.t.assert_eq(exit, entry.outgoing.head.target);
}

// the block between the br_if and the end owns no instruction, so it is removed
def test_remove_empty(t: ControlStackTester) {
	t.code([
		u8.!(Opcode.BLOCK.code), EMPTY,
		u8.!(Opcode.I32_CONST.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code)
	]);
	var cfg = CfgBuilder.new();
	var t2 = cfg.build(t.func), entry = t2.0, exit = t2.1;
	var blocks = Vector<CfgBlock>.new();
	entry.dfs(blocks.put, null, null);
	t.t.asserti(4, blocks.length);
	cfg.removeEmptyBlocks(entry, exit);
	blocks.resize(0);
	entry.dfs(blocks.put, null, null);
	t.t.asserti(3, blocks.length);
}

