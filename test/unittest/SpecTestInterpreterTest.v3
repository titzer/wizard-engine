def T = UnitTests.registerT("spectest:", _, SpecTestInterpreterTester.new, _);
def X_ = void(
	T("invoke_args", test_invoke_args),
	T("invoke_too_few", test_invoke_too_few),
	T("invoke_too_many", test_invoke_too_many),
	T("invoke_action", test_invoke_action),
	T("invoke_assert_trap", test_invoke_assert_trap),
	()
);

// A module exporting "id", of type [i32] -> [i32], which returns its argument.
def MODULE = "(module binary \"\\00asm\\01\\00\\00\\00\" \"\\01\\06\\01\\60\\01\\7f\\01\\7f\" \"\\03\\02\\01\\00\" \"\\07\\06\\01\\02id\\00\\00\" \"\\0a\\06\\01\\04\\00\\20\\00\\0b\")\n";

class SpecTestInterpreterTester(t: Tester) {
	new() {
		Execute.tiering = ExecuteOptions.default;
	}
	// Runs the spec test {script} after {MODULE}, returning the interpreter.
	def run(script: string) -> SpecTestInterpreter {
		var input = Arrays.concat(MODULE, script);
		var p = SpecTestParser.new("SpecTestInterpreterTest.v3", input, makeHostObject);
		p.parseFile();
		if (!p.ok) {
			t.fail1("parse error: %s", p.error_msg);
			return null;
		}
		var engine = Engine.new();
		engine.extensions = Extension.set.all;
		var ip = SpecTestInterpreter.new(engine, "SpecTestInterpreterTest.v3");
		ip.quiet = true;
		ip.run(p.commands);
		return ip;
	}
	def assert_ok(script: string) {
		var ip = run(script);
		if (ip != null && !ip.ok) t.fail1("expected success, got failure: %s", ip.error_msg);
	}
	// Checks that {script} fails with the error message {expected}.
	def assert_error(script: string, expected: string) {
		var ip = run(script);
		if (ip == null) return;
		if (ip.ok) return t.fail1("expected failure \"%s\", got success", expected);
		if (!Strings.equal(ip.error_msg, expected)) t.fail2("expected failure \"%s\", got \"%s\"", expected, ip.error_msg);
	}
}
def makeHostObject(i: int) -> HostObject {
	return HostObject.new();
}

def test_invoke_args(t: SpecTestInterpreterTester) {
	t.assert_ok("(assert_return (invoke \"id\" (i32.const 5)) (i32.const 5))");
	t.assert_ok("(assert_return (invoke \"id\" (i32.const -1)) (i32.const -1))");
}
def test_invoke_too_few(t: SpecTestInterpreterTester) {
	t.assert_error("(assert_return (invoke \"id\") (i32.const 5))", "expected 1 argument(s) to \"id\", got 0");
}
def test_invoke_too_many(t: SpecTestInterpreterTester) {
	t.assert_error("(assert_return (invoke \"id\" (i32.const 1) (i32.const 2)) (i32.const 1))", "expected 1 argument(s) to \"id\", got 2");
}
def test_invoke_action(t: SpecTestInterpreterTester) {
	t.assert_ok("(invoke \"id\" (i32.const 7))");
	t.assert_error("(invoke \"id\")", "expected 1 argument(s) to \"id\", got 0");
}
def test_invoke_assert_trap(t: SpecTestInterpreterTester) {
	// An invocation with the wrong arguments does not count as a trap.
	t.assert_error("(assert_trap (invoke \"id\") \"unreachable\")", "expected 1 argument(s) to \"id\", got 0");
}
