// Register renderers and comparators to make Wizard unit tests more terse.
def X = [
	UnitTests.registerRenderer<Value>(Values.render),
	UnitTests.registerRenderer<Result>(Result.render),
	UnitTests.registerComparator<Result>(Result.equals),
	// TODO: register Exportable.render (and all subtypes)
	()
];

def RECORD_BINARY = "--record-binary";
def DEFAULT_RECORD_DIR = "test/regress/binary";

// Main entrypoint for running unit tests.
def main(args: Array<string>) -> int {
	var err = ErrorGen.new("unittest");
	for (i < args.length) {
		var arg = args[i];
		// Externalize the modules decoded by the binary tests; see BinRecorder.v3.
		if (arg != null && Strings.startsWith(arg, RECORD_BINARY)) {
			if (arg.length == RECORD_BINARY.length) BinRecorder.dir = DEFAULT_RECORD_DIR;
			else if (arg[RECORD_BINARY.length] == '=') BinRecorder.dir = Arrays.range(arg, RECORD_BINARY.length + 1, arg.length);
			else continue;	// not this option after all; let TraceOptions have it
			args[i] = null;
			continue;
		}
		err.abs(u64.!(i));
		if (TraceOptions.parse(args[i], err)) args[i] = null;
	}
	var result = UnitTests.run(args);
	BinRecorder.flush();	// write out the last test recorded
	return result;
}
