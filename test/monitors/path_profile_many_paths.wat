;; 32 paths from five if/else in a row, each taken once, so the numbering must be compact and unique.
(module
  (func $five32 (export "five32") (param $m i32) (result i32)
    (local $r i32)
    (if (i32.and (local.get $m) (i32.const 1))
      (then (local.set $r (i32.add (local.get $r) (i32.const 1))))
      (else (local.set $r (i32.sub (local.get $r) (i32.const 1)))))
    (if (i32.and (local.get $m) (i32.const 2))
      (then (local.set $r (i32.add (local.get $r) (i32.const 2))))
      (else (local.set $r (i32.sub (local.get $r) (i32.const 2)))))
    (if (i32.and (local.get $m) (i32.const 4))
      (then (local.set $r (i32.add (local.get $r) (i32.const 4))))
      (else (local.set $r (i32.sub (local.get $r) (i32.const 4)))))
    (if (i32.and (local.get $m) (i32.const 8))
      (then (local.set $r (i32.add (local.get $r) (i32.const 8))))
      (else (local.set $r (i32.sub (local.get $r) (i32.const 8)))))
    (if (i32.and (local.get $m) (i32.const 16))
      (then (local.set $r (i32.add (local.get $r) (i32.const 16))))
      (else (local.set $r (i32.sub (local.get $r) (i32.const 16)))))
    (local.get $r))
  (func (export "main")
    (drop (call $five32 (i32.const 0)))
    (drop (call $five32 (i32.const 1)))
    (drop (call $five32 (i32.const 2)))
    (drop (call $five32 (i32.const 3)))
    (drop (call $five32 (i32.const 4)))
    (drop (call $five32 (i32.const 5)))
    (drop (call $five32 (i32.const 6)))
    (drop (call $five32 (i32.const 7)))
    (drop (call $five32 (i32.const 8)))
    (drop (call $five32 (i32.const 9)))
    (drop (call $five32 (i32.const 10)))
    (drop (call $five32 (i32.const 11)))
    (drop (call $five32 (i32.const 12)))
    (drop (call $five32 (i32.const 13)))
    (drop (call $five32 (i32.const 14)))
    (drop (call $five32 (i32.const 15)))
    (drop (call $five32 (i32.const 16)))
    (drop (call $five32 (i32.const 17)))
    (drop (call $five32 (i32.const 18)))
    (drop (call $five32 (i32.const 19)))
    (drop (call $five32 (i32.const 20)))
    (drop (call $five32 (i32.const 21)))
    (drop (call $five32 (i32.const 22)))
    (drop (call $five32 (i32.const 23)))
    (drop (call $five32 (i32.const 24)))
    (drop (call $five32 (i32.const 25)))
    (drop (call $five32 (i32.const 26)))
    (drop (call $five32 (i32.const 27)))
    (drop (call $five32 (i32.const 28)))
    (drop (call $five32 (i32.const 29)))
    (drop (call $five32 (i32.const 30)))
    (drop (call $five32 (i32.const 31)))
  )
)
